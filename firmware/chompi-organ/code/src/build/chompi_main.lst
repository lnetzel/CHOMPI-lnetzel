   1:temp_led_stuff.h **** /** This is a temporary kludge of stuff necessary to run the
   2:temp_led_stuff.h ****  *  LEDs without the ideal API in libDaisy yet.
   3:temp_led_stuff.h ****  *
   4:temp_led_stuff.h ****  *  CHOMPI's two LED chains (PTH is the through-hole panel LEDs, SMT is
   5:temp_led_stuff.h ****  *  the 25 keybed LEDs, both WS2812-style addressable RGB) are driven by timer
   6:temp_led_stuff.h ****  *  PWM+DMA. Each color bit becomes one PWM pulse whose ON-duration
   7:temp_led_stuff.h ****  *  encodes a 1 or 0 (kOneTime/kZeroTime), in timer ticks. Each chain
   8:temp_led_stuff.h ****  *  needs a few LED-times of "porch" (kPorchSize) at each end sending zero pulses.
   9:temp_led_stuff.h ****  *  The setup creates the correct timing and format for the data signal using the libDaisy timers.
  10:temp_led_stuff.h ****  *  The buffers are set per LED throughout the UI pages Draw() function then formatted
  11:temp_led_stuff.h ****  *  and put in the DMA buffers in fill_led_data() which is called at the end of Draw()
  12:temp_led_stuff.h ****  */
  13:temp_led_stuff.h **** #pragma once
  14:temp_led_stuff.h **** #include "daisy_seed.h"
  15:temp_led_stuff.h **** 
  16:temp_led_stuff.h **** namespace chompi
  17:temp_led_stuff.h **** {
  18:temp_led_stuff.h ****     /** Global timer refs. */
  19:temp_led_stuff.h ****     daisy::TimerHandle tim3_smt, tim5_pth;
  20:temp_led_stuff.h ****     daisy::TimChannel ledPthPwm, ledSmtPwm;
  21:temp_led_stuff.h ****     daisy::TimerHandle::Config tim3_cfg;
  22:temp_led_stuff.h ****     daisy::TimerHandle::Config tim5_cfg;
  23:temp_led_stuff.h ****     daisy::TimChannel::Config t3chn2_cfg;
  24:temp_led_stuff.h ****     daisy::TimChannel::Config t5chn4_cfg;
  25:temp_led_stuff.h **** 
  26:temp_led_stuff.h ****     /** now a bunch of consts for the strings of LEDs */
  27:temp_led_stuff.h ****     const int kPorchSize = 6;
  28:temp_led_stuff.h ****     const int kNumPthLeds = 10 + 2 * kPorchSize;
  29:temp_led_stuff.h ****     const int kNumSmtLeds = 25 + 2 * kPorchSize;
  30:temp_led_stuff.h **** 
  31:temp_led_stuff.h ****     const size_t kOutPthDataSize = kNumPthLeds * 3 * 8;
  32:temp_led_stuff.h ****     const size_t kOutSmtDataSize = kNumSmtLeds * 3 * 8;
  33:temp_led_stuff.h **** 
  34:temp_led_stuff.h ****     uint8_t led_pth_data[kNumPthLeds][3]; /**< RGB data */
  35:temp_led_stuff.h ****     uint8_t led_smt_data[kNumSmtLeds][3]; /**< RGB data */
  36:temp_led_stuff.h **** 
  37:temp_led_stuff.h ****     uint32_t DMA_BUFFER_MEM_SECTION
  38:temp_led_stuff.h ****         output_pth_data[kNumPthLeds * 3 * 8]; /**< PWM lengths data, one "duration" per bit */
  39:temp_led_stuff.h ****     uint32_t DMA_BUFFER_MEM_SECTION
  40:temp_led_stuff.h ****         output_smt_data[kNumSmtLeds * 3 * 8]; /**< PWM lengths data, one "duration" per bit */
  41:temp_led_stuff.h **** 
  42:temp_led_stuff.h ****     /** actually measuring on chompi pre-rework */
  43:temp_led_stuff.h ****     // const int kOneTime = 31;
  44:temp_led_stuff.h ****     // const int kZeroTime = 13;
  45:temp_led_stuff.h ****     // const int kOneTime = 28;
  46:temp_led_stuff.h ****     // const int kZeroTime = 8;
ARM GAS  C:\msys64\tmp\ccDg23TE.s 			page 44


  47:temp_led_stuff.h **** 
  48:temp_led_stuff.h ****     /** Tweaked for Rev2 hardware */
  49:temp_led_stuff.h ****     const int kOneTime = 20; /**< measured 0.68us */
  50:temp_led_stuff.h ****     const int kZeroTime = 10; /**< measured 0.334us */
  51:temp_led_stuff.h ****     const int kLedResetTime = 1; // reset time in ms, actually ends up being 2x this
  52:temp_led_stuff.h **** 
  53:temp_led_stuff.h ****     /** map pth led index to chain index */
  54:temp_led_stuff.h **** 
  55:temp_led_stuff.h **** 
  56:temp_led_stuff.h ****     void EndOfLeds(void* context);
  57:temp_led_stuff.h **** 
  58:temp_led_stuff.h ****     /** @brief setup LEDs */
  59:temp_led_stuff.h ****     void LedSetup()
  60:temp_led_stuff.h ****     {
  61:temp_led_stuff.h ****         // zero out the buffers
  62:temp_led_stuff.h ****         std::fill(led_pth_data[0], led_pth_data[0] + kNumPthLeds * 3, 0);
  63:temp_led_stuff.h ****         std::fill(led_smt_data[0], led_smt_data[0] + kNumSmtLeds * 3, 0);
  64:temp_led_stuff.h **** 
  65:temp_led_stuff.h ****         std::fill(output_pth_data, output_pth_data + kNumPthLeds * 3 * 8, 0);
  66:temp_led_stuff.h ****         std::fill(output_smt_data, output_smt_data + kNumSmtLeds * 3 * 8, 0);
  67:temp_led_stuff.h **** 
  68:temp_led_stuff.h ****         /** Config */
  69:temp_led_stuff.h ****         tim3_cfg.periph = daisy::TimerHandle::Config::Peripheral::TIM_3;
  70:temp_led_stuff.h ****         tim5_cfg.periph = daisy::TimerHandle::Config::Peripheral::TIM_5;
  71:temp_led_stuff.h ****         tim3_cfg.dir = daisy::TimerHandle::Config::CounterDir::UP;
  72:temp_led_stuff.h ****         tim5_cfg.dir = daisy::TimerHandle::Config::CounterDir::UP;
  73:temp_led_stuff.h **** 
  74:temp_led_stuff.h ****         /** Init */
  75:temp_led_stuff.h ****         tim3_smt.Init(tim3_cfg);
  76:temp_led_stuff.h ****         tim5_pth.Init(tim5_cfg);
  77:temp_led_stuff.h **** 
  78:temp_led_stuff.h ****         /** Generate period for timer
  79:temp_led_stuff.h ****          *  This is a marvelously useful little tidbit that should be put into a TimerHandle functi
  80:temp_led_stuff.h ****          */
  81:temp_led_stuff.h ****         uint32_t prescaler = 8;
  82:temp_led_stuff.h ****         uint32_t tickspeed = (daisy::System::GetPClk2Freq() * 2) / prescaler;
  83:temp_led_stuff.h ****         uint32_t target_pulse_freq = 833332; /**< 1.2 microsecond symbol length */
  84:temp_led_stuff.h ****         uint32_t period = (tickspeed / target_pulse_freq) - 1;
  85:temp_led_stuff.h ****         tim3_smt.SetPrescaler(prescaler - 1); /**< ps=0 is divide by 1 and so on.*/
  86:temp_led_stuff.h ****         tim3_smt.SetPeriod(period);
  87:temp_led_stuff.h ****         tim5_pth.SetPrescaler(prescaler - 1); /**< ps=0 is divide by 1 and so on.*/
  88:temp_led_stuff.h ****         tim5_pth.SetPeriod(period);
  89:temp_led_stuff.h **** 
  90:temp_led_stuff.h ****         /** TIM3 Ch1 is for another set:
  91:temp_led_stuff.h ****          *  All keyboard LEDs (looks like K1 - K28 in sequence)
  92:temp_led_stuff.h ****          */
