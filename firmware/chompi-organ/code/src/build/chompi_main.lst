 126:chompi_main.cpp **** /** Key-bar color modes. */
 127:chompi_main.cpp **** enum BarKind
 128:chompi_main.cpp **** {
 129:chompi_main.cpp ****     kBarVolume, /**< green/orange/red position gradient */
 130:chompi_main.cpp ****     kBarWave,   /**< uniformly blue: waveform morph bar */
ARM GAS  C:\msys64\tmp\ccDg23TE.s 			page 40


 131:chompi_main.cpp ****     kBarDrive   /**< uniformly red: overdrive bar */
 132:chompi_main.cpp **** };
 133:chompi_main.cpp **** 
 134:chompi_main.cpp **** /** Key-bar color by white-key position w (0 = leftmost): volume bars
 135:chompi_main.cpp ****  *  (page-1 pipes + master volume) run green for the first 50% of keys,
 136:chompi_main.cpp ****  *  orange 50-75%, red above 75%. The page-2 waveform bar (kBarWave)
 137:chompi_main.cpp ****  *  is uniformly blue; the overdrive bar (kBarDrive) is uniformly red. */
 138:chompi_main.cpp **** static void BarKeyColor(int w, BarKind kind, float &r, float &g, float &b)
 139:chompi_main.cpp **** {
 140:chompi_main.cpp ****     if(kind == kBarWave)
 141:chompi_main.cpp ****     {
 142:chompi_main.cpp ****         r = 0.f;
 143:chompi_main.cpp ****         g = 0.f;
 144:chompi_main.cpp ****         b = 1.f; /* blue: the whole waveform bar */
 145:chompi_main.cpp ****         return;
 146:chompi_main.cpp ****     }
 147:chompi_main.cpp ****     if(kind == kBarDrive)
 148:chompi_main.cpp ****     {
 149:chompi_main.cpp ****         r = 1.f;
 150:chompi_main.cpp ****         g = 0.f;
 151:chompi_main.cpp ****         b = 0.f; /* red: the whole overdrive bar, no gradient */
 152:chompi_main.cpp ****         return;
 153:chompi_main.cpp ****     }
 154:chompi_main.cpp ****     r = 0.f;
 155:chompi_main.cpp ****     g = 1.f;
 156:chompi_main.cpp ****     b = 0.f; /* green: first 50% of keys */
 157:chompi_main.cpp ****     if(w >= 11) /* keys 11-14: above 75% */
 158:chompi_main.cpp ****     {
 159:chompi_main.cpp ****         r = 1.f;
 160:chompi_main.cpp ****         g = 0.f; /* red */
 161:chompi_main.cpp ****     }
 162:chompi_main.cpp ****     else if(w >= 7) /* keys 7-10: 50-75% */
 163:chompi_main.cpp ****     {
 164:chompi_main.cpp ****         r = 1.f;
 165:chompi_main.cpp ****         g = .6f; /* orange */
 166:chompi_main.cpp ****     }
 167:chompi_main.cpp **** }
