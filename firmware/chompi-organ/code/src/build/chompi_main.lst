 175:MidiHandler.h ****     /* DMA out queue, same pattern as chompi-wave's MidiManager */
 176:MidiHandler.h ****     void StartDmaTransfer()
 177:MidiHandler.h ****     {
 178:MidiHandler.h ****         uint8_t *p   = fifo[fifo_tail].data;
 179:MidiHandler.h ****         size_t   len = fifo[fifo_tail].length;
 180:MidiHandler.h **** 
 181:MidiHandler.h ****         uintptr_t start = (uintptr_t)p & ~(32 - 1);
 182:MidiHandler.h ****         uintptr_t end   = ((uintptr_t)p + len + 32 - 1) & ~(32 - 1);
 183:MidiHandler.h ****         SCB_CleanDCache_by_Addr((uint32_t *)start, end - start);
 184:MidiHandler.h **** 
 185:MidiHandler.h ****         uart_handler_.DmaTransmit(p, len, nullptr, TxEndCallback, this);
 186:MidiHandler.h ****     }
 187:MidiHandler.h **** 
 188:MidiHandler.h ****     void QueueDmaMessage(uint8_t *msg, size_t length)
 189:MidiHandler.h ****     {
 190:MidiHandler.h ****         fifo[fifo_head].length = length;
 191:MidiHandler.h ****         memcpy(fifo[fifo_head].data, msg, length);
 192:MidiHandler.h ****         fifo_head = (fifo_head + 1) % 64;
 193:MidiHandler.h **** 
 194:MidiHandler.h ****         if(!uart_tx_busy)
 195:MidiHandler.h ****         {
 196:MidiHandler.h ****             __disable_irq();
 197:MidiHandler.h ****             DequeueDmaMessage();
 198:MidiHandler.h ****             __enable_irq();
 199:MidiHandler.h ****         }
 200:MidiHandler.h ****     }
 201:MidiHandler.h **** 
 202:MidiHandler.h ****     void DequeueDmaMessage()
 203:MidiHandler.h ****     {
 204:MidiHandler.h ****         if(fifo_head == fifo_tail)
 205:MidiHandler.h ****         {
 206:MidiHandler.h ****             fifo_head = (fifo_head + 1) % 64;
 207:MidiHandler.h ****         }
 208:MidiHandler.h ****         if(!uart_tx_busy)
 209:MidiHandler.h ****         {
 210:MidiHandler.h ****             uart_tx_busy = true;
 211:MidiHandler.h ****             StartDmaTransfer();
 212:MidiHandler.h ****         }
 213:MidiHandler.h ****     }
