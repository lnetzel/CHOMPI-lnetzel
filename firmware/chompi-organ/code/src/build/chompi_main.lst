 161:MidiHandler.h ****     bool GetMidi(MidiEvent &event)
 162:MidiHandler.h ****     {
 163:MidiHandler.h ****         uart_midi.Listen();
 164:MidiHandler.h **** 
 165:MidiHandler.h ****         if(uart_midi.HasEvents())
 166:MidiHandler.h ****         {
 167:MidiHandler.h ****             event = uart_midi.PopEvent();
