 188:OrganEngine.h ****     void NoteOn(uint8_t note, float velocity)
 189:OrganEngine.h ****     {
 190:OrganEngine.h ****         note_held_[note & 0x7f] = true;
 191:OrganEngine.h **** 
 192:OrganEngine.h ****         /* Retrigger: reuse a voice already playing/releasing this note */
 193:OrganEngine.h ****         for(int v = 0; v < kNumVoices; v++)
 194:OrganEngine.h ****         {
 195:OrganEngine.h ****             Voice &voice = voices_[v];
 196:OrganEngine.h ****             if((voice.state == ATTACK || voice.state == SUSTAIN
 197:OrganEngine.h ****                 || voice.state == RELEASE)
 198:OrganEngine.h ****                && voice.note == note)
 199:OrganEngine.h ****             {
 200:OrganEngine.h ****                 StartVoice(voice, note, velocity);
 201:OrganEngine.h ****                 return;
 202:OrganEngine.h ****             }
 203:OrganEngine.h ****         }
