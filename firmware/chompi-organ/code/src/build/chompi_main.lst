 179:../../../chompi-wave/code/libs/libDaisy/src/hid/midi.h **** 
 180:../../../chompi-wave/code/libs/libDaisy/src/hid/midi.h ****     /** Starts listening on the selected input mode(s).
 181:../../../chompi-wave/code/libs/libDaisy/src/hid/midi.h ****      * MidiEvent Queue will begin to fill, and can be checked with HasEvents() */
 182:../../../chompi-wave/code/libs/libDaisy/src/hid/midi.h ****     void StartReceive()
 183:../../../chompi-wave/code/libs/libDaisy/src/hid/midi.h ****     {
 184:../../../chompi-wave/code/libs/libDaisy/src/hid/midi.h ****         transport_.StartRx(MidiHandler::ParseCallback, this);
 185:../../../chompi-wave/code/libs/libDaisy/src/hid/midi.h ****     }
 186:../../../chompi-wave/code/libs/libDaisy/src/hid/midi.h **** 
 187:../../../chompi-wave/code/libs/libDaisy/src/hid/midi.h ****     /** Start listening */
 188:../../../chompi-wave/code/libs/libDaisy/src/hid/midi.h ****     void Listen()
 189:../../../chompi-wave/code/libs/libDaisy/src/hid/midi.h ****     {
 190:../../../chompi-wave/code/libs/libDaisy/src/hid/midi.h ****         // In case of UART Error, (particularly
 191:../../../chompi-wave/code/libs/libDaisy/src/hid/midi.h ****         //  overrun error), UART disables itself.
 192:../../../chompi-wave/code/libs/libDaisy/src/hid/midi.h ****         // Flush the buff, and restart.
 193:../../../chompi-wave/code/libs/libDaisy/src/hid/midi.h ****         if(!transport_.RxActive())
 194:../../../chompi-wave/code/libs/libDaisy/src/hid/midi.h ****         {
 195:../../../chompi-wave/code/libs/libDaisy/src/hid/midi.h ****             parser_.Reset();
 196:../../../chompi-wave/code/libs/libDaisy/src/hid/midi.h ****             transport_.FlushRx();
 197:../../../chompi-wave/code/libs/libDaisy/src/hid/midi.h ****             StartReceive();
 198:../../../chompi-wave/code/libs/libDaisy/src/hid/midi.h ****         }
 199:../../../chompi-wave/code/libs/libDaisy/src/hid/midi.h ****     }
 200:../../../chompi-wave/code/libs/libDaisy/src/hid/midi.h **** 
 201:../../../chompi-wave/code/libs/libDaisy/src/hid/midi.h ****     /** Checks if there are unhandled messages in the queue
 202:../../../chompi-wave/code/libs/libDaisy/src/hid/midi.h ****     \return True if there are events to be handled, else false.
 203:../../../chompi-wave/code/libs/libDaisy/src/hid/midi.h ****      */
 204:../../../chompi-wave/code/libs/libDaisy/src/hid/midi.h ****     bool HasEvents() const { return event_q_.GetNumElements() > 0; }
 205:../../../chompi-wave/code/libs/libDaisy/src/hid/midi.h **** 
