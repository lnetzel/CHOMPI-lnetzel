   4:../../../chompi-wave/code/libs/libDaisy/src/per/i2c.h **** namespace daisy
   5:../../../chompi-wave/code/libs/libDaisy/src/per/i2c.h **** {
   6:../../../chompi-wave/code/libs/libDaisy/src/per/i2c.h **** /** A handle for interacting with an I2C peripheral. This is a dumb
   7:../../../chompi-wave/code/libs/libDaisy/src/per/i2c.h ****  *  gateway that internally points to one of the four I2C peripherals
   8:../../../chompi-wave/code/libs/libDaisy/src/per/i2c.h ****  *  after it was initialised. It can then be copied and passed around.
   9:../../../chompi-wave/code/libs/libDaisy/src/per/i2c.h ****  *  Use an I2CHandle like this:
  10:../../../chompi-wave/code/libs/libDaisy/src/per/i2c.h ****  *  
  11:../../../chompi-wave/code/libs/libDaisy/src/per/i2c.h ****  *      // setup the configuration
  12:../../../chompi-wave/code/libs/libDaisy/src/per/i2c.h ****  *      I2CHandle::Config i2c_conf;
  13:../../../chompi-wave/code/libs/libDaisy/src/per/i2c.h ****  *      i2c_conf.periph = I2CHandle::Config::Peripheral::I2C_1;
  14:../../../chompi-wave/code/libs/libDaisy/src/per/i2c.h ****  *      i2c_conf.speed  = I2CHandle::Config::Speed::I2C_400KHZ;
  15:../../../chompi-wave/code/libs/libDaisy/src/per/i2c.h ****  *      i2c_conf.mode   = I2CHandle::Config::Mode::Master;
  16:../../../chompi-wave/code/libs/libDaisy/src/per/i2c.h ****  *      i2c_conf.pin_config.scl  = {DSY_GPIOB, 8};
  17:../../../chompi-wave/code/libs/libDaisy/src/per/i2c.h ****  *      i2c_conf.pin_config.sda  = {DSY_GPIOB, 9};
  18:../../../chompi-wave/code/libs/libDaisy/src/per/i2c.h ****  *      // initialise the peripheral
  19:../../../chompi-wave/code/libs/libDaisy/src/per/i2c.h ****  *      I2CHandle i2c;
  20:../../../chompi-wave/code/libs/libDaisy/src/per/i2c.h ****  *      i2c.Init(i2c_conf);
  21:../../../chompi-wave/code/libs/libDaisy/src/per/i2c.h ****  *      // now i2c points to the corresponding peripheral and can be used.
  22:../../../chompi-wave/code/libs/libDaisy/src/per/i2c.h ****  *      i2c.TransmitBlocking( ... );
  23:../../../chompi-wave/code/libs/libDaisy/src/per/i2c.h ****  */
