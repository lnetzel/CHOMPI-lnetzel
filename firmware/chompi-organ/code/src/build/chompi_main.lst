  38:../../../chompi-wave/code/libs/libDaisy/src/per/adc.h ****         MUX_SEL_2,    /**< & */
  39:../../../chompi-wave/code/libs/libDaisy/src/per/adc.h ****         MUX_SEL_LAST, /**< & */
  40:../../../chompi-wave/code/libs/libDaisy/src/per/adc.h ****     };
