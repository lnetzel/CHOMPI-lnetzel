  72:../../../chompi-wave/code/libs/libDaisy/src/per/sdmmc.h ****             width           = BusWidth::BITS_4;
  73:../../../chompi-wave/code/libs/libDaisy/src/per/sdmmc.h ****             clock_powersave = false;
  74:../../../chompi-wave/code/libs/libDaisy/src/per/sdmmc.h ****         }
  75:../../../chompi-wave/code/libs/libDaisy/src/per/sdmmc.h ****     };
