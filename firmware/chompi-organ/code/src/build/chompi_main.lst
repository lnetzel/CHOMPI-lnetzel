 119:temp_led_stuff.h ****     void populate_bits(uint8_t color_val, uint32_t *buff)
 120:temp_led_stuff.h ****     {
 121:temp_led_stuff.h ****         for (int i = 0; i < 8; i++)
 122:temp_led_stuff.h ****         {
