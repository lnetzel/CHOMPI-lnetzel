   1:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h **** #pragma once
   2:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h **** #ifndef DSY_TIM_H
   3:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h **** #define DSY_TIM_H
   4:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h **** 
   5:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h **** #include <cstdint>
   6:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h **** 
   7:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h **** namespace daisy
   8:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h **** {
   9:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h **** /** @brief Hardare timer peripheral support.
  10:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****  ** 
  11:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****  ** Supports general-function TIM peripherals:
  12:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****  ** - TIM2, TIM3, TIM4, TIM5
  13:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****  **
  14:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****  ** DaisySeed, and many internal peripherals utilize TIM2 for timing/delay purposes.
  15:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****  ** It is configured to be at the maximum frequency: typically 200MHz or 240MHz (boost) 
  16:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****  ** for measuring/delaying for very short periods. 
  17:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****  **
  18:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****  ** The GetUs/GetMs functions are available for convenience (and backwards compatibility),
  19:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****  ** but to avoid wrapping errors on math when doing time-delta calculations, using ticks is 
  20:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****  ** recommended. The data can be converted to the final time-base after getting the difference in t
  21:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****  ** (Using GetFreq() can be used for these time-base calculations).
  22:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****  **
  23:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****  ** User callbacks can be set, and changed at any point during operation. However,
  24:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****  ** the Config::enable_irq must be set to true when initializing for the interrupts
  25:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****  ** to turn on and function.
  26:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****  **
  27:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****  ** @todo Fix issues with realtime getters, and wrapping of the timer(s).
  28:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****  **     - This very noticeable with default settings for the 16-bit counters.
  29:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****  ** @todo Other General purpose timers
ARM GAS  C:\msys64\tmp\cc9NRbLb.s 			page 2


  30:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****  ** @todo Non-internal clock sources
  31:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****  ** @todo Use of the four-tim channels per tim
  32:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****  **     - PWM, etc.
  33:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****  **     - InputCapture/OutputCompare, etc.
  34:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****  ** @todo HRTIM
  35:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****  ** @todo Advanced timers (TIM1/TIM8)
  36:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****  ** */
  37:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h **** class TimerHandle
  38:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h **** {
  39:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****   public:
  40:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****     /** @brief Configuration struct for the Peripheral
  41:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****      *  @note These settings are used during initialization
  42:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****      *   and changing them afterwards may not have the desired effect.
  43:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****      */
  44:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****     struct Config
  45:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****     {
  46:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****         /** @brief Hardware Timer to configure, and use. */
  47:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****         enum class Peripheral
  48:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****         {
  49:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****             TIM_2 = 0, /**< 32-bit counter */
  50:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****             TIM_3,     /**< 16-bit counter */
  51:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****             TIM_4,     /**< 16-bit counter */
  52:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****             TIM_5,     /**< 32-bit counter*/
  53:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****             TIM_16
  54:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****         };
  55:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h **** 
  56:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****         /** @brief Direction of the auto-reload counter. 
  57:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****          ** @todo Add support for the various  
  58:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****          ** versions of Up/Down counters.
  59:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****          ** */
  60:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****         enum class CounterDir
  61:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****         {
  62:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****             UP = 0,
  63:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****             DOWN,
  64:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****         };
  65:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h **** 
  66:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****         Peripheral periph; /**< Hardware Peripheral */
  67:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****         CounterDir dir;    /**< Counter direction */
  68:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h **** 
  69:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****         /** @brief period in ticks at TIM frequency that counter will reset based on dir
  70:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****          *  @note TIM3 and TIM4 are both 16-bit timers. So the period maximum is 0xffff.
  71:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****         */
  72:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****         uint32_t period;
  73:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****         bool     enable_irq; /**< Enable interrupt for user based callback */
  74:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h **** 
  75:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****         /* @brief Constructor for default states */
  76:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****         Config()
  77:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****         : periph(Peripheral::TIM_2),
  78:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****           dir(CounterDir::UP),
  79:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****           period(0xffffffff),
  80:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****           enable_irq(false)
  81:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****         {
  82:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****         }
  83:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****     };
  84:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h **** 
  85:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****     /** @brief Return values for TIM funcitons. */
  86:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****     enum class Result
ARM GAS  C:\msys64\tmp\cc9NRbLb.s 			page 3


  87:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****     {
  88:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****         OK,
  89:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****         ERR,
  90:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****     };
  91:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h **** 
  92:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****     /** @brief User Callback type that will fire at the end of each timer 
