   1:temp_led_stuff.h **** /** This is a temporary kludge of stuff necessary to run the
   2:temp_led_stuff.h ****  *  LEDs without the ideal API in libDaisy yet.
   3:temp_led_stuff.h ****  *
   4:temp_led_stuff.h ****  *  CHOMPI's two LED chains (PTH is the through-hole panel LEDs, SMT is
   5:temp_led_stuff.h ****  *  the 25 keybed LEDs, both WS2812-style addressable RGB) are driven by timer
   6:temp_led_stuff.h ****  *  PWM+DMA. Each color bit becomes one PWM pulse whose ON-duration
   7:temp_led_stuff.h ****  *  encodes a 1 or 0 (kOneTime/kZeroTime), in timer ticks. Each chain
   8:temp_led_stuff.h ****  *  needs a few LED-times of "porch" (kPorchSize) at each end sending zero pulses.
   9:temp_led_stuff.h ****  *  The setup creates the correct timing and format for the data signal using the libDaisy timers.
  10:temp_led_stuff.h ****  *  The buffers are set per LED throughout the UI pages Draw() function then formatted
  11:temp_led_stuff.h ****  *  and put in the DMA buffers in fill_led_data() which is called at the end of Draw()
  12:temp_led_stuff.h ****  */
  13:temp_led_stuff.h **** #pragma once
  14:temp_led_stuff.h **** #include "daisy_seed.h"
  15:temp_led_stuff.h **** 
  16:temp_led_stuff.h **** namespace chompi
  17:temp_led_stuff.h **** {
  18:temp_led_stuff.h ****     /** Global timer refs. */
  19:temp_led_stuff.h ****     daisy::TimerHandle tim3_smt, tim5_pth;
  20:temp_led_stuff.h ****     daisy::TimChannel ledPthPwm, ledSmtPwm;
  21:temp_led_stuff.h ****     daisy::TimerHandle::Config tim3_cfg;
  22:temp_led_stuff.h ****     daisy::TimerHandle::Config tim5_cfg;
  23:temp_led_stuff.h ****     daisy::TimChannel::Config t3chn2_cfg;
  24:temp_led_stuff.h ****     daisy::TimChannel::Config t5chn4_cfg;
  25:temp_led_stuff.h **** 
  26:temp_led_stuff.h ****     /** now a bunch of consts for the strings of LEDs */
  27:temp_led_stuff.h ****     const int kPorchSize = 6;
  28:temp_led_stuff.h ****     const int kNumPthLeds = 10 + 2 * kPorchSize;
  29:temp_led_stuff.h ****     const int kNumSmtLeds = 25 + 2 * kPorchSize;
  30:temp_led_stuff.h **** 
  31:temp_led_stuff.h ****     const size_t kOutPthDataSize = kNumPthLeds * 3 * 8;
  32:temp_led_stuff.h ****     const size_t kOutSmtDataSize = kNumSmtLeds * 3 * 8;
  33:temp_led_stuff.h **** 
  34:temp_led_stuff.h ****     uint8_t led_pth_data[kNumPthLeds][3]; /**< RGB data */
  35:temp_led_stuff.h ****     uint8_t led_smt_data[kNumSmtLeds][3]; /**< RGB data */
  36:temp_led_stuff.h **** 
  37:temp_led_stuff.h ****     uint32_t DMA_BUFFER_MEM_SECTION
  38:temp_led_stuff.h ****         output_pth_data[kNumPthLeds * 3 * 8]; /**< PWM lengths data, one "duration" per bit */
  39:temp_led_stuff.h ****     uint32_t DMA_BUFFER_MEM_SECTION
  40:temp_led_stuff.h ****         output_smt_data[kNumSmtLeds * 3 * 8]; /**< PWM lengths data, one "duration" per bit */
  41:temp_led_stuff.h **** 
  42:temp_led_stuff.h ****     /** actually measuring on chompi pre-rework */
  43:temp_led_stuff.h ****     // const int kOneTime = 31;
  44:temp_led_stuff.h ****     // const int kZeroTime = 13;
  45:temp_led_stuff.h ****     // const int kOneTime = 28;
