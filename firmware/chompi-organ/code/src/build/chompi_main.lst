 239:../../../chompi-wave/code/libs/libDaisy/src/hid/midi.h ****     Transport& GetMutableTransport() { return transport_; }
 240:../../../chompi-wave/code/libs/libDaisy/src/hid/midi.h **** 
 241:../../../chompi-wave/code/libs/libDaisy/src/hid/midi.h ****     /** Feed in bytes to state machine from a queue.
 242:../../../chompi-wave/code/libs/libDaisy/src/hid/midi.h ****         Populates internal FIFO queue with MIDI Messages
 243:../../../chompi-wave/code/libs/libDaisy/src/hid/midi.h ****         For example with uart:
 244:../../../chompi-wave/code/libs/libDaisy/src/hid/midi.h ****         midi.Parse(uart.PopRx());
 245:../../../chompi-wave/code/libs/libDaisy/src/hid/midi.h ****         \note  Normally application code won't need to use this method directly.
 246:../../../chompi-wave/code/libs/libDaisy/src/hid/midi.h ****         \param byte MIDI byte to be parsed
 247:../../../chompi-wave/code/libs/libDaisy/src/hid/midi.h ****     */
 248:../../../chompi-wave/code/libs/libDaisy/src/hid/midi.h ****     void Parse(uint8_t byte)
 249:../../../chompi-wave/code/libs/libDaisy/src/hid/midi.h ****     {
 250:../../../chompi-wave/code/libs/libDaisy/src/hid/midi.h ****         MidiEvent event;
 251:../../../chompi-wave/code/libs/libDaisy/src/hid/midi.h ****         if(parser_.Parse(byte, &event))
