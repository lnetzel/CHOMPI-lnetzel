 237:OrganEngine.h ****     void NoteOff(uint8_t note)
 238:OrganEngine.h ****     {
 239:OrganEngine.h ****         note &= 0x7f;
 240:OrganEngine.h ****         note_held_[note] = false;
 241:OrganEngine.h **** 
 242:OrganEngine.h ****         for(int v = 0; v < kNumVoices; v++)
 243:OrganEngine.h ****         {
 244:OrganEngine.h ****             Voice &voice = voices_[v];
 245:OrganEngine.h ****             if((voice.state == ATTACK || voice.state == SUSTAIN)
 246:OrganEngine.h ****                && voice.note == note)
 247:OrganEngine.h ****             {
 248:OrganEngine.h ****                 voice.state = RELEASE;
 249:OrganEngine.h ****             }
 250:OrganEngine.h ****             else if(voice.state == STEAL && voice.pending_note == note)
 251:OrganEngine.h ****             {
 252:OrganEngine.h ****                 /* stolen voice's pending note was cancelled: just fade out */
 253:OrganEngine.h ****                 voice.state = RELEASE;
