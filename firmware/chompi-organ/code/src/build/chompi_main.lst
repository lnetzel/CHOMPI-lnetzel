  48:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****         {
  49:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****             TIM_2 = 0, /**< 32-bit counter */
  50:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****             TIM_3,     /**< 16-bit counter */
  51:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****             TIM_4,     /**< 16-bit counter */
  52:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****             TIM_5,     /**< 32-bit counter*/
  53:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****             TIM_16
  54:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****         };
  55:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h **** 
  56:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****         /** @brief Direction of the auto-reload counter. 
  57:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****          ** @todo Add support for the various  
  58:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****          ** versions of Up/Down counters.
  59:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****          ** */
  60:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****         enum class CounterDir
  61:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****         {
  62:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****             UP = 0,
  63:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****             DOWN,
  64:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****         };
  65:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h **** 
  66:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****         Peripheral periph; /**< Hardware Peripheral */
  67:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****         CounterDir dir;    /**< Counter direction */
  68:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h **** 
  69:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****         /** @brief period in ticks at TIM frequency that counter will reset based on dir
  70:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****          *  @note TIM3 and TIM4 are both 16-bit timers. So the period maximum is 0xffff.
  71:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****         */
  72:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****         uint32_t period;
  73:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****         bool     enable_irq; /**< Enable interrupt for user based callback */
  74:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h **** 
  75:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****         /* @brief Constructor for default states */
  76:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****         Config()
  77:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****         : periph(Peripheral::TIM_2),
  78:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****           dir(CounterDir::UP),
  79:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****           period(0xffffffff),
  80:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****           enable_irq(false)
  81:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****         {
  82:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****         }
  83:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****     };
  84:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h **** 
  85:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****     /** @brief Return values for TIM funcitons. */
  86:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****     enum class Result
ARM GAS  C:\msys64\tmp\cc4f64bL.s 			page 3


  87:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****     {
  88:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****         OK,
  89:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****         ERR,
