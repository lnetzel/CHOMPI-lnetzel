   1:RotarySpeaker.h **** /** @file RotarySpeaker.h
   2:RotarySpeaker.h ****  *  @brief 60s Hammond-style rotary speaker (Leslie) simulation (DSP-6).
   3:RotarySpeaker.h ****  *
   4:RotarySpeaker.h ****  *  An 800 Hz one-pole crossover splits the mono organ mix into a drum band
   5:RotarySpeaker.h ****  *  (low) and a horn band (high). Two virtual mics 180 degrees apart turn
   6:RotarySpeaker.h ****  *  each band into stereo:
   7:RotarySpeaker.h ****  *   - Horn mic: Doppler pitch wobble via a modulated fractional delay tap
   8:RotarySpeaker.h ****  *     plus sinusoidal amplitude modulation, both locked to the horn phase
   9:RotarySpeaker.h ****  *     (the real horn does the same: loudest and pitch-bent when it points
  10:RotarySpeaker.h ****  *     at the mic)
  11:RotarySpeaker.h ****  *   - Drum: deep soft AM throb (one squared-sine pulse per revolution),
  12:RotarySpeaker.h ****  *     no Doppler (bass wavelengths barely pitch-shift), running ~13%
  13:RotarySpeaker.h ****  *     slower than the horn (mechanical slip), so the two rotors beat
  14:RotarySpeaker.h ****  *     against each other like the real cabinet
  15:RotarySpeaker.h ****  *  Amount 0 is an exact bypass. The amount also ramps the rotor speed
  16:RotarySpeaker.h ****  *  from a slow chorale-like swirl to the classic fast tremolo
  17:RotarySpeaker.h ****  *  (2 -> 6.8 Hz), like a Leslie spinning up.
  18:RotarySpeaker.h ****  */
  19:RotarySpeaker.h **** #pragma once
  20:RotarySpeaker.h **** #include "daisysp.h"
  21:RotarySpeaker.h **** 
  22:RotarySpeaker.h **** namespace chompi
  23:RotarySpeaker.h **** {
  24:RotarySpeaker.h **** 
  25:RotarySpeaker.h **** class RotarySpeaker
  26:RotarySpeaker.h **** {
  27:RotarySpeaker.h ****   public:
  28:RotarySpeaker.h ****     void Init(float sample_rate)
  29:RotarySpeaker.h ****     {
  30:RotarySpeaker.h ****         sample_rate_ = sample_rate;
  31:RotarySpeaker.h ****         amount_      = amount_target_ = 0.f;
  32:RotarySpeaker.h ****         horn_ph_     = 0.f;
  33:RotarySpeaker.h ****         drum_ph_     = .25f; /* horn and drum never lock mechanically */
  34:RotarySpeaker.h ****         lp_          = 0.f;
  35:RotarySpeaker.h ****         lp_coeff_    = 1.f - expf(-kTwoPi * kCrossoverHz / sample_rate);
  36:RotarySpeaker.h ****         wr_          = 0;
  37:RotarySpeaker.h ****         for(int i = 0; i < kDlyLen; i++)
  38:RotarySpeaker.h ****             dly_[i] = 0.f;
  39:RotarySpeaker.h ****     }
  40:RotarySpeaker.h **** 
