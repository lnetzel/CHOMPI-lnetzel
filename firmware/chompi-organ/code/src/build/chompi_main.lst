   3:MidiHandler.h ****  *  CC 70-73 for the four pipe levels, CC 74-77 for the four pipe waveform
   4:MidiHandler.h ****  *  morphs. UART (5-pin DIN) uses DMA transmit;
   5:MidiHandler.h ****  *  adapted from chompi-wave's MidiManager.h (see FR-5b).
   6:MidiHandler.h ****  */
   7:MidiHandler.h **** #pragma once
