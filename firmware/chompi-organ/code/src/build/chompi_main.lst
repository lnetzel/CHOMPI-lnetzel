 112:OrganEngine.h ****     void NoteOn(uint8_t note, float velocity)
 113:OrganEngine.h ****     {
 114:OrganEngine.h ****         note_held_[note & 0x7f] = true;
 115:OrganEngine.h **** 
 116:OrganEngine.h ****         /* Retrigger: reuse a voice already playing/releasing this note */
 117:OrganEngine.h ****         for(int v = 0; v < kNumVoices; v++)
 118:OrganEngine.h ****         {
 119:OrganEngine.h ****             Voice &voice = voices_[v];
 120:OrganEngine.h ****             if((voice.state == ATTACK || voice.state == SUSTAIN
 121:OrganEngine.h ****                 || voice.state == RELEASE)
 122:OrganEngine.h ****                && voice.note == note)
 123:OrganEngine.h ****             {
 124:OrganEngine.h ****                 StartVoice(voice, note, velocity);
 125:OrganEngine.h ****                 return;
 126:OrganEngine.h ****             }
 127:OrganEngine.h ****         }
 128:OrganEngine.h **** 
 129:OrganEngine.h ****         /* Free voice */
 130:OrganEngine.h ****         for(int v = 0; v < kNumVoices; v++)
 131:OrganEngine.h ****         {
 132:OrganEngine.h ****             if(voices_[v].state == IDLE)
 133:OrganEngine.h ****             {
 134:OrganEngine.h ****                 StartVoice(voices_[v], note, velocity);
 135:OrganEngine.h ****                 return;
 136:OrganEngine.h ****             }
 137:OrganEngine.h ****         }
 138:OrganEngine.h **** 
 139:OrganEngine.h ****         /* Steal the oldest voice (5 ms fade, then the new note starts) */
 140:OrganEngine.h ****         int oldest = 0;
 141:OrganEngine.h ****         for(int v = 1; v < kNumVoices; v++)
 142:OrganEngine.h ****         {
 143:OrganEngine.h ****             if(voices_[v].age < voices_[oldest].age)
 144:OrganEngine.h ****                 oldest = v;
 145:OrganEngine.h ****         }
 146:OrganEngine.h ****         Voice &voice      = voices_[oldest];
 147:OrganEngine.h ****         voice.pending_note = note;
 148:OrganEngine.h ****         voice.pending_vel  = velocity;
 149:OrganEngine.h ****         voice.state        = STEAL;
 150:OrganEngine.h ****     }
