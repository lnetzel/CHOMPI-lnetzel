 238:chompi_main.cpp **** /** Key + encoder polling, called from the audio ISR once per block (2 kHz). */
 239:chompi_main.cpp **** static void PollControls()
 240:chompi_main.cpp **** {
 241:chompi_main.cpp ****     /* shift key (CHOMPI key) */
 242:chompi_main.cpp ****     shift_held_ = hw.button_sr.State(static_cast<int>(Hardware::SwId::KEY_26));
 243:chompi_main.cpp **** 
 244:chompi_main.cpp ****     /* pipe encoder push-switches (ENC_1..4_SW = SwId 0..3): press toggles
 245:chompi_main.cpp ****      * that pipe's encoder between page 1 (volume) and page 2 (waveform);
 246:chompi_main.cpp ****      * show the newly active page's value bar as confirmation */
 247:chompi_main.cpp ****     for(int i = 0; i < 4; i++)
 248:chompi_main.cpp ****     {
 249:chompi_main.cpp ****         const bool down = hw.button_sr.State(i);
 250:chompi_main.cpp ****         if(down && !prev_enc_sw_[i])
 251:chompi_main.cpp ****         {
 252:chompi_main.cpp ****             for(int p = 0; p < OrganEngine::kNumPipes; p++)
 253:chompi_main.cpp ****             {
 254:chompi_main.cpp ****                 if(pipe_encoder[p] == i)
 255:chompi_main.cpp ****                 {
 256:chompi_main.cpp ****                     wave_page_[p] = !wave_page_[p];
 257:chompi_main.cpp ****                     bar_pipe_     = p;
 258:chompi_main.cpp ****                     bar_page_     = wave_page_[p] ? 1 : 0;
 259:chompi_main.cpp ****                     bar_until_    = System::GetNow() + 500;
 260:chompi_main.cpp ****                 }
 261:chompi_main.cpp ****             }
 262:chompi_main.cpp ****         }
 263:chompi_main.cpp ****         prev_enc_sw_[i] = down;
 264:chompi_main.cpp ****     }
 265:chompi_main.cpp **** 
 266:chompi_main.cpp ****     /* ENC_6_SW (volume-knob push, SwId 32): press toggles the volume
 267:chompi_main.cpp ****      * encoder between page 1 (master volume) and page 2 (overdrive);
 268:chompi_main.cpp ****      * show the newly active page's value bar as confirmation */
 269:chompi_main.cpp ****     {
 270:chompi_main.cpp ****         const int  vsw  = static_cast<int>(Hardware::SwId::ENC_6_SW);
 271:chompi_main.cpp ****         const bool down = hw.button_sr.State(vsw);
 272:chompi_main.cpp ****         if(down && !prev_key_[vsw])
 273:chompi_main.cpp ****         {
 274:chompi_main.cpp ****             vol_drive_page_ = !vol_drive_page_;
 275:chompi_main.cpp ****             bar_pipe_       = kVolBar;
 276:chompi_main.cpp ****             bar_page_       = vol_drive_page_ ? 1 : 0;
ARM GAS  C:\msys64\tmp\cctbVxVy.s 			page 116


 277:chompi_main.cpp ****             bar_until_      = System::GetNow() + 500;
 278:chompi_main.cpp ****         }
 279:chompi_main.cpp ****         prev_key_[vsw] = down;
 280:chompi_main.cpp ****     }
 281:chompi_main.cpp **** 
 282:chompi_main.cpp ****     /* KEY_28 (LOOP) toggles the key latch. While latched, releasing a key
 283:chompi_main.cpp ****      * keeps its note sounding; unlatching releases every latched note whose
 284:chompi_main.cpp ****      * key is not physically held down again (those keep sounding and release
 285:chompi_main.cpp ****      * normally on key release). Applies to physical keys only, never MIDI. */
 286:chompi_main.cpp ****     {
 287:chompi_main.cpp ****         const int  loop_sw = static_cast<int>(Hardware::SwId::KEY_28);
 288:chompi_main.cpp ****         const bool down    = hw.button_sr.State(loop_sw);
 289:chompi_main.cpp ****         if(down && !prev_key_[loop_sw])
 290:chompi_main.cpp ****         {
 291:chompi_main.cpp ****             latch_on_ = !latch_on_;
 292:chompi_main.cpp ****             if(!latch_on_)
 293:chompi_main.cpp ****             {
 294:chompi_main.cpp ****                 for(int swid = 7; swid < 32; swid++)
 295:chompi_main.cpp ****                 {
 296:chompi_main.cpp ****                     if(latched_[swid] && active_note_[swid] != 0
 297:chompi_main.cpp ****                        && !hw.button_sr.State(swid))
 298:chompi_main.cpp ****                     {
 299:chompi_main.cpp ****                         const uint8_t note = active_note_[swid] - 1;
 300:chompi_main.cpp ****                         engine.NoteOff(note);
 301:chompi_main.cpp ****                         out_q.PushBack({1, note, 0});
 302:chompi_main.cpp ****                     }
 303:chompi_main.cpp ****                     latched_[swid] = false;
 304:chompi_main.cpp ****                 }
 305:chompi_main.cpp ****             }
 306:chompi_main.cpp ****         }
 307:chompi_main.cpp ****         prev_key_[loop_sw] = down;
 308:chompi_main.cpp ****     }
 309:chompi_main.cpp **** 
 310:chompi_main.cpp ****     /* playable keys: SwId 7..31 (SHIFT+KEY_16/KEY_17 = octave down/up) */
 311:chompi_main.cpp ****     for(int swid = 7; swid < 32; swid++)
 312:chompi_main.cpp ****     {
 313:chompi_main.cpp ****         const bool down = hw.button_sr.State(swid);
 314:chompi_main.cpp ****         if(down == prev_key_[swid])
 315:chompi_main.cpp ****             continue;
 316:chompi_main.cpp ****         prev_key_[swid] = down;
 317:chompi_main.cpp **** 
 318:chompi_main.cpp ****         const bool oct_key = (swid == static_cast<int>(Hardware::SwId::KEY_16))
 319:chompi_main.cpp ****                              || (swid == static_cast<int>(Hardware::SwId::KEY_17));
 320:chompi_main.cpp ****         if(down)
 321:chompi_main.cpp ****         {
 322:chompi_main.cpp ****             if(shift_held_ && oct_key)
 323:chompi_main.cpp ****             {
 324:chompi_main.cpp ****                 int oct = octave_
 325:chompi_main.cpp ****                           + (swid == static_cast<int>(Hardware::SwId::KEY_16)
 326:chompi_main.cpp ****                                  ? -1
 327:chompi_main.cpp ****                                  : 1);
 328:chompi_main.cpp ****                 octave_ = oct < -2 ? -2 : (oct > 2 ? 2 : oct);
 329:chompi_main.cpp ****                 continue;
 330:chompi_main.cpp ****             }
 331:chompi_main.cpp ****             int n = key_map[swid] + 12 * octave_;
 332:chompi_main.cpp ****             n              = n < 0 ? 0 : (n > 127 ? 127 : n);
 333:chompi_main.cpp ****             const uint8_t note = static_cast<uint8_t>(n);
ARM GAS  C:\msys64\tmp\cctbVxVy.s 			page 117


 334:chompi_main.cpp ****             /* B3: re-pressing a latched key after an octave change used to
 335:chompi_main.cpp ****              * overwrite active_note_ and leak the old note (no NoteOff, no
 336:chompi_main.cpp ****              * MIDI note-off): release the old note first. */
 337:chompi_main.cpp ****             if(active_note_[swid] != 0 && active_note_[swid] - 1 != note)
 338:chompi_main.cpp ****             {
 339:chompi_main.cpp ****                 const uint8_t old = active_note_[swid] - 1;
 340:chompi_main.cpp ****                 engine.NoteOff(old);
 341:chompi_main.cpp ****                 out_q.PushBack({1, old, 0});
 342:chompi_main.cpp ****             }
 343:chompi_main.cpp ****             active_note_[swid] = note + 1;
 344:chompi_main.cpp ****             latched_[swid]     = false; /* re-press of a latched key retriggers */
 345:chompi_main.cpp ****             engine.NoteOn(note, 1.f);
 346:chompi_main.cpp ****             out_q.PushBack({0, note, 0});
 347:chompi_main.cpp ****         }
 348:chompi_main.cpp ****         else if(active_note_[swid] != 0)
 349:chompi_main.cpp ****         {
 350:chompi_main.cpp ****             /* note-off uses the note that was started (octave may have
 351:chompi_main.cpp ****              * changed, or shift may now be held, while the key was down) */
 352:chompi_main.cpp ****             if(latch_on_)
 353:chompi_main.cpp ****             {
 354:chompi_main.cpp ****                 /* latched: keep sounding; note-off is deferred to unlatch */
 355:chompi_main.cpp ****                 latched_[swid] = true;
 356:chompi_main.cpp ****             }
 357:chompi_main.cpp ****             else
 358:chompi_main.cpp ****             {
 359:chompi_main.cpp ****                 const uint8_t note   = active_note_[swid] - 1;
 360:chompi_main.cpp ****                 active_note_[swid]   = 0;
 361:chompi_main.cpp ****                 engine.NoteOff(note);
 362:chompi_main.cpp ****                 out_q.PushBack({1, note, 0});
 363:chompi_main.cpp ****             }
 364:chompi_main.cpp ****         }
 365:chompi_main.cpp ****     }
 366:chompi_main.cpp **** 
 367:chompi_main.cpp ****     /* encoders: enc_trackers accumulate clicks and reset to 0 on press */
 368:chompi_main.cpp ****     for(int i = 0; i < 6; i++)
 369:chompi_main.cpp ****     {
 370:chompi_main.cpp ****         if(hw.enc[i].RisingEdge())
 371:chompi_main.cpp ****             prev_enc_[i] = 0;
 372:chompi_main.cpp **** 
 373:chompi_main.cpp ****         const int delta = hw.enc_trackers[i] - prev_enc_[i];
 374:chompi_main.cpp ****         prev_enc_[i]    = hw.enc_trackers[i];
 375:chompi_main.cpp ****         if(delta == 0)
 376:chompi_main.cpp ****             continue;
 377:chompi_main.cpp **** 
 378:chompi_main.cpp ****         /* Chatter filter: the detent-less volume encoder can rest on a
 379:chompi_main.cpp ****          * quadrature transition and emit increment bursts at ~1 ms spacing,
 380:chompi_main.cpp ****          * which would re-arm the level bar forever. Accept at most one click
 381:chompi_main.cpp ****          * per 8 ms per encoder (fast hand turns are >10 ms per detent). */
 382:chompi_main.cpp ****         const uint32_t now_ms = System::GetNow();
 383:chompi_main.cpp ****         if(now_ms - last_click_t_[i] < 8)
 384:chompi_main.cpp ****             continue; /* dropped for good: prev_enc_ already synced */
 385:chompi_main.cpp ****         last_click_t_[i] = now_ms;
 386:chompi_main.cpp **** 
 387:chompi_main.cpp ****         if(i == kVolEnc)
 388:chompi_main.cpp ****         {
 389:chompi_main.cpp ****             if(shift_held_)
 390:chompi_main.cpp ****             {
ARM GAS  C:\msys64\tmp\cctbVxVy.s 			page 118


 391:chompi_main.cpp ****                 engine.AddFineTuneCents(delta); /* SHIFT+ENC_6: fine tune */
 392:chompi_main.cpp ****             }
 393:chompi_main.cpp ****             else if(vol_drive_page_)
 394:chompi_main.cpp ****             {
 395:chompi_main.cpp ****                 /* volume-encoder page 2: overdrive amount, 32 steps */
 396:chompi_main.cpp ****                 engine.SetDriveStep(engine.GetDriveStep() + delta);
 397:chompi_main.cpp ****                 bar_pipe_  = kVolBar;
 398:chompi_main.cpp ****                 bar_page_  = 1;
 399:chompi_main.cpp ****                 bar_until_ = System::GetNow() + 500;
 400:chompi_main.cpp ****             }
 401:chompi_main.cpp ****             else
 402:chompi_main.cpp ****             {
 403:chompi_main.cpp ****                 /* existing CHOMPI volume-knob behaviour: 100 clicks, 0..1 */
 404:chompi_main.cpp ****                 float g = engine.GetMasterGain() + delta * .01f;
 405:chompi_main.cpp ****                 engine.SetMasterGain(g);
 406:chompi_main.cpp ****                 bar_pipe_  = kVolBar;
 407:chompi_main.cpp ****                 bar_page_  = 0;
 408:chompi_main.cpp ****                 bar_until_ = System::GetNow() + 500;
 409:chompi_main.cpp ****             }
 410:chompi_main.cpp ****         }
 411:chompi_main.cpp ****         else if(i == kWheelEnc)
 412:chompi_main.cpp ****         {
 413:chompi_main.cpp ****             /* transport wheel (ENC_5): rotary-speaker amount, 32 steps */
 414:chompi_main.cpp ****             engine.SetRotaryStep(engine.GetRotaryStep() + delta);
 415:chompi_main.cpp ****             bar_pipe_  = kRotaryBar;
 416:chompi_main.cpp ****             bar_page_  = 0;
 417:chompi_main.cpp ****             bar_until_ = System::GetNow() + 500;
 418:chompi_main.cpp ****         }
 419:chompi_main.cpp ****         else
 420:chompi_main.cpp ****         {
 421:chompi_main.cpp ****             for(int p = 0; p < OrganEngine::kNumPipes; p++)
 422:chompi_main.cpp ****             {
 423:chompi_main.cpp ****                 if(pipe_encoder[p] != i)
 424:chompi_main.cpp ****                     continue;
 425:chompi_main.cpp ****                 if(wave_page_[p])
 426:chompi_main.cpp ****                 {
 427:chompi_main.cpp ****                     engine.SetPipeWaveStep(p,
 428:chompi_main.cpp ****                                            engine.GetPipeWaveStep(p) + delta);
 429:chompi_main.cpp ****                     cc_wave_step_[p]  = engine.GetPipeWaveStep(p);
 430:chompi_main.cpp ****                     cc_wave_dirty_[p] = true; /* coalesced, sent in MainLoop */
 431:chompi_main.cpp ****                     bar_page_ = 1;
 432:chompi_main.cpp ****                 }
 433:chompi_main.cpp ****                 else
 434:chompi_main.cpp ****                 {
 435:chompi_main.cpp ****                     engine.SetPipeStep(p, engine.GetPipeStep(p) + delta);
 436:chompi_main.cpp ****                     cc_pipe_step_[p]  = engine.GetPipeStep(p);
 437:chompi_main.cpp ****                     cc_pipe_dirty_[p] = true; /* coalesced, sent in MainLoop */
 438:chompi_main.cpp ****                     bar_page_ = 0;
 439:chompi_main.cpp ****                 }
 440:chompi_main.cpp ****                 bar_pipe_  = p;
 441:chompi_main.cpp ****                 bar_until_ = System::GetNow() + 500;
 442:chompi_main.cpp ****             }
 443:chompi_main.cpp ****         }
 444:chompi_main.cpp ****     }
 445:chompi_main.cpp **** }
