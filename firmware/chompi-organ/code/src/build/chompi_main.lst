   1:MidiHandler.h **** /** @file MidiHandler.h
   2:MidiHandler.h ****  *  @brief Minimal MIDI in/out for the organ: fixed channel 1, notes both ways,
   3:MidiHandler.h ****  *  CC 70-73 for the four pipe levels, CC 74-77 for the four pipe Character
   4:MidiHandler.h ****  *  amounts (tonewheel color; 0 = clean sine, 127 ~ step 64 = fully aged).
   5:MidiHandler.h ****  *  UART (5-pin DIN) uses DMA transmit;
   6:MidiHandler.h ****  *  adapted from chompi-wave's MidiManager.h (see FR-5b).
   7:MidiHandler.h ****  */
   8:MidiHandler.h **** #pragma once
   9:MidiHandler.h **** #include "daisy_seed.h"
  10:MidiHandler.h **** #include "OrganEngine.h"
  11:MidiHandler.h **** 
  12:MidiHandler.h **** using namespace daisy;
  13:MidiHandler.h **** 
  14:MidiHandler.h **** struct OrganMidiFifoEntry
  15:MidiHandler.h **** {
  16:MidiHandler.h ****     uint8_t data[3];
  17:MidiHandler.h ****     size_t  length;
  18:MidiHandler.h **** };
  19:MidiHandler.h **** 
  20:MidiHandler.h **** class OrganMidi
  21:MidiHandler.h **** {
  22:MidiHandler.h ****   public:
  23:MidiHandler.h ****     static constexpr uint8_t kChannel          = 0; /* MIDI channel 1 */
  24:MidiHandler.h ****     static constexpr uint8_t kPipeCcBase       = 70;
  25:MidiHandler.h ****     static constexpr uint8_t kCharacterCcBase  = 74;
  26:MidiHandler.h ****     static constexpr uint8_t kKeyVelocity      = 100;
  27:MidiHandler.h **** 
  28:MidiHandler.h ****     void Init(chompi::OrganEngine *engine)
  29:MidiHandler.h ****     {
  30:MidiHandler.h ****         engine_ = engine;
  31:MidiHandler.h **** 
