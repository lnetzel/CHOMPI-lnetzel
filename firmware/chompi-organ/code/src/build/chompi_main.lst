 287:hardware.h    **** 
 288:hardware.h    ****                         BMCPerformCheck(); // re-check battery status
 289:hardware.h    **** 
 290:hardware.h    ****                         if(!(batt_low_bounce == 0xff && vin_gd_bounce == 0x00))
 291:hardware.h    ****                             return; // break out early if battery status changed
 292:hardware.h    **** 
 293:hardware.h    ****                         bool led_on = (now / 250) % 2 == 0;
 294:hardware.h    ****                         for(size_t i = 0; i < kNumPthLeds; ++i)
