 218:chompi_main.cpp **** /** Key + encoder polling, called from the audio ISR once per block (2 kHz). */
 219:chompi_main.cpp **** static void PollControls()
 220:chompi_main.cpp **** {
ARM GAS  C:\msys64\tmp\ccE7R7AH.s 			page 175


 221:chompi_main.cpp ****     /* shift key (CHOMPI key) */
 222:chompi_main.cpp ****     shift_held_ = hw.button_sr.State(static_cast<int>(Hardware::SwId::KEY_26));
 223:chompi_main.cpp **** 
 224:chompi_main.cpp ****     /* pipe encoder push-switches (ENC_1..4_SW = SwId 0..3): press toggles
 225:chompi_main.cpp ****      * that pipe's encoder between page 1 (volume) and page 2 (waveform);
 226:chompi_main.cpp ****      * show the newly active page's value bar as confirmation */
 227:chompi_main.cpp ****     for(int i = 0; i < 4; i++)
 228:chompi_main.cpp ****     {
 229:chompi_main.cpp ****         const bool down = hw.button_sr.State(i);
 230:chompi_main.cpp ****         if(down && !prev_enc_sw_[i])
 231:chompi_main.cpp ****         {
 232:chompi_main.cpp ****             for(int p = 0; p < OrganEngine::kNumPipes; p++)
 233:chompi_main.cpp ****             {
 234:chompi_main.cpp ****                 if(pipe_encoder[p] == i)
 235:chompi_main.cpp ****                 {
 236:chompi_main.cpp ****                     wave_page_[p] = !wave_page_[p];
 237:chompi_main.cpp ****                     bar_pipe_     = p;
 238:chompi_main.cpp ****                     bar_page_     = wave_page_[p] ? 1 : 0;
 239:chompi_main.cpp ****                     bar_until_    = System::GetNow() + 500;
 240:chompi_main.cpp ****                 }
 241:chompi_main.cpp ****             }
 242:chompi_main.cpp ****         }
 243:chompi_main.cpp ****         prev_enc_sw_[i] = down;
 244:chompi_main.cpp ****     }
 245:chompi_main.cpp **** 
 246:chompi_main.cpp ****     /* ENC_6_SW (volume-knob push, SwId 32): press toggles the volume
 247:chompi_main.cpp ****      * encoder between page 1 (master volume) and page 2 (overdrive);
 248:chompi_main.cpp ****      * show the newly active page's value bar as confirmation */
 249:chompi_main.cpp ****     {
 250:chompi_main.cpp ****         const int  vsw  = static_cast<int>(Hardware::SwId::ENC_6_SW);
 251:chompi_main.cpp ****         const bool down = hw.button_sr.State(vsw);
 252:chompi_main.cpp ****         if(down && !prev_key_[vsw])
 253:chompi_main.cpp ****         {
 254:chompi_main.cpp ****             vol_drive_page_ = !vol_drive_page_;
 255:chompi_main.cpp ****             bar_pipe_       = kVolBar;
 256:chompi_main.cpp ****             bar_page_       = vol_drive_page_ ? 1 : 0;
 257:chompi_main.cpp ****             bar_until_      = System::GetNow() + 500;
 258:chompi_main.cpp ****         }
 259:chompi_main.cpp ****         prev_key_[vsw] = down;
 260:chompi_main.cpp ****     }
 261:chompi_main.cpp **** 
 262:chompi_main.cpp ****     /* KEY_28 (LOOP) toggles the key latch. While latched, releasing a key
 263:chompi_main.cpp ****      * keeps its note sounding; unlatching releases every latched note whose
 264:chompi_main.cpp ****      * key is not physically held down again (those keep sounding and release
 265:chompi_main.cpp ****      * normally on key release). Applies to physical keys only, never MIDI. */
 266:chompi_main.cpp ****     {
 267:chompi_main.cpp ****         const int  loop_sw = static_cast<int>(Hardware::SwId::KEY_28);
 268:chompi_main.cpp ****         const bool down    = hw.button_sr.State(loop_sw);
 269:chompi_main.cpp ****         if(down && !prev_key_[loop_sw])
 270:chompi_main.cpp ****         {
 271:chompi_main.cpp ****             latch_on_ = !latch_on_;
 272:chompi_main.cpp ****             if(!latch_on_)
 273:chompi_main.cpp ****             {
 274:chompi_main.cpp ****                 for(int swid = 7; swid < 32; swid++)
 275:chompi_main.cpp ****                 {
 276:chompi_main.cpp ****                     if(latched_[swid] && active_note_[swid] != 0
 277:chompi_main.cpp ****                        && !hw.button_sr.State(swid))
ARM GAS  C:\msys64\tmp\ccE7R7AH.s 			page 176


 278:chompi_main.cpp ****                     {
 279:chompi_main.cpp ****                         const uint8_t note = active_note_[swid] - 1;
 280:chompi_main.cpp ****                         engine.NoteOff(note);
 281:chompi_main.cpp ****                         out_q.PushBack({1, note, 0});
 282:chompi_main.cpp ****                     }
 283:chompi_main.cpp ****                     latched_[swid] = false;
 284:chompi_main.cpp ****                 }
 285:chompi_main.cpp ****             }
 286:chompi_main.cpp ****         }
 287:chompi_main.cpp ****         prev_key_[loop_sw] = down;
 288:chompi_main.cpp ****     }
 289:chompi_main.cpp **** 
 290:chompi_main.cpp ****     /* playable keys: SwId 7..31 (SHIFT+KEY_16/KEY_17 = octave down/up) */
 291:chompi_main.cpp ****     for(int swid = 7; swid < 32; swid++)
 292:chompi_main.cpp ****     {
 293:chompi_main.cpp ****         const bool down = hw.button_sr.State(swid);
 294:chompi_main.cpp ****         if(down == prev_key_[swid])
 295:chompi_main.cpp ****             continue;
 296:chompi_main.cpp ****         prev_key_[swid] = down;
 297:chompi_main.cpp **** 
 298:chompi_main.cpp ****         const bool oct_key = (swid == static_cast<int>(Hardware::SwId::KEY_16))
 299:chompi_main.cpp ****                              || (swid == static_cast<int>(Hardware::SwId::KEY_17));
 300:chompi_main.cpp ****         if(down)
 301:chompi_main.cpp ****         {
 302:chompi_main.cpp ****             if(shift_held_ && oct_key)
 303:chompi_main.cpp ****             {
 304:chompi_main.cpp ****                 int oct = octave_
 305:chompi_main.cpp ****                           + (swid == static_cast<int>(Hardware::SwId::KEY_16)
 306:chompi_main.cpp ****                                  ? -1
 307:chompi_main.cpp ****                                  : 1);
 308:chompi_main.cpp ****                 octave_ = oct < -2 ? -2 : (oct > 2 ? 2 : oct);
 309:chompi_main.cpp ****                 continue;
 310:chompi_main.cpp ****             }
 311:chompi_main.cpp ****             int n = key_map[swid] + 12 * octave_;
 312:chompi_main.cpp ****             n              = n < 0 ? 0 : (n > 127 ? 127 : n);
 313:chompi_main.cpp ****             const uint8_t note = static_cast<uint8_t>(n);
 314:chompi_main.cpp ****             active_note_[swid] = note + 1;
 315:chompi_main.cpp ****             latched_[swid]     = false; /* re-press of a latched key retriggers */
 316:chompi_main.cpp ****             engine.NoteOn(note, 1.f);
 317:chompi_main.cpp ****             out_q.PushBack({0, note, 0});
 318:chompi_main.cpp ****         }
 319:chompi_main.cpp ****         else if(active_note_[swid] != 0)
 320:chompi_main.cpp ****         {
 321:chompi_main.cpp ****             /* note-off uses the note that was started (octave may have
 322:chompi_main.cpp ****              * changed, or shift may now be held, while the key was down) */
 323:chompi_main.cpp ****             if(latch_on_)
 324:chompi_main.cpp ****             {
 325:chompi_main.cpp ****                 /* latched: keep sounding; note-off is deferred to unlatch */
 326:chompi_main.cpp ****                 latched_[swid] = true;
 327:chompi_main.cpp ****             }
 328:chompi_main.cpp ****             else
 329:chompi_main.cpp ****             {
 330:chompi_main.cpp ****                 const uint8_t note   = active_note_[swid] - 1;
 331:chompi_main.cpp ****                 active_note_[swid]   = 0;
 332:chompi_main.cpp ****                 engine.NoteOff(note);
 333:chompi_main.cpp ****                 out_q.PushBack({1, note, 0});
 334:chompi_main.cpp ****             }
ARM GAS  C:\msys64\tmp\ccE7R7AH.s 			page 177


 335:chompi_main.cpp ****         }
 336:chompi_main.cpp ****     }
 337:chompi_main.cpp **** 
 338:chompi_main.cpp ****     /* encoders: enc_trackers accumulate clicks and reset to 0 on press */
 339:chompi_main.cpp ****     for(int i = 0; i < 6; i++)
 340:chompi_main.cpp ****     {
 341:chompi_main.cpp ****         if(hw.enc[i].RisingEdge())
 342:chompi_main.cpp ****             prev_enc_[i] = 0;
 343:chompi_main.cpp **** 
 344:chompi_main.cpp ****         const int delta = hw.enc_trackers[i] - prev_enc_[i];
 345:chompi_main.cpp ****         prev_enc_[i]    = hw.enc_trackers[i];
 346:chompi_main.cpp ****         if(delta == 0)
 347:chompi_main.cpp ****             continue;
 348:chompi_main.cpp **** 
 349:chompi_main.cpp ****         /* Chatter filter: the detent-less volume encoder can rest on a
 350:chompi_main.cpp ****          * quadrature transition and emit increment bursts at ~1 ms spacing,
