 199:../../../chompi-wave/code/libs/libDaisy/src/daisy_core.h ****  *  The dsy_gpio_pin struct should no longer be used, and is only available for
 200:../../../chompi-wave/code/libs/libDaisy/src/daisy_core.h ****  *  backwards compatability.
 201:../../../chompi-wave/code/libs/libDaisy/src/daisy_core.h ****  * 
 202:../../../chompi-wave/code/libs/libDaisy/src/daisy_core.h ****  *  Please use Pin struct instead.
 203:../../../chompi-wave/code/libs/libDaisy/src/daisy_core.h ****  */
 204:../../../chompi-wave/code/libs/libDaisy/src/daisy_core.h **** typedef struct
 205:../../../chompi-wave/code/libs/libDaisy/src/daisy_core.h **** {
 206:../../../chompi-wave/code/libs/libDaisy/src/daisy_core.h ****     dsy_gpio_port port; /**< & */
 207:../../../chompi-wave/code/libs/libDaisy/src/daisy_core.h ****     uint8_t       pin;  /**< number 0-15 */
 208:../../../chompi-wave/code/libs/libDaisy/src/daisy_core.h **** } dsy_gpio_pin;
 209:../../../chompi-wave/code/libs/libDaisy/src/daisy_core.h **** 
 210:../../../chompi-wave/code/libs/libDaisy/src/daisy_core.h **** /** Helper for creating pins from port/pin combos easily
 211:../../../chompi-wave/code/libs/libDaisy/src/daisy_core.h ****  * 
 212:../../../chompi-wave/code/libs/libDaisy/src/daisy_core.h ****  *  The dsy_gpio_pin struct should no longer be used, and is only available for
 213:../../../chompi-wave/code/libs/libDaisy/src/daisy_core.h ****  *  backwards compatability.
 214:../../../chompi-wave/code/libs/libDaisy/src/daisy_core.h ****  * 
 215:../../../chompi-wave/code/libs/libDaisy/src/daisy_core.h ****  *  Please use Pin struct instead.
 216:../../../chompi-wave/code/libs/libDaisy/src/daisy_core.h **** */
 217:../../../chompi-wave/code/libs/libDaisy/src/daisy_core.h **** FORCE_INLINE dsy_gpio_pin dsy_pin(dsy_gpio_port port, uint8_t pin)
 218:../../../chompi-wave/code/libs/libDaisy/src/daisy_core.h **** {
 219:../../../chompi-wave/code/libs/libDaisy/src/daisy_core.h ****     dsy_gpio_pin p;
 220:../../../chompi-wave/code/libs/libDaisy/src/daisy_core.h ****     p.port = port;
 221:../../../chompi-wave/code/libs/libDaisy/src/daisy_core.h ****     p.pin  = pin;
 222:../../../chompi-wave/code/libs/libDaisy/src/daisy_core.h ****     return p;
 223:../../../chompi-wave/code/libs/libDaisy/src/daisy_core.h **** }
 224:../../../chompi-wave/code/libs/libDaisy/src/daisy_core.h **** 
 225:../../../chompi-wave/code/libs/libDaisy/src/daisy_core.h **** /** Helper for testing sameness of two dsy_gpio_pins
 226:../../../chompi-wave/code/libs/libDaisy/src/daisy_core.h ****  *  \return    1 if same, 0 if different
 227:../../../chompi-wave/code/libs/libDaisy/src/daisy_core.h ****  * 
 228:../../../chompi-wave/code/libs/libDaisy/src/daisy_core.h ****  *  The dsy_gpio_pin struct should no longer be used, and is only available for
 229:../../../chompi-wave/code/libs/libDaisy/src/daisy_core.h ****  *  backwards compatability.
 230:../../../chompi-wave/code/libs/libDaisy/src/daisy_core.h ****  * 
 231:../../../chompi-wave/code/libs/libDaisy/src/daisy_core.h ****  *  Please use Pin struct instead.
 232:../../../chompi-wave/code/libs/libDaisy/src/daisy_core.h ****  */
 233:../../../chompi-wave/code/libs/libDaisy/src/daisy_core.h **** FORCE_INLINE uint8_t dsy_pin_cmp(dsy_gpio_pin *a, dsy_gpio_pin *b)
 234:../../../chompi-wave/code/libs/libDaisy/src/daisy_core.h **** {
 235:../../../chompi-wave/code/libs/libDaisy/src/daisy_core.h ****     return ((a->port == b->port) && (a->pin == b->pin));
 236:../../../chompi-wave/code/libs/libDaisy/src/daisy_core.h **** }
