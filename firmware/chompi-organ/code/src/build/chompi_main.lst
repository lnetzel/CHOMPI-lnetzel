 271:hardware.h    ****             {
 272:hardware.h    ****                 // 15 s amber warning before shutdown.
 273:hardware.h    ****                 // Deliberately BLOCKING (audio keeps running - it is interrupt-driven); flashes
 274:hardware.h    ****                 // all PTH LEDs at 250 ms, re-checks battery each cycle, aborts if power returns.
