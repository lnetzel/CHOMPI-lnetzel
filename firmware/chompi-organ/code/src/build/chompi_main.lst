 118:temp_led_stuff.h ****     /** buff expects that 8 elements are available for the one 8-bit color val*/
 119:temp_led_stuff.h ****     void populate_bits(uint8_t color_val, uint32_t *buff)
 120:temp_led_stuff.h ****     {
 121:temp_led_stuff.h ****         for (int i = 0; i < 8; i++)
 122:temp_led_stuff.h ****         {
 123:temp_led_stuff.h ****             buff[i] = (color_val & (1 << (7 - i))) > 0 ? kOneTime : kZeroTime;
 124:temp_led_stuff.h ****         }
 125:temp_led_stuff.h ****     }
 126:temp_led_stuff.h **** 
 127:temp_led_stuff.h ****     void populate_off(uint32_t *buff)
 128:temp_led_stuff.h ****     {
 129:temp_led_stuff.h ****         for (int i = 0; i < 8; i++)
 130:temp_led_stuff.h ****         {
 131:temp_led_stuff.h ****             buff[i + 8 * 0] = 0;
 132:temp_led_stuff.h ****             buff[i + 8 * 1] = 0;
 133:temp_led_stuff.h ****             buff[i + 8 * 2] = 0;
 134:temp_led_stuff.h ****         }
