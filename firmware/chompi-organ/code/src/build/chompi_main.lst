  43:../../../chompi-wave/code/libs/libDaisy/src/per/dac.h ****      ** DMA mode uses a buffer, and periodically transmits it triggering a 
  44:../../../chompi-wave/code/libs/libDaisy/src/per/dac.h ****      ** callback to fill the buffer when it is ready for more samples.
  45:../../../chompi-wave/code/libs/libDaisy/src/per/dac.h ****      ***/
  46:../../../chompi-wave/code/libs/libDaisy/src/per/dac.h ****     enum class Mode
