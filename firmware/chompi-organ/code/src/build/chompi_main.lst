  19:MidiHandler.h **** {
  20:MidiHandler.h ****   public:
  21:MidiHandler.h ****     static constexpr uint8_t kChannel     = 0; /* MIDI channel 1 */
  22:MidiHandler.h ****     static constexpr uint8_t kPipeCcBase  = 70;
  23:MidiHandler.h ****     static constexpr uint8_t kKeyVelocity = 100;
  24:MidiHandler.h **** 
  25:MidiHandler.h ****     void Init(chompi::OrganEngine *engine)
  26:MidiHandler.h ****     {
  27:MidiHandler.h ****         engine_ = engine;
  28:MidiHandler.h **** 
  29:MidiHandler.h ****         fifo_head = fifo_tail = 0;
  30:MidiHandler.h ****         uart_tx_busy          = false;
  31:MidiHandler.h **** 
  32:MidiHandler.h ****         MidiUartHandler::Config uart_midi_cfg;
  33:MidiHandler.h ****         uart_midi.Init(uart_midi_cfg);
  34:MidiHandler.h ****         uart_midi.StartReceive();
  35:MidiHandler.h **** 
  36:MidiHandler.h ****         MidiUartTransport transport = uart_midi.GetMutableTransport();
  37:MidiHandler.h ****         uart_handler_               = transport.GetUartHandle();
  38:MidiHandler.h **** 
  39:MidiHandler.h ****         MidiUsbHandler::Config usb_midi_cfg;
  40:MidiHandler.h ****         usb_midi_cfg.transport_config.periph = MidiUsbTransport::Config::EXTERNAL;
  41:MidiHandler.h ****         usb_midi.Init(usb_midi_cfg);
  42:MidiHandler.h ****         usb_midi.Listen();
  43:MidiHandler.h ****     }
  44:MidiHandler.h **** 
  45:MidiHandler.h ****     /** Call from the audio ISR: incoming notes/CCs become engine requests. */
  46:MidiHandler.h ****     void ProcessMidiIn()
  47:MidiHandler.h ****     {
  48:MidiHandler.h ****         MidiEvent event;
  49:MidiHandler.h ****         while(GetMidi(event))
  50:MidiHandler.h ****         {
  51:MidiHandler.h ****             if(event.channel != kChannel)
  52:MidiHandler.h ****                 continue;
  53:MidiHandler.h **** 
  54:MidiHandler.h ****             switch(event.type)
  55:MidiHandler.h ****             {
  56:MidiHandler.h ****                 case NoteOn:
  57:MidiHandler.h ****                     if(event.data[1] > 0)
  58:MidiHandler.h ****                         engine_->NoteOn(event.data[0],
  59:MidiHandler.h ****                                         static_cast<float>(event.data[1]) / 127.f);
  60:MidiHandler.h ****                     else
  61:MidiHandler.h ****                         engine_->NoteOff(event.data[0]); /* vel-0 = note off */
  62:MidiHandler.h ****                     break;
  63:MidiHandler.h ****                 case NoteOff:
  64:MidiHandler.h ****                     engine_->NoteOff(event.data[0]);
  65:MidiHandler.h ****                     break;
  66:MidiHandler.h ****                 case ControlChange:
  67:MidiHandler.h ****                 {
  68:MidiHandler.h ****                     const uint8_t cc  = event.data[0];
  69:MidiHandler.h ****                     const uint8_t val = event.data[1];
  70:MidiHandler.h ****                     if(cc >= kPipeCcBase && cc < kPipeCcBase + chompi::OrganEngine::kNumPipes)
ARM GAS  C:\msys64\tmp\cc9NRbLb.s 			page 60


  71:MidiHandler.h ****                     {
  72:MidiHandler.h ****                         /* 0-127 -> 0-32, rounded */
  73:MidiHandler.h ****                         const int step = (static_cast<int>(val)
  74:MidiHandler.h ****                                               * chompi::OrganEngine::kMaxSteps
  75:MidiHandler.h ****                                           + 63)
  76:MidiHandler.h ****                                          / 127;
  77:MidiHandler.h ****                         engine_->SetPipeStep(cc - kPipeCcBase, step);
  78:MidiHandler.h ****                         if(cc_level_callback_)
  79:MidiHandler.h ****                             cc_level_callback_(cc - kPipeCcBase);
  80:MidiHandler.h ****                     }
  81:MidiHandler.h ****                     break;
  82:MidiHandler.h ****                 }
  83:MidiHandler.h ****                 default: break;
  84:MidiHandler.h ****             }
  85:MidiHandler.h ****         }
  86:MidiHandler.h ****     }
  87:MidiHandler.h **** 
  88:MidiHandler.h ****     /** Call from the main loop: drains the UART DMA out queue. */
  89:MidiHandler.h ****     void ProcessMidiOut()
  90:MidiHandler.h ****     {
  91:MidiHandler.h ****         if(fifo_head != fifo_tail)
  92:MidiHandler.h ****         {
  93:MidiHandler.h ****             if(!uart_tx_busy)
  94:MidiHandler.h ****             {
  95:MidiHandler.h ****                 ScopedIrqBlocker block;
  96:MidiHandler.h ****                 DequeueDmaMessage();
  97:MidiHandler.h ****             }
  98:MidiHandler.h ****         }
  99:MidiHandler.h ****     }
 100:MidiHandler.h **** 
 101:MidiHandler.h ****     void SendNoteOn(uint8_t note)
 102:MidiHandler.h ****     {
 103:MidiHandler.h ****         uint8_t buf[3] = {static_cast<uint8_t>(0x90 | kChannel), note, kKeyVelocity};
 104:MidiHandler.h ****         QueueDmaMessage(buf, 3);
 105:MidiHandler.h ****         if(usb_midi_active_)
 106:MidiHandler.h ****             usb_midi.SendNoteOn(kChannel, note, kKeyVelocity);
 107:MidiHandler.h ****     }
 108:MidiHandler.h **** 
 109:MidiHandler.h ****     void SendNoteOff(uint8_t note)
 110:MidiHandler.h ****     {
 111:MidiHandler.h ****         uint8_t buf[3] = {static_cast<uint8_t>(0x80 | kChannel), note, 0};
 112:MidiHandler.h ****         QueueDmaMessage(buf, 3);
 113:MidiHandler.h ****         if(usb_midi_active_)
 114:MidiHandler.h ****             usb_midi.SendNoteOff(kChannel, note, 0);
 115:MidiHandler.h ****     }
 116:MidiHandler.h **** 
 117:MidiHandler.h ****     void SendPipeCC(int pipe, int step)
 118:MidiHandler.h ****     {
 119:MidiHandler.h ****         const uint8_t val = static_cast<uint8_t>(
 120:MidiHandler.h ****             (step * 127 + chompi::OrganEngine::kMaxSteps / 2)
 121:MidiHandler.h ****             / chompi::OrganEngine::kMaxSteps);
 122:MidiHandler.h ****         uint8_t buf[3] = {static_cast<uint8_t>(0xB0 | kChannel),
 123:MidiHandler.h ****                           static_cast<uint8_t>(kPipeCcBase + pipe),
 124:MidiHandler.h ****                           val};
 125:MidiHandler.h ****         QueueDmaMessage(buf, 3);
 126:MidiHandler.h ****         if(usb_midi_active_)
 127:MidiHandler.h ****             usb_midi.SendCC(kChannel, kPipeCcBase + pipe, val);
ARM GAS  C:\msys64\tmp\cc9NRbLb.s 			page 61


 128:MidiHandler.h ****     }
