 353:hardware.h    ****         void MpReadAll()
 354:hardware.h    ****         {
 355:hardware.h    ****             #if NO_BATT
 356:hardware.h    ****                 return;
 357:hardware.h    ****             #endif
 358:hardware.h    **** 
 359:hardware.h    ****             /* B6: never overlap a read that is still in flight - the
 360:hardware.h    ****              * TransmitBlocking below spins with no timeout while the I2C
