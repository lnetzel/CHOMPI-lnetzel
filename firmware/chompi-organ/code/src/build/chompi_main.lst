   1:OrganEngine.h **** /** @file OrganEngine.h
   2:OrganEngine.h ****  *  @brief Polyphonic organ voice engine: 6 voices x 4 sine pipe registrations.
   3:OrganEngine.h ****  *
   4:OrganEngine.h ****  *  Implements FR-1/FR-6 and DSP-1..DSP-3 of chompi-organ- specification.md:
   5:OrganEngine.h ****  *  - Pipe ratios 1x / 2x / 2^(19/12)x / 4x with 20 kHz octave foldback
   6:OrganEngine.h ****  *  - Free-running oscillators (phase never reset at note-on)
   7:OrganEngine.h ****  *  - Fixed 5 ms linear attack/release gate envelope; 5 ms steal fade
   8:OrganEngine.h ****  *  - Oldest-first voice stealing; same-note retrigger reuses its voice
   9:OrganEngine.h ****  *  - Fixed 1/24 output scale so 6 voices x 4 pipes cannot clip
  10:OrganEngine.h ****  *  - Pipe levels in 32 steps, gain = (step/32)^2, smoothed per sample
  11:OrganEngine.h ****  *  - Smoothed master gain (existing CHOMPI volume-knob behaviour)
  12:OrganEngine.h ****  */
  13:OrganEngine.h **** #pragma once
  14:OrganEngine.h **** #include "daisysp.h"
  15:OrganEngine.h **** 
  16:OrganEngine.h **** namespace chompi
  17:OrganEngine.h **** {
ARM GAS  C:\msys64\tmp\cc9NRbLb.s 			page 23


