 194              		.file 12 "OrganEngine.h"
   1:OrganEngine.h **** /** @file OrganEngine.h
   2:OrganEngine.h ****  *  @brief Polyphonic organ voice engine: 6 voices x 4 pipe registrations.
   3:OrganEngine.h ****  *
   4:OrganEngine.h ****  *  Implements FR-1/FR-6 and DSP-1..DSP-3 of chompi-organ- specification.md:
   5:OrganEngine.h ****  *  - Pipe ratios 1x / 2x / 2^(19/12)x / 4x with 20 kHz octave foldback
   6:OrganEngine.h ****  *  - Per-pipe Character: tonewheel-inspired harmonic coloration, 64
   7:OrganEngine.h ****  *    steps, one independent amount per pipe shared across all voices
   8:OrganEngine.h ****  *    (TonewheelCharacter.h). Step 0 is the exact clean sine; step 64 is
   9:OrganEngine.h ****  *    clearly aged but still organ-like. One sine oscillator per pipe;
  10:OrganEngine.h ****  *    the 2nd/3rd harmonics are derived algebraically from the sine
  11:OrganEngine.h ****  *    sample, smoothly eased in and anti-alias-masked per folded note.
  12:OrganEngine.h ****  *  - Free-running oscillators (phase never reset at note-on)
  13:OrganEngine.h ****  *  - Fixed 5 ms linear attack/release gate envelope; 5 ms steal fade
  14:OrganEngine.h ****  *  - Oldest-first voice stealing; same-note retrigger reuses its voice
  15:OrganEngine.h ****  *  - Fixed 1/24 output scale so 6 voices x 4 pipes cannot clip
  16:OrganEngine.h ****  *  - Pipe levels in 32 steps, gain = (step/32)^2, smoothed per sample
  17:OrganEngine.h ****  *  - Overdrive: 32-step overdrive-pedal stage on the mix (pre-gain into a
  18:OrganEngine.h ****  *    tanh soft clip with level-anchored post gain), placed before the
  19:OrganEngine.h ****  *    master gain so the drive character is level-independent; 0% is an
  20:OrganEngine.h ****  *    exact bypass (DSP-5)
  21:OrganEngine.h ****  *  - Rotary speaker: 60s Leslie-style mono->stereo stage after the
  22:OrganEngine.h ****  *    overdrive (800 Hz crossover, Doppler horn + AM drum, two virtual
  23:OrganEngine.h ****  *    mics 180 deg apart); 0% is an exact bypass (DSP-6)
  24:OrganEngine.h ****  *  - Smoothed master gain (existing CHOMPI volume-knob behaviour)
  25:OrganEngine.h ****  */
  26:OrganEngine.h **** #pragma once
  27:OrganEngine.h **** #include "daisysp.h"
  28:OrganEngine.h **** #include "RotarySpeaker.h"
  29:OrganEngine.h **** #include "TonewheelCharacter.h"
  30:OrganEngine.h **** 
  31:OrganEngine.h **** namespace chompi
  32:OrganEngine.h **** {
  33:OrganEngine.h **** 
  34:OrganEngine.h **** class OrganEngine
