 190:hardware.h    ****         enum BatteryLevel {
 191:hardware.h    ****             FULL, // on the charger, and hit the full state
 192:hardware.h    ****             HIGH, // > 3V3, not fully charged
 193:hardware.h    ****             MEDIUM, // < 3V3
 194:hardware.h    ****             LOW, // unused for now
 195:hardware.h    ****             LAST,
 196:hardware.h    ****         };
 197:hardware.h    **** 
 198:hardware.h    ****         BatteryLevel batt_level = MEDIUM;
 199:hardware.h    **** 
 200:hardware.h    ****         inline BatteryLevel GetBatteryLevel() { return batt_level; }
 201:hardware.h    **** 
 202:hardware.h    ****         /** Debounce registers for noisy MP2722. It tends to fluctuate a bit on the
 203:hardware.h    ****          *  thresholds between battery levels */
 204:hardware.h    ****         uint8_t batt_low_bounce = 0;
 205:hardware.h    ****         uint8_t vin_gd_bounce = 0xff;
 206:hardware.h    **** 
 207:hardware.h    ****         uint8_t legacy_cable_bounce = 0;
 208:hardware.h    ****         uint8_t iindpm_stat_bounce = 0;
 209:hardware.h    **** 
 210:hardware.h    ****         void BMCPerformCheck()
 211:hardware.h    ****         {
 212:hardware.h    ****             MpReadAll();
 213:hardware.h    ****         }
 214:hardware.h    **** 
 215:hardware.h    ****         /* Ported from TEMPO hardware.h: non-blocking battery check. Reads the battery IC without
 216:hardware.h    ****         blocking so MIDI and UI don't lag */
 217:hardware.h    ****         uint8_t batt_check_state = 0;
 218:hardware.h    ****         void BMCMediumBattCheck()
 219:hardware.h    ****         {
 220:hardware.h    ****             if(batt_level == BatteryLevel::FULL)
 221:hardware.h    ****                 return;
 222:hardware.h    **** 
 223:hardware.h    ****             uint32_t now = System::GetNow();
 224:hardware.h    ****             if (batt_check_state == 0 && now - batt_level_checkt > 30000) { // Check every 30s
 225:hardware.h    ****                 MpWrite(0x0c, 0B01011101); // set BATT_LOW to 3V3
 226:hardware.h    ****                 batt_level_checkt = now;
 227:hardware.h    ****                 batt_check_state = 1;
 228:hardware.h    ****             }
 229:hardware.h    ****             else if (batt_check_state == 1 && now - batt_level_checkt > 30) {
 230:hardware.h    ****                 MpReadAll();
 231:hardware.h    ****                 MpWrite(0x0c, 0B01010001); // set BATT_LOW to 3V
 232:hardware.h    ****                 batt_level_checkt = now;
 233:hardware.h    ****                 batt_check_state = 2;
 234:hardware.h    ****             }
