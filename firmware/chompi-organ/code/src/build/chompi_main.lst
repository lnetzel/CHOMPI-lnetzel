 115:MidiHandler.h ****     void SendNoteOn(uint8_t note)
 116:MidiHandler.h ****     {
 117:MidiHandler.h ****         uint8_t buf[3] = {static_cast<uint8_t>(0x90 | kChannel), note, kKeyVelocity};
