 130:MidiHandler.h ****     /** Optional hook so the UI can show the level bar on CC changes. */
 131:MidiHandler.h ****     void SetCcLevelCallback(void (*cb)(int pipe)) { cc_level_callback_ = cb; }
 132:MidiHandler.h **** 
 133:MidiHandler.h ****   private:
 134:MidiHandler.h ****     bool GetMidi(MidiEvent &event)
 135:MidiHandler.h ****     {
 136:MidiHandler.h ****         uart_midi.Listen();
 137:MidiHandler.h **** 
 138:MidiHandler.h ****         if(uart_midi.HasEvents())
 139:MidiHandler.h ****         {
 140:MidiHandler.h ****             event = uart_midi.PopEvent();
 141:MidiHandler.h ****             return true;
 142:MidiHandler.h ****         }
 143:MidiHandler.h ****         else if(usb_midi.HasEvents())
 144:MidiHandler.h ****         {
 145:MidiHandler.h ****             event = usb_midi.PopEvent();
 146:MidiHandler.h ****             return true;
 147:MidiHandler.h ****         }
 148:MidiHandler.h **** 
 149:MidiHandler.h ****         return false;
 150:MidiHandler.h ****     }
 151:MidiHandler.h **** 
 152:MidiHandler.h ****     /* DMA out queue, same pattern as chompi-wave's MidiManager */
 153:MidiHandler.h ****     void StartDmaTransfer()
 154:MidiHandler.h ****     {
 155:MidiHandler.h ****         uint8_t *p   = fifo[fifo_tail].data;
 156:MidiHandler.h ****         size_t   len = fifo[fifo_tail].length;
 157:MidiHandler.h **** 
 158:MidiHandler.h ****         uintptr_t start = (uintptr_t)p & ~(32 - 1);
 159:MidiHandler.h ****         uintptr_t end   = ((uintptr_t)p + len + 32 - 1) & ~(32 - 1);
 160:MidiHandler.h ****         SCB_CleanDCache_by_Addr((uint32_t *)start, end - start);
 161:MidiHandler.h **** 
 162:MidiHandler.h ****         uart_handler_.DmaTransmit(p, len, nullptr, TxEndCallback, this);
 163:MidiHandler.h ****     }
 164:MidiHandler.h **** 
 165:MidiHandler.h ****     void QueueDmaMessage(uint8_t *msg, size_t length)
 166:MidiHandler.h ****     {
 167:MidiHandler.h ****         fifo[fifo_head].length = length;
 168:MidiHandler.h ****         memcpy(fifo[fifo_head].data, msg, length);
 169:MidiHandler.h ****         fifo_head = (fifo_head + 1) % 64;
 170:MidiHandler.h **** 
 171:MidiHandler.h ****         if(!uart_tx_busy)
 172:MidiHandler.h ****         {
 173:MidiHandler.h ****             __disable_irq();
 174:MidiHandler.h ****             DequeueDmaMessage();
 175:MidiHandler.h ****             __enable_irq();
 176:MidiHandler.h ****         }
 177:MidiHandler.h ****     }
 178:MidiHandler.h **** 
 179:MidiHandler.h ****     void DequeueDmaMessage()
 180:MidiHandler.h ****     {
 181:MidiHandler.h ****         if(fifo_head == fifo_tail)
 182:MidiHandler.h ****         {
 183:MidiHandler.h ****             fifo_head = (fifo_head + 1) % 64;
 184:MidiHandler.h ****         }
ARM GAS  C:\msys64\tmp\cc9NRbLb.s 			page 62


 185:MidiHandler.h ****         if(!uart_tx_busy)
 186:MidiHandler.h ****         {
 187:MidiHandler.h ****             uart_tx_busy = true;
 188:MidiHandler.h ****             StartDmaTransfer();
 189:MidiHandler.h ****         }
 190:MidiHandler.h ****     }
