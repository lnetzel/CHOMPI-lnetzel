 204:OrganEngine.h ****                     continue;
 205:OrganEngine.h **** 
 206:OrganEngine.h ****                 float sig = 0.f;
 207:OrganEngine.h ****                 for(int p = 0; p < kNumPipes; p++)
 208:OrganEngine.h ****                     sig += voice.osc[p].Process() * pipe_gain_[p];
 209:OrganEngine.h **** 
