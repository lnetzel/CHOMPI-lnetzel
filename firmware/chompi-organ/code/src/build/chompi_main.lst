 124:MidiHandler.h ****     {
 125:MidiHandler.h ****         uint8_t buf[3] = {static_cast<uint8_t>(0x80 | kChannel), note, 0};
 126:MidiHandler.h ****         QueueDmaMessage(buf, 3);
 127:MidiHandler.h ****         if(usb_midi_active_)
 128:MidiHandler.h ****             usb_midi.SendNoteOff(kChannel, note, 0);
 129:MidiHandler.h ****     }
