   1:../../../chompi-wave/code/libs/libDaisy/src/per/sai.h **** #pragma once
   2:../../../chompi-wave/code/libs/libDaisy/src/per/sai.h **** #ifndef DSY_SAI_H
   3:../../../chompi-wave/code/libs/libDaisy/src/per/sai.h **** #define DSY_SAI_H
   4:../../../chompi-wave/code/libs/libDaisy/src/per/sai.h **** 
   5:../../../chompi-wave/code/libs/libDaisy/src/per/sai.h **** #include "daisy_core.h"
   6:../../../chompi-wave/code/libs/libDaisy/src/per/sai.h **** 
   7:../../../chompi-wave/code/libs/libDaisy/src/per/sai.h **** namespace daisy
   8:../../../chompi-wave/code/libs/libDaisy/src/per/sai.h **** {
   9:../../../chompi-wave/code/libs/libDaisy/src/per/sai.h **** /** 
  10:../../../chompi-wave/code/libs/libDaisy/src/per/sai.h ****  * Support for I2S Audio Protocol with different bit-depth, samplerate options
  11:../../../chompi-wave/code/libs/libDaisy/src/per/sai.h ****  * Allows for master or slave, as well as freedom of selecting direction, 
  12:../../../chompi-wave/code/libs/libDaisy/src/per/sai.h ****  * and other behavior for each peripheral, and block.
  13:../../../chompi-wave/code/libs/libDaisy/src/per/sai.h ****  * 
  14:../../../chompi-wave/code/libs/libDaisy/src/per/sai.h ****  * DMA Transfer commands must use buffers located within non-cached memory or use cache maintenance
  15:../../../chompi-wave/code/libs/libDaisy/src/per/sai.h ****  * To declare an unitialized global element in the DMA memory section:
  16:../../../chompi-wave/code/libs/libDaisy/src/per/sai.h ****  *    int32_t DSY_DMA_BUFFER_SECTOR my_buffer[96];
  17:../../../chompi-wave/code/libs/libDaisy/src/per/sai.h ****  *
  18:../../../chompi-wave/code/libs/libDaisy/src/per/sai.h ****  * Callback functions will be called once per half of the buffer. In the above example, 
  19:../../../chompi-wave/code/libs/libDaisy/src/per/sai.h ****  * the callback function would be called once for every 48 samples.
  20:../../../chompi-wave/code/libs/libDaisy/src/per/sai.h ****  * 
  21:../../../chompi-wave/code/libs/libDaisy/src/per/sai.h ****  * Use SAI Handle like this:
  22:../../../chompi-wave/code/libs/libDaisy/src/per/sai.h ****  * 
  23:../../../chompi-wave/code/libs/libDaisy/src/per/sai.h ****  *  SaiHandle::Config sai_config;
  24:../../../chompi-wave/code/libs/libDaisy/src/per/sai.h ****  *  sai_config.periph          = SaiHandle::Config::Peripheral::SAI_1;
  25:../../../chompi-wave/code/libs/libDaisy/src/per/sai.h ****  *  sai_config.sr              = SaiHandle::Config::SampleRate::SAI_48KHZ;
  26:../../../chompi-wave/code/libs/libDaisy/src/per/sai.h ****  *  sai_config.bit_depth       = SaiHandle::Config::BitDepth::SAI_24BIT;
  27:../../../chompi-wave/code/libs/libDaisy/src/per/sai.h ****  *  sai_config.a_sync          = SaiHandle::Config::Sync::MASTER;
  28:../../../chompi-wave/code/libs/libDaisy/src/per/sai.h ****  *  sai_config.b_sync          = SaiHandle::Config::Sync::SLAVE;
  29:../../../chompi-wave/code/libs/libDaisy/src/per/sai.h ****  *  sai_config.a_dir           = SaiHandle::Config::Direction::RECEIVE;
  30:../../../chompi-wave/code/libs/libDaisy/src/per/sai.h ****  *  sai_config.b_dir           = SaiHandle::Config::Direction::TRANSMIT;
  31:../../../chompi-wave/code/libs/libDaisy/src/per/sai.h ****  *  sai_config.pin_config.fs   = {DSY_GPIOE, 4};
  32:../../../chompi-wave/code/libs/libDaisy/src/per/sai.h ****  *  sai_config.pin_config.mclk = {DSY_GPIOE, 2};
  33:../../../chompi-wave/code/libs/libDaisy/src/per/sai.h ****  *  sai_config.pin_config.sck  = {DSY_GPIOE, 5};
  34:../../../chompi-wave/code/libs/libDaisy/src/per/sai.h ****  *  sai_config.pin_config.sa   = {DSY_GPIOE, 6};
  35:../../../chompi-wave/code/libs/libDaisy/src/per/sai.h ****  *  sai_config.pin_config.sb   = {DSY_GPIOE, 3};
  36:../../../chompi-wave/code/libs/libDaisy/src/per/sai.h ****  *  // Then Initialize
  37:../../../chompi-wave/code/libs/libDaisy/src/per/sai.h ****  *  SaiHandle sai;
  38:../../../chompi-wave/code/libs/libDaisy/src/per/sai.h ****  *  sai.Init(sai_config);
  39:../../../chompi-wave/code/libs/libDaisy/src/per/sai.h ****  *  // Now you can use it:
  40:../../../chompi-wave/code/libs/libDaisy/src/per/sai.h ****  *  sai.StartDma(. . .);
  41:../../../chompi-wave/code/libs/libDaisy/src/per/sai.h ****  */
  42:../../../chompi-wave/code/libs/libDaisy/src/per/sai.h **** class SaiHandle
