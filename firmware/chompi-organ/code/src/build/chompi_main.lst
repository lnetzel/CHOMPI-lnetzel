 264:hardware.h    ****         void LowBatteryLockoutCheck()
 265:hardware.h    ****         {
 266:hardware.h    ****             #if NO_BATT
 267:hardware.h    ****                 return;
 268:hardware.h    ****             #endif 
 269:hardware.h    **** 
 270:hardware.h    ****             BMCPerformCheck();
 271:hardware.h    **** 
 272:hardware.h    ****             if(batt_low_bounce == 0xff && vin_gd_bounce == 0x00) // unplugged and low battery
 273:hardware.h    ****             {
 274:hardware.h    ****                 // 15 s amber warning before shutdown.
 275:hardware.h    ****                 // Deliberately BLOCKING (audio keeps running - it is interrupt-driven); flashes
 276:hardware.h    ****                 // all PTH LEDs at 250 ms, re-checks battery each cycle, aborts if power returns.
 277:hardware.h    ****                 uint32_t shutdown_time_ = System::GetNow();
 278:hardware.h    ****                 uint32_t last_update = shutdown_time_;
 279:hardware.h    **** 
 280:hardware.h    ****                 while(System::GetNow() - shutdown_time_ < 15000)
 281:hardware.h    ****                 {
 282:hardware.h    ****                     uint32_t now = System::GetNow();
 283:hardware.h    ****                     if(now - last_update >= 250)
 284:hardware.h    ****                     {
 285:hardware.h    ****                         last_update = now;
 286:hardware.h    **** 
 287:hardware.h    ****                         BMCPerformCheck(); // re-check battery status
 288:hardware.h    **** 
 289:hardware.h    ****                         if(!(batt_low_bounce == 0xff && vin_gd_bounce == 0x00))
 290:hardware.h    ****                             return; // break out early if battery status changed
 291:hardware.h    **** 
 292:hardware.h    ****                         bool led_on = (now / 250) % 2 == 0;
 293:hardware.h    ****                         for(size_t i = 0; i < kNumPthLeds; ++i)
 294:hardware.h    ****                         {
 295:hardware.h    ****                             if(led_on)
 296:hardware.h    ****                                 SetPthLedFloat(i, 1.f, .95f, .05f);
 297:hardware.h    ****                             else
 298:hardware.h    ****                                 SetPthLedFloat(i, 0.f, 0.f, 0.f);
 299:hardware.h    ****                         }
 300:hardware.h    **** 
 301:hardware.h    ****                         fill_led_data();
 302:hardware.h    ****                     }
 303:hardware.h    ****                 }
 304:hardware.h    **** 
 305:hardware.h    ****                 MpWrite(0x08, 0B10111111); // SHIPPING MODE
 306:hardware.h    ****             }
 307:hardware.h    ****             
 308:hardware.h    ****             // plugged into low current source with low batt
 309:hardware.h    ****             while(batt_low_bounce == 0xff && (legacy_cable_bounce == 0xff || iindpm_stat_bounce == 
 310:hardware.h    ****             {
 311:hardware.h    ****                 LedsOff();
 312:hardware.h    ****                 System::Delay(100);
 313:hardware.h    ****                 HAL_PWR_EnterSTOPMode(PWR_LOWPOWERREGULATOR_ON , PWR_STOPENTRY_WFI);
 314:hardware.h    ****             }
 315:hardware.h    **** 
 316:hardware.h    ****             // check for medium state every 30 seconds (gate lives inside BMCMediumBattCheck now)
 317:hardware.h    ****             BMCMediumBattCheck();
 318:hardware.h    ****         }
