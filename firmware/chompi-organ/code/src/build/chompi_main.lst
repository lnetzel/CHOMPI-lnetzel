  44:../../../chompi-wave/code/libs/libDaisy/src/dev/sr_4021.h ****         dsy_gpio_pin latch; /**< Latch pin to attach to pin 9 of device(s) */
  45:../../../chompi-wave/code/libs/libDaisy/src/dev/sr_4021.h ****         dsy_gpio_pin data[num_parallel]; /**< Data Pin(s) */
  46:../../../chompi-wave/code/libs/libDaisy/src/dev/sr_4021.h ****         int dbc_size;
  47:../../../chompi-wave/code/libs/libDaisy/src/dev/sr_4021.h ****     };
