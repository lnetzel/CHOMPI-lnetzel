 169:OrganEngine.h ****     void NoteOn(uint8_t note, float velocity)
 170:OrganEngine.h ****     {
 171:OrganEngine.h ****         note_held_[note & 0x7f] = true;
 172:OrganEngine.h **** 
 173:OrganEngine.h ****         /* Retrigger: reuse a voice already playing/releasing this note */
 174:OrganEngine.h ****         for(int v = 0; v < kNumVoices; v++)
 175:OrganEngine.h ****         {
 176:OrganEngine.h ****             Voice &voice = voices_[v];
 177:OrganEngine.h ****             if((voice.state == ATTACK || voice.state == SUSTAIN
 178:OrganEngine.h ****                 || voice.state == RELEASE)
ARM GAS  C:\msys64\tmp\ccDg23TE.s 			page 183


 179:OrganEngine.h ****                && voice.note == note)
 180:OrganEngine.h ****             {
 181:OrganEngine.h ****                 StartVoice(voice, note, velocity);
 182:OrganEngine.h ****                 return;
 183:OrganEngine.h ****             }
 184:OrganEngine.h ****         }
 185:OrganEngine.h **** 
 186:OrganEngine.h ****         /* Free voice */
 187:OrganEngine.h ****         for(int v = 0; v < kNumVoices; v++)
 188:OrganEngine.h ****         {
 189:OrganEngine.h ****             if(voices_[v].state == IDLE)
 190:OrganEngine.h ****             {
 191:OrganEngine.h ****                 StartVoice(voices_[v], note, velocity);
 192:OrganEngine.h ****                 return;
 193:OrganEngine.h ****             }
 194:OrganEngine.h ****         }
 195:OrganEngine.h **** 
 196:OrganEngine.h ****         /* Steal the oldest voice (5 ms fade, then the new note starts) */
 197:OrganEngine.h ****         int oldest = 0;
 198:OrganEngine.h ****         for(int v = 1; v < kNumVoices; v++)
 199:OrganEngine.h ****         {
 200:OrganEngine.h ****             if(voices_[v].age < voices_[oldest].age)
 201:OrganEngine.h ****                 oldest = v;
 202:OrganEngine.h ****         }
 203:OrganEngine.h ****         Voice &voice      = voices_[oldest];
 204:OrganEngine.h ****         voice.pending_note = note;
 205:OrganEngine.h ****         voice.pending_vel  = velocity;
 206:OrganEngine.h ****         voice.state        = STEAL;
 207:OrganEngine.h ****     }
 208:OrganEngine.h **** 
 209:OrganEngine.h ****     void NoteOff(uint8_t note)
 210:OrganEngine.h ****     {
 211:OrganEngine.h ****         note &= 0x7f;
 212:OrganEngine.h ****         note_held_[note] = false;
 213:OrganEngine.h **** 
 214:OrganEngine.h ****         for(int v = 0; v < kNumVoices; v++)
 215:OrganEngine.h ****         {
 216:OrganEngine.h ****             Voice &voice = voices_[v];
 217:OrganEngine.h ****             if((voice.state == ATTACK || voice.state == SUSTAIN)
 218:OrganEngine.h ****                && voice.note == note)
 219:OrganEngine.h ****             {
 220:OrganEngine.h ****                 voice.state = RELEASE;
 221:OrganEngine.h ****             }
 222:OrganEngine.h ****             else if(voice.state == STEAL && voice.pending_note == note)
 223:OrganEngine.h ****             {
 224:OrganEngine.h ****                 /* stolen voice's pending note was cancelled: just fade out */
 225:OrganEngine.h ****                 voice.state = RELEASE;
 226:OrganEngine.h ****             }
 227:OrganEngine.h ****         }
 228:OrganEngine.h ****     }
