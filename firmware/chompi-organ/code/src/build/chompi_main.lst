 373:OrganEngine.h ****             /* Overdrive (DSP-5): overdrive-pedal style — quadratic-mapped
 374:OrganEngine.h ****              * pre-gain (1..64x) into a tanh soft clipper, fully wet (no dry
 375:OrganEngine.h ****              * blend, so harmonics are always audible above 0%). Post gain
 376:OrganEngine.h ****              * anchors a 1/3-full-scale input to the same output level, so
 377:OrganEngine.h ****              * turning the knob up adds crunch/compression instead of just
 378:OrganEngine.h ****              * loudness; step 0 is an exact bypass. Runs before the master
 379:OrganEngine.h ****              * gain so the drive character does not depend on the listening
 380:OrganEngine.h ****              * level. */
 381:OrganEngine.h ****             float out_sig = mix * kMixScale;
 382:OrganEngine.h ****             if(drive_ > 0.f)
 383:OrganEngine.h ****             {
 384:OrganEngine.h ****                 /* B4: drive_g_/drive_post_ come from Prepare() (per block) */
 385:OrganEngine.h ****                 out_sig = tanhf(drive_g_ * out_sig) * drive_post_;
 386:OrganEngine.h ****             }
 387:OrganEngine.h ****             /* Rotary speaker (DSP-6): mono mix -> stereo Leslie, placed
 388:OrganEngine.h ****              * after the overdrive (the drive is the preamp, the Leslie is
 389:OrganEngine.h ****              * the speaker cabinet) and before the master gain so the
 390:OrganEngine.h ****              * volume knob keeps scaling both channels equally. Step 0 is
 391:OrganEngine.h ****              * an exact bypass (both channels = out_sig). */
 392:OrganEngine.h ****             float out_l, out_r;
 393:OrganEngine.h ****             rotary_.Process(out_sig, out_l, out_r);
 394:OrganEngine.h ****             out_l *= master_gain_;
 395:OrganEngine.h ****             out_r *= master_gain_;
 396:OrganEngine.h ****             out[0][i] = out_l; /* headphone L */
 397:OrganEngine.h ****             out[1][i] = out_r; /* headphone R */
 398:OrganEngine.h ****             out[2][i] = out_l; /* master L */
 399:OrganEngine.h ****             out[3][i] = out_r; /* master R */
 400:OrganEngine.h ****         }
 401:OrganEngine.h ****     }
