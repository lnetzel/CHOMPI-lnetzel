   1:../../../chompi-wave/code/libs/libDaisy/src/per/dac.h **** #pragma once
   2:../../../chompi-wave/code/libs/libDaisy/src/per/dac.h **** #ifndef DSY_DAC_H
   3:../../../chompi-wave/code/libs/libDaisy/src/per/dac.h **** #define DSY_DAC_H
   4:../../../chompi-wave/code/libs/libDaisy/src/per/dac.h **** 
   5:../../../chompi-wave/code/libs/libDaisy/src/per/dac.h **** #include "daisy_core.h"
   6:../../../chompi-wave/code/libs/libDaisy/src/per/dac.h **** 
   7:../../../chompi-wave/code/libs/libDaisy/src/per/dac.h **** namespace daisy
   8:../../../chompi-wave/code/libs/libDaisy/src/per/dac.h **** {
   9:../../../chompi-wave/code/libs/libDaisy/src/per/dac.h **** /** @brief DAC handle for Built-in DAC Peripheral 
  10:../../../chompi-wave/code/libs/libDaisy/src/per/dac.h ****  *  @ingroup per_analog
  11:../../../chompi-wave/code/libs/libDaisy/src/per/dac.h ****  ** 
  12:../../../chompi-wave/code/libs/libDaisy/src/per/dac.h ****  ** For now only Normal Mode is supported,
  13:../../../chompi-wave/code/libs/libDaisy/src/per/dac.h ****  ** Sample and hold mode provides reduced power consumption, but requires a bit more setup.
  14:../../../chompi-wave/code/libs/libDaisy/src/per/dac.h ****  **
  15:../../../chompi-wave/code/libs/libDaisy/src/per/dac.h ****  ** For now connecting the DAC through other internal peripherals is also not supported.
  16:../../../chompi-wave/code/libs/libDaisy/src/per/dac.h ****  **
  17:../../../chompi-wave/code/libs/libDaisy/src/per/dac.h ****  ** Since the DAC channels have dedicated pins we don't need to pass in a pin config like with
  18:../../../chompi-wave/code/libs/libDaisy/src/per/dac.h ****  ** other modules. However, it is still important to not try to use the DAC pins for anything else.
  19:../../../chompi-wave/code/libs/libDaisy/src/per/dac.h ****  ** DAC Channel 1 is on PA4, and DAC Channel 2 is on PA5
  20:../../../chompi-wave/code/libs/libDaisy/src/per/dac.h ****  ***/
  21:../../../chompi-wave/code/libs/libDaisy/src/per/dac.h **** class DacHandle
  22:../../../chompi-wave/code/libs/libDaisy/src/per/dac.h **** {
  23:../../../chompi-wave/code/libs/libDaisy/src/per/dac.h ****   public:
  24:../../../chompi-wave/code/libs/libDaisy/src/per/dac.h ****     /** Return Values for the DacHandle class */
  25:../../../chompi-wave/code/libs/libDaisy/src/per/dac.h ****     enum class Result
  26:../../../chompi-wave/code/libs/libDaisy/src/per/dac.h ****     {
  27:../../../chompi-wave/code/libs/libDaisy/src/per/dac.h ****         OK,
  28:../../../chompi-wave/code/libs/libDaisy/src/per/dac.h ****         ERR,
  29:../../../chompi-wave/code/libs/libDaisy/src/per/dac.h ****     };
  30:../../../chompi-wave/code/libs/libDaisy/src/per/dac.h **** 
  31:../../../chompi-wave/code/libs/libDaisy/src/per/dac.h ****     /** Selects which channel(s) will be configured for use. */
  32:../../../chompi-wave/code/libs/libDaisy/src/per/dac.h ****     enum class Channel
  33:../../../chompi-wave/code/libs/libDaisy/src/per/dac.h ****     {
  34:../../../chompi-wave/code/libs/libDaisy/src/per/dac.h ****         ONE,
  35:../../../chompi-wave/code/libs/libDaisy/src/per/dac.h ****         TWO,
