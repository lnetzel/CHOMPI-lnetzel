  17:../../../chompi-wave/code/libs/libDaisy/src/per/i2c.h ****  *      i2c_conf.pin_config.sda  = {DSY_GPIOB, 9};
  18:../../../chompi-wave/code/libs/libDaisy/src/per/i2c.h ****  *      // initialise the peripheral
  19:../../../chompi-wave/code/libs/libDaisy/src/per/i2c.h ****  *      I2CHandle i2c;
  20:../../../chompi-wave/code/libs/libDaisy/src/per/i2c.h ****  *      i2c.Init(i2c_conf);
  21:../../../chompi-wave/code/libs/libDaisy/src/per/i2c.h ****  *      // now i2c points to the corresponding peripheral and can be used.
  22:../../../chompi-wave/code/libs/libDaisy/src/per/i2c.h ****  *      i2c.TransmitBlocking( ... );
  23:../../../chompi-wave/code/libs/libDaisy/src/per/i2c.h ****  */
