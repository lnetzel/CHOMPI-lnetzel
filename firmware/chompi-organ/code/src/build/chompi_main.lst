 250:OrganEngine.h ****     void NoteOff(uint8_t note)
 251:OrganEngine.h ****     {
 252:OrganEngine.h ****         note &= 0x7f;
 253:OrganEngine.h ****         note_held_[note] = false;
 254:OrganEngine.h **** 
 255:OrganEngine.h ****         for(int v = 0; v < kNumVoices; v++)
 256:OrganEngine.h ****         {
 257:OrganEngine.h ****             Voice &voice = voices_[v];
 258:OrganEngine.h ****             if((voice.state == ATTACK || voice.state == SUSTAIN)
 259:OrganEngine.h ****                && voice.note == note)
 260:OrganEngine.h ****             {
 261:OrganEngine.h ****                 voice.state = RELEASE;
 262:OrganEngine.h ****             }
 263:OrganEngine.h ****             else if(voice.state == STEAL && voice.pending_note == note)
 264:OrganEngine.h ****             {
 265:OrganEngine.h ****                 /* stolen voice's pending note was cancelled: just fade out */
 266:OrganEngine.h ****                 voice.state = RELEASE;
 267:OrganEngine.h ****             }
 268:OrganEngine.h ****         }
