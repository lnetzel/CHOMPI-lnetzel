 169:chompi_main.cpp **** /** Key + encoder polling, called from the audio ISR once per block (2 kHz). */
 170:chompi_main.cpp **** static void PollControls()
 171:chompi_main.cpp **** {
 172:chompi_main.cpp ****     /* shift key (CHOMPI key) */
 173:chompi_main.cpp ****     shift_held_ = hw.button_sr.State(static_cast<int>(Hardware::SwId::KEY_26));
 174:chompi_main.cpp **** 
 175:chompi_main.cpp ****     /* playable keys: SwId 7..31 (SHIFT+KEY_16/KEY_17 = octave down/up) */
 176:chompi_main.cpp ****     for(int swid = 7; swid < 32; swid++)
 177:chompi_main.cpp ****     {
 178:chompi_main.cpp ****         const bool down = hw.button_sr.State(swid);
 179:chompi_main.cpp ****         if(down == prev_key_[swid])
 180:chompi_main.cpp ****             continue;
 181:chompi_main.cpp ****         prev_key_[swid] = down;
 182:chompi_main.cpp **** 
 183:chompi_main.cpp ****         const bool oct_key = (swid == static_cast<int>(Hardware::SwId::KEY_16))
 184:chompi_main.cpp ****                              || (swid == static_cast<int>(Hardware::SwId::KEY_17));
 185:chompi_main.cpp ****         if(down)
 186:chompi_main.cpp ****         {
 187:chompi_main.cpp ****             if(shift_held_ && oct_key)
 188:chompi_main.cpp ****             {
 189:chompi_main.cpp ****                 int oct = octave_
 190:chompi_main.cpp ****                           + (swid == static_cast<int>(Hardware::SwId::KEY_16)
 191:chompi_main.cpp ****                                  ? -1
 192:chompi_main.cpp ****                                  : 1);
 193:chompi_main.cpp ****                 octave_ = oct < -2 ? -2 : (oct > 2 ? 2 : oct);
 194:chompi_main.cpp ****                 continue;
 195:chompi_main.cpp ****             }
 196:chompi_main.cpp ****             int n = key_map[swid] + 12 * octave_;
 197:chompi_main.cpp ****             n              = n < 0 ? 0 : (n > 127 ? 127 : n);
 198:chompi_main.cpp ****             const uint8_t note = static_cast<uint8_t>(n);
 199:chompi_main.cpp ****             active_note_[swid] = note + 1;
 200:chompi_main.cpp ****             engine.NoteOn(note, 1.f);
 201:chompi_main.cpp ****             out_q.PushBack({0, note, 0});
 202:chompi_main.cpp ****         }
 203:chompi_main.cpp ****         else if(active_note_[swid] != 0)
 204:chompi_main.cpp ****         {
 205:chompi_main.cpp ****             /* note-off uses the note that was started (octave may have
 206:chompi_main.cpp ****              * changed, or shift may now be held, while the key was down) */
 207:chompi_main.cpp ****             const uint8_t note   = active_note_[swid] - 1;
 208:chompi_main.cpp ****             active_note_[swid]   = 0;
 209:chompi_main.cpp ****             engine.NoteOff(note);
 210:chompi_main.cpp ****             out_q.PushBack({1, note, 0});
 211:chompi_main.cpp ****         }
 212:chompi_main.cpp ****     }
 213:chompi_main.cpp **** 
 214:chompi_main.cpp ****     /* encoders: enc_trackers accumulate clicks and reset to 0 on press */
 215:chompi_main.cpp ****     for(int i = 0; i < 6; i++)
 216:chompi_main.cpp ****     {
 217:chompi_main.cpp ****         if(hw.enc[i].RisingEdge())
 218:chompi_main.cpp ****             prev_enc_[i] = 0;
 219:chompi_main.cpp **** 
 220:chompi_main.cpp ****         const int delta = hw.enc_trackers[i] - prev_enc_[i];
 221:chompi_main.cpp ****         prev_enc_[i]    = hw.enc_trackers[i];
 222:chompi_main.cpp ****         if(delta == 0)
 223:chompi_main.cpp ****             continue;
 224:chompi_main.cpp **** 
 225:chompi_main.cpp ****         /* Chatter filter: the detent-less volume encoder can rest on a
ARM GAS  C:\msys64\tmp\cc9NRbLb.s 			page 176


 226:chompi_main.cpp ****          * quadrature transition and emit increment bursts at ~1 ms spacing,
 227:chompi_main.cpp ****          * which would re-arm the level bar forever. Accept at most one click
 228:chompi_main.cpp ****          * per 8 ms per encoder (fast hand turns are >10 ms per detent). */
 229:chompi_main.cpp ****         const uint32_t now_ms = System::GetNow();
 230:chompi_main.cpp ****         if(now_ms - last_click_t_[i] < 8)
 231:chompi_main.cpp ****             continue; /* dropped for good: prev_enc_ already synced */
 232:chompi_main.cpp ****         last_click_t_[i] = now_ms;
 233:chompi_main.cpp **** 
 234:chompi_main.cpp ****         if(i == kVolEnc)
 235:chompi_main.cpp ****         {
 236:chompi_main.cpp ****             if(shift_held_)
 237:chompi_main.cpp ****             {
 238:chompi_main.cpp ****                 engine.AddFineTuneCents(delta); /* SHIFT+ENC_6: fine tune */
 239:chompi_main.cpp ****             }
 240:chompi_main.cpp ****             else
 241:chompi_main.cpp ****             {
 242:chompi_main.cpp ****                 /* existing CHOMPI volume-knob behaviour: 100 clicks, 0..1 */
 243:chompi_main.cpp ****                 float g = engine.GetMasterGain() + delta * .01f;
 244:chompi_main.cpp ****                 engine.SetMasterGain(g);
 245:chompi_main.cpp ****                 bar_pipe_  = kVolBar;
 246:chompi_main.cpp ****                 bar_until_ = System::GetNow() + 500;
 247:chompi_main.cpp ****             }
 248:chompi_main.cpp ****         }
 249:chompi_main.cpp ****         else if(i != 4) /* enc[4] (transport wheel, ENC_5) has no function */
 250:chompi_main.cpp ****         {
 251:chompi_main.cpp ****             for(int p = 0; p < OrganEngine::kNumPipes; p++)
 252:chompi_main.cpp ****             {
 253:chompi_main.cpp ****                 if(pipe_encoder[p] != i)
 254:chompi_main.cpp ****                     continue;
