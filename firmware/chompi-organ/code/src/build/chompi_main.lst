 109:hardware.h    ****              *  channel breakdown comment above AudioCallback in chompi_main.cpp) driven
 110:hardware.h    ****              *  off two SAI peripherals in sync: the Seed's own built-in SAI1 codec
 111:hardware.h    ****              *  plus this second external one on SAI2. */
 112:hardware.h    ****             SaiHandle::Config external_sai_cfg;
 113:hardware.h    ****             external_sai_cfg.periph = SaiHandle::Config::Peripheral::SAI_2;
