 143:MidiHandler.h ****   private:
 144:MidiHandler.h ****     void SendStepCC(int cc, int step)
 145:MidiHandler.h ****     {
 146:MidiHandler.h ****         const uint8_t val = static_cast<uint8_t>(
 147:MidiHandler.h ****             (step * 127 + chompi::OrganEngine::kMaxSteps / 2)
 148:MidiHandler.h ****             / chompi::OrganEngine::kMaxSteps);
 149:MidiHandler.h ****         uint8_t buf[3] = {static_cast<uint8_t>(0xB0 | kChannel),
 150:MidiHandler.h ****                           static_cast<uint8_t>(cc),
 151:MidiHandler.h ****                           val};
 152:MidiHandler.h ****         QueueDmaMessage(buf, 3);
 153:MidiHandler.h ****         if(usb_midi_active_)
 154:MidiHandler.h ****             usb_midi.SendCC(kChannel, cc, val);
 155:MidiHandler.h ****     }
 156:MidiHandler.h **** 
 157:MidiHandler.h ****     bool GetMidi(MidiEvent &event)
 158:MidiHandler.h ****     {
 159:MidiHandler.h ****         uart_midi.Listen();
 160:MidiHandler.h **** 
 161:MidiHandler.h ****         if(uart_midi.HasEvents())
 162:MidiHandler.h ****         {
 163:MidiHandler.h ****             event = uart_midi.PopEvent();
 164:MidiHandler.h ****             return true;
 165:MidiHandler.h ****         }
 166:MidiHandler.h ****         else if(usb_midi.HasEvents())
 167:MidiHandler.h ****         {
 168:MidiHandler.h ****             event = usb_midi.PopEvent();
 169:MidiHandler.h ****             return true;
 170:MidiHandler.h ****         }
 171:MidiHandler.h **** 
 172:MidiHandler.h ****         return false;
 173:MidiHandler.h ****     }
