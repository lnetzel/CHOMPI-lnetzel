  65:../../../chompi-wave/code/libs/libDaisy/src/per/sdmmc.h ****         bool
  66:../../../chompi-wave/code/libs/libDaisy/src/per/sdmmc.h ****             clock_powersave; /**< When true, the clock will stop between transfers to save power. *
  67:../../../chompi-wave/code/libs/libDaisy/src/per/sdmmc.h **** 
  68:../../../chompi-wave/code/libs/libDaisy/src/per/sdmmc.h ****         /** Configures settings to their default settings */
  69:../../../chompi-wave/code/libs/libDaisy/src/per/sdmmc.h ****         void Defaults()
  70:../../../chompi-wave/code/libs/libDaisy/src/per/sdmmc.h ****         {
