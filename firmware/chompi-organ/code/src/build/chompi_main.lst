 115:hardware.h    ****             external_sai_cfg.bit_depth = SaiHandle::Config::BitDepth::SAI_24BIT;
 116:hardware.h    ****             external_sai_cfg.a_sync = SaiHandle::Config::Sync::SLAVE;
 117:hardware.h    ****             external_sai_cfg.b_sync = SaiHandle::Config::Sync::MASTER;
 118:hardware.h    ****             external_sai_cfg.a_dir = SaiHandle::Config::Direction::TRANSMIT;
 119:hardware.h    ****             external_sai_cfg.b_dir = SaiHandle::Config::Direction::RECEIVE;
 120:hardware.h    ****             external_sai_cfg.pin_config.fs = seed::D27;
