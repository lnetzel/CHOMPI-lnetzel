 189:OrganEngine.h ****                 || voice.state == RELEASE)
 190:OrganEngine.h ****                && voice.note == note)
 191:OrganEngine.h ****             {
 192:OrganEngine.h ****                 StartVoice(v, note, velocity);
 193:OrganEngine.h ****                 return;
 194:OrganEngine.h ****             }
 195:OrganEngine.h ****             if(voice.state == STEAL && voice.pending_note == note)
 196:OrganEngine.h ****             {
 197:OrganEngine.h ****                 voice.pending_vel = velocity;
 198:OrganEngine.h ****                 return;
 199:OrganEngine.h ****             }
 200:OrganEngine.h ****         }
 201:OrganEngine.h **** 
 202:OrganEngine.h ****         /* Free voice */
 203:OrganEngine.h ****         for(int v = 0; v < kNumVoices; v++)
 204:OrganEngine.h ****         {
 205:OrganEngine.h ****             if(voices_[v].state == IDLE)
 206:OrganEngine.h ****             {
 207:OrganEngine.h ****                 StartVoice(v, note, velocity);
 208:OrganEngine.h ****                 return;
 209:OrganEngine.h ****             }
 210:OrganEngine.h ****         }
 211:OrganEngine.h **** 
 212:OrganEngine.h ****         /* Steal the oldest voice (5 ms fade, then the new note starts).
ARM GAS  C:\msys64\tmp\cc4f64bL.s 			page 125


 213:OrganEngine.h ****          * C1: prefer voices not already mid-STEAL - stealing one would
 214:OrganEngine.h ****          * silently drop its pending note (that key stays held but
 215:OrganEngine.h ****          * sounds nothing). */
 216:OrganEngine.h ****         int oldest = -1;
 217:OrganEngine.h ****         for(int v = 0; v < kNumVoices; v++)
 218:OrganEngine.h ****         {
 219:OrganEngine.h ****             if(voices_[v].state != STEAL
 220:OrganEngine.h ****                && (oldest < 0 || voices_[v].age < voices_[oldest].age))
 221:OrganEngine.h ****                 oldest = v;
 222:OrganEngine.h ****         }
 223:OrganEngine.h ****         if(oldest < 0) /* all six mid-steal: fall back to oldest overall */
 224:OrganEngine.h ****         {
 225:OrganEngine.h ****             for(int v = 0; v < kNumVoices; v++)
 226:OrganEngine.h ****             {
 227:OrganEngine.h ****                 if(oldest < 0 || voices_[v].age < voices_[oldest].age)
 228:OrganEngine.h ****                     oldest = v;
 229:OrganEngine.h ****             }
 230:OrganEngine.h ****         }
 231:OrganEngine.h ****         Voice &voice      = voices_[oldest];
 232:OrganEngine.h ****         voice.pending_note = note;
 233:OrganEngine.h ****         voice.pending_vel  = velocity;
 234:OrganEngine.h ****         voice.state        = STEAL;
 235:OrganEngine.h ****     }
