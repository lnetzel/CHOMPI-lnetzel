   1:OrganEngine.h **** /** @file OrganEngine.h
ARM GAS  C:\msys64\tmp\cctbVxVy.s 			page 26


   2:OrganEngine.h ****  *  @brief Polyphonic organ voice engine: 6 voices x 4 pipe registrations.
   3:OrganEngine.h ****  *
   4:OrganEngine.h ****  *  Implements FR-1/FR-6 and DSP-1..DSP-3 of chompi-organ- specification.md:
   5:OrganEngine.h ****  *  - Pipe ratios 1x / 2x / 2^(19/12)x / 4x with 20 kHz octave foldback
   6:OrganEngine.h ****  *  - Per-pipe waveform morph: sine -> square, 64 steps, smoothstep-eased
   7:OrganEngine.h ****  *    crossfade of two oscillators per pipe (polyBLEP square keeps the
   8:OrganEngine.h ****  *    high registrations alias-free); the easing keeps the blend
   9:OrganEngine.h ****  *    lingering near the pure waveforms, so the first clicks stay in
  10:OrganEngine.h ****  *    sine territory
  11:OrganEngine.h ****  *  - Free-running oscillators (phase never reset at note-on)
  12:OrganEngine.h ****  *  - Fixed 5 ms linear attack/release gate envelope; 5 ms steal fade
  13:OrganEngine.h ****  *  - Oldest-first voice stealing; same-note retrigger reuses its voice
  14:OrganEngine.h ****  *  - Fixed 1/24 output scale so 6 voices x 4 pipes cannot clip
  15:OrganEngine.h ****  *  - Pipe levels in 32 steps, gain = (step/32)^2, smoothed per sample
  16:OrganEngine.h ****  *  - Overdrive: 32-step overdrive-pedal stage on the mix (pre-gain into a
  17:OrganEngine.h ****  *    tanh soft clip with level-anchored post gain), placed before the
  18:OrganEngine.h ****  *    master gain so the drive character is level-independent; 0% is an
  19:OrganEngine.h ****  *    exact bypass (DSP-5)
  20:OrganEngine.h ****  *  - Rotary speaker: 60s Leslie-style mono->stereo stage after the
  21:OrganEngine.h ****  *    overdrive (800 Hz crossover, Doppler horn + AM drum, two virtual
  22:OrganEngine.h ****  *    mics 180 deg apart); 0% is an exact bypass (DSP-6)
  23:OrganEngine.h ****  *  - Smoothed master gain (existing CHOMPI volume-knob behaviour)
  24:OrganEngine.h ****  */
  25:OrganEngine.h **** #pragma once
  26:OrganEngine.h **** #include "daisysp.h"
  27:OrganEngine.h **** #include "RotarySpeaker.h"
  28:OrganEngine.h **** 
  29:OrganEngine.h **** namespace chompi
  30:OrganEngine.h **** {
  31:OrganEngine.h **** 
  32:OrganEngine.h **** class OrganEngine
