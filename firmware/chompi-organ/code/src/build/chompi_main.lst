  41:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****      *  @note These settings are used during initialization
  42:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****      *   and changing them afterwards may not have the desired effect.
  43:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****      */
  44:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****     struct Config
  45:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****     {
  46:../../../chompi-wave/code/libs/libDaisy/src/per/tim.h ****         /** @brief Hardware Timer to configure, and use. */
