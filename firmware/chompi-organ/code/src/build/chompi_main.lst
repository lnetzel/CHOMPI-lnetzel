   1:TonewheelCharacter.h **** /** @file TonewheelCharacter.h
   2:TonewheelCharacter.h ****  *  @brief Per-pipe tonewheel-inspired "Character" coloration for ORGAN.
   3:TonewheelCharacter.h ****  *
   4:TonewheelCharacter.h ****  *  Replaces the page-2 sine->square morph with four independent Character
   5:TonewheelCharacter.h ****  *  amounts (one per pipe, shared across all six voices). Step 0 is the
   6:TonewheelCharacter.h ****  *  existing clean sine; step 64 is clearly aged but still organ-like.
   7:TonewheelCharacter.h ****  *
   8:TonewheelCharacter.h ****  *  The coloration is inexpensive harmonic shading derived algebraically
   9:TonewheelCharacter.h ****  *  from the existing normalized sine sample s = sin(ph):
  10:TonewheelCharacter.h ****  *
  11:TonewheelCharacter.h ****  *      second = 2*s*s - 1            = -cos(2*ph)   (2nd harmonic)
  12:TonewheelCharacter.h ****  *      third  = s*(3 - 4*s*s)        =  sin(3*ph)   (3rd harmonic)
  13:TonewheelCharacter.h ****  *
  14:TonewheelCharacter.h ****  *  No extra oscillator, no extra sinf/powf, no per-sample random or
  15:TonewheelCharacter.h ****  *  allocation. Harmonic strengths vary deterministically by note and pipe
  16:TonewheelCharacter.h ****  *  identity (+/-15%) so repeated pitches on a pipe have a stable voicing
  17:TonewheelCharacter.h ****  *  regardless of which voice slot renders them, and each harmonic is
ARM GAS  C:\msys64\tmp\cc4f64bL.s 			page 137


  18:TonewheelCharacter.h ****  *  anti-alias-masked against the final folded pipe frequency.
  19:TonewheelCharacter.h ****  *
  20:TonewheelCharacter.h ****  *  This is an oscillator waveform shaper, not a generic zero-preserving
  21:TonewheelCharacter.h ****  *  audio filter: the second-harmonic term is -1 when s == 0, so
  22:TonewheelCharacter.h ****  *  ShapeSample(0, ...) != 0 at nonzero Character. It IS zero-mean over
  23:TonewheelCharacter.h ****  *  complete sine cycles, and pipe gain/envelopes are applied after
  24:TonewheelCharacter.h ****  *  shaping (in OrganEngine), so muted pipes stay silent.
  25:TonewheelCharacter.h ****  *
  26:TonewheelCharacter.h ****  *  Header-only, no MCU/Daisy dependencies: native-testable.
  27:TonewheelCharacter.h ****  */
  28:TonewheelCharacter.h **** #pragma once
  29:TonewheelCharacter.h **** #include <stdint.h>
  30:TonewheelCharacter.h **** #include <math.h>
  31:TonewheelCharacter.h **** 
  32:TonewheelCharacter.h **** namespace chompi
  33:TonewheelCharacter.h **** {
  34:TonewheelCharacter.h **** 
  35:TonewheelCharacter.h **** class TonewheelCharacter
  36:TonewheelCharacter.h **** {
  37:TonewheelCharacter.h ****   public:
  38:TonewheelCharacter.h ****     static constexpr int kNumVoices = 6;
  39:TonewheelCharacter.h ****     static constexpr int kNumPipes  = 4;
  40:TonewheelCharacter.h ****     static constexpr int kMaxSteps  = 64;
  41:TonewheelCharacter.h **** 
  42:TonewheelCharacter.h ****     /** Finite amount ramp length, sample-rate derived (~10 ms). */
  43:TonewheelCharacter.h ****     static constexpr float kRampSeconds = .010f;
  44:TonewheelCharacter.h **** 
  45:TonewheelCharacter.h ****     /** Maximum-aged harmonic voicing relative to the fundamental, before
  46:TonewheelCharacter.h ****      *  normalization (implementation constants, not user controls).
  47:TonewheelCharacter.h ****      *  Calibrated starting points: 2.5% 2nd, 6% 3rd harmonic. */
  48:TonewheelCharacter.h ****     static constexpr float kMaxSecond = .025f;
  49:TonewheelCharacter.h ****     static constexpr float kMaxThird  = .06f;
  50:TonewheelCharacter.h **** 
  51:TonewheelCharacter.h ****     /** Deterministic per-(note, pipe) voicing variation: +/-15%. */
  52:TonewheelCharacter.h ****     static constexpr float kVariation = .15f;
  53:TonewheelCharacter.h **** 
  54:TonewheelCharacter.h ****     /** Harmonic anti-alias mask: a harmonic at kAaFull * sample_rate or
  55:TonewheelCharacter.h ****      *  below passes at full strength; its strength fades smoothly to zero
  56:TonewheelCharacter.h ****      *  at kAaZero * sample_rate and stays zero above. */
  57:TonewheelCharacter.h ****     static constexpr float kAaFull = .35f;
  58:TonewheelCharacter.h ****     static constexpr float kAaZero = .45f;
  59:TonewheelCharacter.h **** 
  60:TonewheelCharacter.h ****     /** Cached voicing for one voice/pipe: variation-scaled,
  61:TonewheelCharacter.h ****      *  anti-alias-masked harmonic gains plus the maximum-aged
  62:TonewheelCharacter.h ****      *  normalization bound. */
  63:TonewheelCharacter.h ****     struct PipeCoeffs
  64:TonewheelCharacter.h ****     {
  65:TonewheelCharacter.h ****         float second_gain; /**< 2nd-harmonic gain vs. fundamental */
  66:TonewheelCharacter.h ****         float third_gain;  /**< 3rd-harmonic gain vs. fundamental */
  67:TonewheelCharacter.h ****         float norm;        /**< 1/(1+|g2|+|g3|): bounds aged wave to |1| */
  68:TonewheelCharacter.h ****     };
  69:TonewheelCharacter.h **** 
  70:TonewheelCharacter.h ****     void Init(float sample_rate)
  71:TonewheelCharacter.h ****     {
  72:TonewheelCharacter.h ****         sample_rate_ = sample_rate;
  73:TonewheelCharacter.h ****         ramp_inc_    = 1.f / (kRampSeconds * sample_rate);
  74:TonewheelCharacter.h ****         for(int p = 0; p < kNumPipes; p++)
ARM GAS  C:\msys64\tmp\cc4f64bL.s 			page 138


  75:TonewheelCharacter.h ****         {
  76:TonewheelCharacter.h ****             steps_[p]  = 0;
  77:TonewheelCharacter.h ****             amount_[p] = target_[p] = 0.f;
  78:TonewheelCharacter.h ****         }
  79:TonewheelCharacter.h ****         for(int v = 0; v < kNumVoices; v++)
  80:TonewheelCharacter.h ****         {
  81:TonewheelCharacter.h ****             for(int p = 0; p < kNumPipes; p++)
  82:TonewheelCharacter.h ****             {
  83:TonewheelCharacter.h ****                 coeffs_[v][p].second_gain = 0.f;
  84:TonewheelCharacter.h ****                 coeffs_[v][p].third_gain  = 0.f;
  85:TonewheelCharacter.h ****                 coeffs_[v][p].norm        = 1.f;
  86:TonewheelCharacter.h ****             }
  87:TonewheelCharacter.h ****         }
  88:TonewheelCharacter.h ****     }
  89:TonewheelCharacter.h **** 
  90:TonewheelCharacter.h ****     /** Set a pipe's Character step (0..kMaxSteps, clamped). Retargets the
  91:TonewheelCharacter.h ****      *  amount ramp from the current amount; exact settled endpoints. */
  92:TonewheelCharacter.h ****     void SetStep(int pipe, int step)
  93:TonewheelCharacter.h ****     {
  94:TonewheelCharacter.h ****         if(pipe < 0 || pipe >= kNumPipes)
  95:TonewheelCharacter.h ****             return;
  96:TonewheelCharacter.h ****         step         = step < 0 ? 0 : (step > kMaxSteps ? kMaxSteps : step);
  97:TonewheelCharacter.h ****         steps_[pipe] = static_cast<uint8_t>(step);
  98:TonewheelCharacter.h ****         target_[pipe] = static_cast<float>(step) * (1.f / kMaxSteps);
  99:TonewheelCharacter.h ****     }
