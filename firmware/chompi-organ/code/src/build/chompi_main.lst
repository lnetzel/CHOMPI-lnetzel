 111:MidiHandler.h ****      *  only TxEndCallback clears it, so the ring needs no critical
 112:MidiHandler.h ****      *  section (SPSC). */
 113:MidiHandler.h ****     void ProcessMidiOut()
 114:MidiHandler.h ****     {
