 121:OrganEngine.h ****     /** Apply one encoder click (or MIDI CC step) to a pipe level. */
 122:OrganEngine.h ****     void SetPipeStep(int pipe, int step)
 123:OrganEngine.h ****     {
 124:OrganEngine.h ****         if(pipe < 0 || pipe >= kNumPipes)
 125:OrganEngine.h ****             return;
 126:OrganEngine.h ****         step = step < 0 ? 0 : (step > kMaxSteps ? kMaxSteps : step);
 127:OrganEngine.h ****         pipe_steps[pipe]            = static_cast<uint8_t>(step);
 128:OrganEngine.h ****         pipe_gain_target_[pipe]     = StepToGain(step);
 129:OrganEngine.h ****     }
 130:OrganEngine.h **** 
 131:OrganEngine.h ****     int GetPipeStep(int pipe) const { return pipe_steps[pipe]; }
 132:OrganEngine.h **** 
 133:OrganEngine.h ****     /** Apply one encoder click (or MIDI CC step) to a pipe's waveform morph.
