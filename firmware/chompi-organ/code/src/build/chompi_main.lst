 129:TonewheelCharacter.h **** 
 130:TonewheelCharacter.h ****     /** Raw ramp amount 0..1 (diagnostics/tests). */
 131:TonewheelCharacter.h ****     float Amount(int pipe) const
 132:TonewheelCharacter.h ****     {
 133:TonewheelCharacter.h ****         if(pipe < 0 || pipe >= kNumPipes)
 134:TonewheelCharacter.h ****             return 0.f;
 135:TonewheelCharacter.h ****         return amount_[pipe];
 136:TonewheelCharacter.h ****     }
 137:TonewheelCharacter.h **** 
 138:TonewheelCharacter.h ****     /** Smoothstep-eased amount 0..1: the flat lower end keeps the first
 139:TonewheelCharacter.h ****      *  clicks gentle. */
 140:TonewheelCharacter.h ****     float EasedAmount(int pipe) const
 141:TonewheelCharacter.h ****     {
 142:TonewheelCharacter.h ****         return Smooth(Amount(pipe));
 143:TonewheelCharacter.h ****     }
 144:TonewheelCharacter.h **** 
 145:TonewheelCharacter.h ****     /** Recompute the cached voicing for one voice/pipe. Call when the
 146:TonewheelCharacter.h ****      *  voice's frequencies are initialized or updated (note-on, fine
 147:TonewheelCharacter.h ****      *  tune). folded_hz is the FINAL folded pipe frequency; note and pipe
 148:TonewheelCharacter.h ****      *  identity drive the deterministic variation. Voice-slot independent:
 149:TonewheelCharacter.h ****      *  the same (note, pipe, folded_hz) always yields the same coeffs. */
 150:TonewheelCharacter.h ****     void UpdateVoiceCoeffs(int voice, int note, int pipe, float folded_hz)
 151:TonewheelCharacter.h ****     {
 152:TonewheelCharacter.h ****         if(voice < 0 || voice >= kNumVoices || pipe < 0 || pipe >= kNumPipes)
 153:TonewheelCharacter.h ****             return;
 154:TonewheelCharacter.h ****         PipeCoeffs &c = coeffs_[voice][pipe];
 155:TonewheelCharacter.h ****         const float v2 = 1.f + kVariation * DetHash(note, pipe, 0);
 156:TonewheelCharacter.h ****         const float v3 = 1.f + kVariation * DetHash(note, pipe, 1);
 157:TonewheelCharacter.h ****         c.second_gain  = kMaxSecond * v2 * AaMask(2.f * folded_hz);
 158:TonewheelCharacter.h ****         c.third_gain   = kMaxThird * v3 * AaMask(3.f * folded_hz);
 159:TonewheelCharacter.h ****         c.norm = 1.f / (1.f + fabsf(c.second_gain) + fabsf(c.third_gain));
 160:TonewheelCharacter.h ****     }
 161:TonewheelCharacter.h **** 
 162:TonewheelCharacter.h ****     const PipeCoeffs &Coeffs(int voice, int pipe) const
 163:TonewheelCharacter.h ****     {
 164:TonewheelCharacter.h ****         return coeffs_[voice][pipe];
 165:TonewheelCharacter.h ****     }
 166:TonewheelCharacter.h **** 
 167:TonewheelCharacter.h ****     /** Shape one normalized sine sample s (|s| <= 1) toward the bounded
 168:TonewheelCharacter.h ****      *  aged waveform by the eased amount (convex blend, no division).
 169:TonewheelCharacter.h ****      *  Settled Character zero returns the original sine exactly. */
 170:TonewheelCharacter.h ****     static float ShapeSample(float s, const PipeCoeffs &c, float eased_amount)
 171:TonewheelCharacter.h ****     {
 172:TonewheelCharacter.h ****         if(eased_amount <= 0.f)
 173:TonewheelCharacter.h ****             return s;
 174:TonewheelCharacter.h ****         const float second = 2.f * s * s - 1.f;       /* -cos(2*ph) */
 175:TonewheelCharacter.h ****         const float third  = s * (3.f - 4.f * s * s); /*  sin(3*ph) */
 176:TonewheelCharacter.h ****         const float aged
 177:TonewheelCharacter.h ****             = c.norm * (s + c.second_gain * second + c.third_gain * third);
 178:TonewheelCharacter.h ****         return s + eased_amount * (aged - s);
 179:TonewheelCharacter.h ****     }
 180:TonewheelCharacter.h **** 
 181:TonewheelCharacter.h ****   private:
ARM GAS  C:\msys64\tmp\cc4f64bL.s 			page 363


 182:TonewheelCharacter.h ****     static float Smooth(float t) { return t * t * (3.f - 2.f * t); }
