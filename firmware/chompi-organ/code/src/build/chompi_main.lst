 190:OrganEngine.h ****     void NoteOn(uint8_t note, float velocity)
 191:OrganEngine.h ****     {
 192:OrganEngine.h ****         note_held_[note & 0x7f] = true;
 193:OrganEngine.h **** 
 194:OrganEngine.h ****         /* Retrigger: reuse a voice already playing/releasing this note.
 195:OrganEngine.h ****          * C1: a voice mid-STEAL whose pending note matches is also a
 196:OrganEngine.h ****          * retrigger (it starts this note when its fade ends) - without
 197:OrganEngine.h ****          * this, two voices could end up on the same note. */
 198:OrganEngine.h ****         for(int v = 0; v < kNumVoices; v++)
 199:OrganEngine.h ****         {
 200:OrganEngine.h ****             Voice &voice = voices_[v];
 201:OrganEngine.h ****             if((voice.state == ATTACK || voice.state == SUSTAIN
 202:OrganEngine.h ****                 || voice.state == RELEASE)
 203:OrganEngine.h ****                && voice.note == note)
 204:OrganEngine.h ****             {
 205:OrganEngine.h ****                 StartVoice(voice, note, velocity);
 206:OrganEngine.h ****                 return;
 207:OrganEngine.h ****             }
 208:OrganEngine.h ****             if(voice.state == STEAL && voice.pending_note == note)
 209:OrganEngine.h ****             {
 210:OrganEngine.h ****                 voice.pending_vel = velocity;
 211:OrganEngine.h ****                 return;
 212:OrganEngine.h ****             }
 213:OrganEngine.h ****         }
 214:OrganEngine.h **** 
ARM GAS  C:\msys64\tmp\cctbVxVy.s 			page 125


 215:OrganEngine.h ****         /* Free voice */
 216:OrganEngine.h ****         for(int v = 0; v < kNumVoices; v++)
 217:OrganEngine.h ****         {
 218:OrganEngine.h ****             if(voices_[v].state == IDLE)
 219:OrganEngine.h ****             {
 220:OrganEngine.h ****                 StartVoice(voices_[v], note, velocity);
 221:OrganEngine.h ****                 return;
 222:OrganEngine.h ****             }
 223:OrganEngine.h ****         }
 224:OrganEngine.h **** 
 225:OrganEngine.h ****         /* Steal the oldest voice (5 ms fade, then the new note starts).
 226:OrganEngine.h ****          * C1: prefer voices not already mid-STEAL - stealing one would
 227:OrganEngine.h ****          * silently drop its pending note (that key stays held but
 228:OrganEngine.h ****          * sounds nothing). */
 229:OrganEngine.h ****         int oldest = -1;
 230:OrganEngine.h ****         for(int v = 0; v < kNumVoices; v++)
 231:OrganEngine.h ****         {
 232:OrganEngine.h ****             if(voices_[v].state != STEAL
 233:OrganEngine.h ****                && (oldest < 0 || voices_[v].age < voices_[oldest].age))
 234:OrganEngine.h ****                 oldest = v;
 235:OrganEngine.h ****         }
 236:OrganEngine.h ****         if(oldest < 0) /* all six mid-steal: fall back to oldest overall */
 237:OrganEngine.h ****         {
 238:OrganEngine.h ****             for(int v = 0; v < kNumVoices; v++)
 239:OrganEngine.h ****             {
 240:OrganEngine.h ****                 if(oldest < 0 || voices_[v].age < voices_[oldest].age)
 241:OrganEngine.h ****                     oldest = v;
 242:OrganEngine.h ****             }
 243:OrganEngine.h ****         }
 244:OrganEngine.h ****         Voice &voice      = voices_[oldest];
 245:OrganEngine.h ****         voice.pending_note = note;
 246:OrganEngine.h ****         voice.pending_vel  = velocity;
 247:OrganEngine.h ****         voice.state        = STEAL;
 248:OrganEngine.h ****     }
