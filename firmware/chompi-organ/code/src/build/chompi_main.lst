 119:MidiHandler.h ****     {
 120:MidiHandler.h ****         uint8_t buf[3] = {static_cast<uint8_t>(0x80 | kChannel), note, 0};
 121:MidiHandler.h ****         QueueDmaMessage(buf, 3);
 122:MidiHandler.h ****         if(usb_midi_active_)
 123:MidiHandler.h ****             usb_midi.SendNoteOff(kChannel, note, 0);
 124:MidiHandler.h ****     }
