  11:../../../chompi-wave/code/libs/libDaisy/src/per/sdmmc.h **** 
  12:../../../chompi-wave/code/libs/libDaisy/src/per/sdmmc.h **** namespace daisy
  13:../../../chompi-wave/code/libs/libDaisy/src/per/sdmmc.h **** {
  14:../../../chompi-wave/code/libs/libDaisy/src/per/sdmmc.h **** /** @ingroup peripheral
  15:../../../chompi-wave/code/libs/libDaisy/src/per/sdmmc.h ****     @{
  16:../../../chompi-wave/code/libs/libDaisy/src/per/sdmmc.h ****     */
  17:../../../chompi-wave/code/libs/libDaisy/src/per/sdmmc.h **** 
  18:../../../chompi-wave/code/libs/libDaisy/src/per/sdmmc.h **** /** Configuration for interfacing with SD cards.
  19:../../../chompi-wave/code/libs/libDaisy/src/per/sdmmc.h ****  *  Currently only supports operation using FatFS filesystem
  20:../../../chompi-wave/code/libs/libDaisy/src/per/sdmmc.h ****  * 
ARM GAS  C:\msys64\tmp\cc9NRbLb.s 			page 4


  21:../../../chompi-wave/code/libs/libDaisy/src/per/sdmmc.h ****  *  Only SDMMC1 is supported at this time.
  22:../../../chompi-wave/code/libs/libDaisy/src/per/sdmmc.h ****  *
  23:../../../chompi-wave/code/libs/libDaisy/src/per/sdmmc.h ****  *  Pins are fixed to the following:
  24:../../../chompi-wave/code/libs/libDaisy/src/per/sdmmc.h ****  *  PC12 - SDMMC1 CK
  25:../../../chompi-wave/code/libs/libDaisy/src/per/sdmmc.h ****  *  PD2  - SDMMC1 CMD
  26:../../../chompi-wave/code/libs/libDaisy/src/per/sdmmc.h ****  *  PC8  - SDMMC1 D0
  27:../../../chompi-wave/code/libs/libDaisy/src/per/sdmmc.h ****  *  PC9  - SDMMC1 D1 (optional)
  28:../../../chompi-wave/code/libs/libDaisy/src/per/sdmmc.h ****  *  PC10 - SDMMC1 D2 (optional)
  29:../../../chompi-wave/code/libs/libDaisy/src/per/sdmmc.h ****  *  PC11 - SDMMC1 D3 (optional)
  30:../../../chompi-wave/code/libs/libDaisy/src/per/sdmmc.h **** */
  31:../../../chompi-wave/code/libs/libDaisy/src/per/sdmmc.h **** class SdmmcHandler
  32:../../../chompi-wave/code/libs/libDaisy/src/per/sdmmc.h **** {
  33:../../../chompi-wave/code/libs/libDaisy/src/per/sdmmc.h ****   public:
  34:../../../chompi-wave/code/libs/libDaisy/src/per/sdmmc.h ****     /** Return values for the SdmmcHandler class */
  35:../../../chompi-wave/code/libs/libDaisy/src/per/sdmmc.h ****     enum class Result
  36:../../../chompi-wave/code/libs/libDaisy/src/per/sdmmc.h ****     {
  37:../../../chompi-wave/code/libs/libDaisy/src/per/sdmmc.h ****         OK,
  38:../../../chompi-wave/code/libs/libDaisy/src/per/sdmmc.h ****         ERROR,
  39:../../../chompi-wave/code/libs/libDaisy/src/per/sdmmc.h ****     };
  40:../../../chompi-wave/code/libs/libDaisy/src/per/sdmmc.h **** 
  41:../../../chompi-wave/code/libs/libDaisy/src/per/sdmmc.h ****     /** Sets whether 4-bit mode or 1-bit mode is used for the SDMMC */
  42:../../../chompi-wave/code/libs/libDaisy/src/per/sdmmc.h ****     enum class BusWidth
  43:../../../chompi-wave/code/libs/libDaisy/src/per/sdmmc.h ****     {
  44:../../../chompi-wave/code/libs/libDaisy/src/per/sdmmc.h ****         BITS_1, /**< Only 1 bit of data per clock is transferred */
  45:../../../chompi-wave/code/libs/libDaisy/src/per/sdmmc.h ****         BITS_4, /**< 4-bits of parallel data for each clock pulse */
  46:../../../chompi-wave/code/libs/libDaisy/src/per/sdmmc.h ****     };
  47:../../../chompi-wave/code/libs/libDaisy/src/per/sdmmc.h **** 
  48:../../../chompi-wave/code/libs/libDaisy/src/per/sdmmc.h ****     /** 
  49:../../../chompi-wave/code/libs/libDaisy/src/per/sdmmc.h ****     Sets the desired clock speed of the SD card bus. \n 
  50:../../../chompi-wave/code/libs/libDaisy/src/per/sdmmc.h ****     Initialization is always done at or below 400kHz, and then the user speed is set.
  51:../../../chompi-wave/code/libs/libDaisy/src/per/sdmmc.h ****     */
  52:../../../chompi-wave/code/libs/libDaisy/src/per/sdmmc.h ****     enum class Speed
  53:../../../chompi-wave/code/libs/libDaisy/src/per/sdmmc.h ****     {
  54:../../../chompi-wave/code/libs/libDaisy/src/per/sdmmc.h ****         SLOW, /**< 400kHz, initialization  performed at this rate, before moving to user value */
  55:../../../chompi-wave/code/libs/libDaisy/src/per/sdmmc.h ****         MEDIUM_SLOW, /**< 12.5MHz - half of standard rate */
  56:../../../chompi-wave/code/libs/libDaisy/src/per/sdmmc.h ****         STANDARD,    /**< 25MHz - DS (Default Speed for SDMMC) */
  57:../../../chompi-wave/code/libs/libDaisy/src/per/sdmmc.h ****         FAST,        /**< 50MHz - HS (High Speed signaling) */
  58:../../../chompi-wave/code/libs/libDaisy/src/per/sdmmc.h ****         VERY_FAST, /**< 100MHz - SDR50 Overclocked rate for maximum transfer rates */
  59:../../../chompi-wave/code/libs/libDaisy/src/per/sdmmc.h ****     };
  60:../../../chompi-wave/code/libs/libDaisy/src/per/sdmmc.h **** 
  61:../../../chompi-wave/code/libs/libDaisy/src/per/sdmmc.h ****     struct Config
  62:../../../chompi-wave/code/libs/libDaisy/src/per/sdmmc.h ****     {
