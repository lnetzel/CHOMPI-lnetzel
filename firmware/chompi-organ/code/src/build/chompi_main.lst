  36:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h ****     asm("vmaxnm.f32 %[d], %[n], %[m]" : [d] "=t"(r) : [n] "t"(a), [m] "t"(b) :);
  37:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h **** #else
  38:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h ****     r = (a > b) ? a : b;
  39:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h **** #endif // __arm__
  40:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h ****     return r;
