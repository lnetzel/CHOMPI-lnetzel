 127:chompi_main.cpp **** /** Key-bar color modes. */
 128:chompi_main.cpp **** enum BarKind
 129:chompi_main.cpp **** {
 130:chompi_main.cpp ****     kBarVolume, /**< green/orange/red position gradient */
 131:chompi_main.cpp ****     kBarWave,   /**< uniformly blue: waveform morph bar */
 132:chompi_main.cpp ****     kBarDrive,  /**< uniformly red: overdrive bar */
 133:chompi_main.cpp ****     kBarRotary  /**< uniformly purple: rotary-speaker bar */
 134:chompi_main.cpp **** };
 135:chompi_main.cpp **** 
 136:chompi_main.cpp **** /** Key-bar color by white-key position w (0 = leftmost): volume bars
 137:chompi_main.cpp ****  *  (page-1 pipes + master volume) run green for the first 50% of keys,
 138:chompi_main.cpp ****  *  orange 50-75%, red above 75%. The page-2 waveform bar (kBarWave)
 139:chompi_main.cpp ****  *  is uniformly blue; the overdrive bar (kBarDrive) is uniformly red;
 140:chompi_main.cpp ****  *  the rotary bar (kBarRotary) is uniformly purple. */
 141:chompi_main.cpp **** static void BarKeyColor(int w, BarKind kind, float &r, float &g, float &b)
 142:chompi_main.cpp **** {
 143:chompi_main.cpp ****     if(kind == kBarWave)
 144:chompi_main.cpp ****     {
 145:chompi_main.cpp ****         r = 0.f;
 146:chompi_main.cpp ****         g = 0.f;
 147:chompi_main.cpp ****         b = 1.f; /* blue: the whole waveform bar */
 148:chompi_main.cpp ****         return;
 149:chompi_main.cpp ****     }
 150:chompi_main.cpp ****     if(kind == kBarDrive)
 151:chompi_main.cpp ****     {
 152:chompi_main.cpp ****         r = 1.f;
 153:chompi_main.cpp ****         g = 0.f;
 154:chompi_main.cpp ****         b = 0.f; /* red: the whole overdrive bar, no gradient */
 155:chompi_main.cpp ****         return;
 156:chompi_main.cpp ****     }
 157:chompi_main.cpp ****     if(kind == kBarRotary)
 158:chompi_main.cpp ****     {
 159:chompi_main.cpp ****         r = .55f;
 160:chompi_main.cpp ****         g = 0.f;
 161:chompi_main.cpp ****         b = 1.f; /* purple: the whole rotary bar */
 162:chompi_main.cpp ****         return;
 163:chompi_main.cpp ****     }
 164:chompi_main.cpp ****     r = 0.f;
 165:chompi_main.cpp ****     g = 1.f;
 166:chompi_main.cpp ****     b = 0.f; /* green: first 50% of keys */
 167:chompi_main.cpp ****     if(w >= 11) /* keys 11-14: above 75% */
 168:chompi_main.cpp ****     {
 169:chompi_main.cpp ****         r = 1.f;
 170:chompi_main.cpp ****         g = 0.f; /* red */
 171:chompi_main.cpp ****     }
 172:chompi_main.cpp ****     else if(w >= 7) /* keys 7-10: 50-75% */
 173:chompi_main.cpp ****     {
 174:chompi_main.cpp ****         r = 1.f;
 175:chompi_main.cpp ****         g = .6f; /* orange */
 176:chompi_main.cpp ****     }
 177:chompi_main.cpp **** }
