  83:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h ****     l >>= (n = 1);
  84:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h ****     l += 0x3F800000;
  85:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h ****     *lp = l;
  86:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h ****     return f;
  87:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h **** }
  88:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h **** 
  89:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h **** /** From http://openaudio.blogspot.com/2017/02/faster-log10-and-pow.html
ARM GAS  C:\msys64\tmp\cc4f64bL.s 			page 361


  90:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h **** No approximation, pow10f(x) gives a 90% speed increase over powf(10.f, x)
  91:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h **** */
  92:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h **** inline float pow10f(float f)
  93:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h **** {
  94:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h ****     return expf(2.302585092994046f * f);
  95:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h **** }
  96:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h **** 
  97:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h **** /* Original code for fastlog2f by Dr. Paul Beckmann from the ARM community forum, adapted from the 
  98:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h **** About 25% performance increase over std::log10f
  99:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h **** */
 100:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h **** inline float fastlog2f(float f)
 101:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h **** {
 102:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h ****     float frac;
 103:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h ****     int   exp;
 104:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h ****     frac = frexpf(fabsf(f), &exp);
 105:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h ****     f    = 1.23149591368684f;
 106:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h ****     f *= frac;
 107:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h ****     f += -4.11852516267426f;
 108:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h ****     f *= frac;
 109:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h ****     f += 6.02197014179219f;
 110:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h ****     f *= frac;
 111:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h ****     f += -3.13396450166353f;
 112:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h ****     f += exp;
 113:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h ****     return (f);
 114:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h **** }
 115:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h **** 
 116:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h **** inline float fastlog10f(float f)
 117:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h **** {
 118:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h ****     return fastlog2f(f) * 0.3010299956639812f;
 119:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h **** }
 120:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h **** 
 121:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h **** /** Midi to frequency helper
 122:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h **** */
 123:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h **** inline float mtof(float m)
 124:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h **** {
 125:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h ****     return powf(2, (m - 69.0f) / 12.0f) * 440.0f;
 126:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h **** }
 127:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h **** 
 128:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h **** 
 129:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h **** /** one pole lpf
