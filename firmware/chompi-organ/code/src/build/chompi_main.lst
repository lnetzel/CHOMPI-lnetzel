   1:../../../chompi-wave/code/libs/libDaisy/src/dev/sr_4021.h **** #pragma once
   2:../../../chompi-wave/code/libs/libDaisy/src/dev/sr_4021.h **** #ifndef DEV_SR_4021_H
   3:../../../chompi-wave/code/libs/libDaisy/src/dev/sr_4021.h **** #define DEV_SR_4021_H
   4:../../../chompi-wave/code/libs/libDaisy/src/dev/sr_4021.h **** #include "per/gpio.h"
   5:../../../chompi-wave/code/libs/libDaisy/src/dev/sr_4021.h **** #include "sys/system.h"
   6:../../../chompi-wave/code/libs/libDaisy/src/dev/sr_4021.h **** 
   7:../../../chompi-wave/code/libs/libDaisy/src/dev/sr_4021.h **** namespace daisy
   8:../../../chompi-wave/code/libs/libDaisy/src/dev/sr_4021.h **** {
   9:../../../chompi-wave/code/libs/libDaisy/src/dev/sr_4021.h **** /** @brief Device Driver for CD4021 shift register
  10:../../../chompi-wave/code/libs/libDaisy/src/dev/sr_4021.h ****  ** @author shensley
  11:../../../chompi-wave/code/libs/libDaisy/src/dev/sr_4021.h ****  ** @ingroup shiftregister
  12:../../../chompi-wave/code/libs/libDaisy/src/dev/sr_4021.h ****  **
  13:../../../chompi-wave/code/libs/libDaisy/src/dev/sr_4021.h ****  ** CD4021B-Q1: CMOS 8-STAGE STATIC SHIFT REGISTER
  14:../../../chompi-wave/code/libs/libDaisy/src/dev/sr_4021.h ****  ** 
  15:../../../chompi-wave/code/libs/libDaisy/src/dev/sr_4021.h ****  ** Supply Voltage: 3V to 18V
  16:../../../chompi-wave/code/libs/libDaisy/src/dev/sr_4021.h ****  ** Clock Freq: 3MHz at 5V (less at 3v3) -> 8.5MHz at 15V
  17:../../../chompi-wave/code/libs/libDaisy/src/dev/sr_4021.h ****  ** Pin Descriptions:
  18:../../../chompi-wave/code/libs/libDaisy/src/dev/sr_4021.h ****  ** - Parallel Data[1-8] - 7, 6, 5, 4, 13, 14, 115, 1
  19:../../../chompi-wave/code/libs/libDaisy/src/dev/sr_4021.h ****  ** - Serial Data        - 11
  20:../../../chompi-wave/code/libs/libDaisy/src/dev/sr_4021.h ****  ** - Clock              - 10
  21:../../../chompi-wave/code/libs/libDaisy/src/dev/sr_4021.h ****  ** - P/!S               - 9
  22:../../../chompi-wave/code/libs/libDaisy/src/dev/sr_4021.h ****  ** - Q[6-8]             - 2, 12, 3
  23:../../../chompi-wave/code/libs/libDaisy/src/dev/sr_4021.h ****  **
  24:../../../chompi-wave/code/libs/libDaisy/src/dev/sr_4021.h ****  ** Driver has support for daisy chaining and running up to 2 same-sized 
  25:../../../chompi-wave/code/libs/libDaisy/src/dev/sr_4021.h ****  ** chains in parallel from a single set of clk/latch pins to reduce 
  26:../../../chompi-wave/code/libs/libDaisy/src/dev/sr_4021.h ****  ** pin/code overhead when using multiple devices.
  27:../../../chompi-wave/code/libs/libDaisy/src/dev/sr_4021.h ****  **
  28:../../../chompi-wave/code/libs/libDaisy/src/dev/sr_4021.h ****  ** When dealing with multiple parallel/daisy-chained devices the 
  29:../../../chompi-wave/code/libs/libDaisy/src/dev/sr_4021.h ****  ** states of all inputs will be filled in the following order (example uses two chained and two pa
  30:../../../chompi-wave/code/libs/libDaisy/src/dev/sr_4021.h ****  ** data[chain0,parallel0], data[chain1,parallel0], data[chain0,parallel1], data[chain1,parallel1];
  31:../../../chompi-wave/code/libs/libDaisy/src/dev/sr_4021.h ****  ** 
  32:../../../chompi-wave/code/libs/libDaisy/src/dev/sr_4021.h ****  ** When combining multiple daisy chained and parallel devices the number of devices chained should
ARM GAS  C:\msys64\tmp\cc9NRbLb.s 			page 15


  33:../../../chompi-wave/code/libs/libDaisy/src/dev/sr_4021.h ****  ** for each parallel device chain.
  34:../../../chompi-wave/code/libs/libDaisy/src/dev/sr_4021.h ****  **
  35:../../../chompi-wave/code/libs/libDaisy/src/dev/sr_4021.h ****  ***/
  36:../../../chompi-wave/code/libs/libDaisy/src/dev/sr_4021.h **** template <size_t num_daisychained = 1, size_t num_parallel = 1>
  37:../../../chompi-wave/code/libs/libDaisy/src/dev/sr_4021.h **** class ShiftRegister4021
  38:../../../chompi-wave/code/libs/libDaisy/src/dev/sr_4021.h **** {
  39:../../../chompi-wave/code/libs/libDaisy/src/dev/sr_4021.h ****   public:
  40:../../../chompi-wave/code/libs/libDaisy/src/dev/sr_4021.h ****     /** Configuration Structure for handling the pin setting of the device */
  41:../../../chompi-wave/code/libs/libDaisy/src/dev/sr_4021.h ****     struct Config
  42:../../../chompi-wave/code/libs/libDaisy/src/dev/sr_4021.h ****     {
  43:../../../chompi-wave/code/libs/libDaisy/src/dev/sr_4021.h ****         dsy_gpio_pin clk;   /**< Clock pin to attach to pin 10 of device(s) */
  44:../../../chompi-wave/code/libs/libDaisy/src/dev/sr_4021.h ****         dsy_gpio_pin latch; /**< Latch pin to attach to pin 9 of device(s) */
  45:../../../chompi-wave/code/libs/libDaisy/src/dev/sr_4021.h ****         dsy_gpio_pin data[num_parallel]; /**< Data Pin(s) */
  46:../../../chompi-wave/code/libs/libDaisy/src/dev/sr_4021.h ****         int dbc_size;
  47:../../../chompi-wave/code/libs/libDaisy/src/dev/sr_4021.h ****     };
  48:../../../chompi-wave/code/libs/libDaisy/src/dev/sr_4021.h **** 
