  47:MidiHandler.h ****     /** Call from the audio ISR: incoming notes/CCs become engine requests. */
  48:MidiHandler.h ****     void ProcessMidiIn()
  49:MidiHandler.h ****     {
  50:MidiHandler.h ****         MidiEvent event;
  51:MidiHandler.h ****         while(GetMidi(event))
  52:MidiHandler.h ****         {
  53:MidiHandler.h ****             if(event.channel != kChannel)
  54:MidiHandler.h ****                 continue;
  55:MidiHandler.h **** 
  56:MidiHandler.h ****             switch(event.type)
  57:MidiHandler.h ****             {
  58:MidiHandler.h ****                 case NoteOn:
  59:MidiHandler.h ****                     if(event.data[1] > 0)
  60:MidiHandler.h ****                         engine_->NoteOn(event.data[0],
  61:MidiHandler.h ****                                         static_cast<float>(event.data[1]) / 127.f);
  62:MidiHandler.h ****                     else
  63:MidiHandler.h ****                         engine_->NoteOff(event.data[0]); /* vel-0 = note off */
  64:MidiHandler.h ****                     break;
  65:MidiHandler.h ****                 case NoteOff:
  66:MidiHandler.h ****                     engine_->NoteOff(event.data[0]);
  67:MidiHandler.h ****                     break;
  68:MidiHandler.h ****                 case ControlChange:
  69:MidiHandler.h ****                 {
  70:MidiHandler.h ****                     const uint8_t cc  = event.data[0];
  71:MidiHandler.h ****                     const uint8_t val = event.data[1];
  72:MidiHandler.h ****                     if(cc >= kPipeCcBase && cc < kPipeCcBase + chompi::OrganEngine::kNumPipes)
  73:MidiHandler.h ****                     {
  74:MidiHandler.h ****                         /* 0-127 -> 0-32, rounded */
  75:MidiHandler.h ****                         const int step = (static_cast<int>(val)
  76:MidiHandler.h ****                                               * chompi::OrganEngine::kMaxSteps
  77:MidiHandler.h ****                                           + 63)
  78:MidiHandler.h ****                                          / 127;
  79:MidiHandler.h ****                         engine_->SetPipeStep(cc - kPipeCcBase, step);
  80:MidiHandler.h ****                         if(cc_level_callback_)
  81:MidiHandler.h ****                             cc_level_callback_(cc - kPipeCcBase, 0);
  82:MidiHandler.h ****                     }
  83:MidiHandler.h ****                     else if(cc >= kWaveCcBase
  84:MidiHandler.h ****                             && cc < kWaveCcBase + chompi::OrganEngine::kNumPipes)
  85:MidiHandler.h ****                     {
  86:MidiHandler.h ****                         /* 0-127 -> 0-64, rounded */
  87:MidiHandler.h ****                         const int step = (static_cast<int>(val)
  88:MidiHandler.h ****                                               * chompi::OrganEngine::kMaxWaveSteps
  89:MidiHandler.h ****                                           + 63)
  90:MidiHandler.h ****                                          / 127;
  91:MidiHandler.h ****                         engine_->SetPipeWaveStep(cc - kWaveCcBase, step);
  92:MidiHandler.h ****                         if(cc_level_callback_)
  93:MidiHandler.h ****                             cc_level_callback_(cc - kWaveCcBase, 1);
  94:MidiHandler.h ****                     }
  95:MidiHandler.h ****                     break;
  96:MidiHandler.h ****                 }
  97:MidiHandler.h ****                 default: break;
  98:MidiHandler.h ****             }
  99:MidiHandler.h ****         }
 100:MidiHandler.h ****     }
