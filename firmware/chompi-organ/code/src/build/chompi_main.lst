 136:OrganEngine.h ****     void SetPipeWaveStep(int pipe, int step)
 137:OrganEngine.h ****     {
 138:OrganEngine.h ****         if(pipe < 0 || pipe >= kNumPipes)
 139:OrganEngine.h ****             return;
 140:OrganEngine.h ****         step = step < 0 ? 0 : (step > kMaxWaveSteps ? kMaxWaveSteps : step);
 141:OrganEngine.h ****         pipe_wave_steps[pipe]    = static_cast<uint8_t>(step);
 142:OrganEngine.h ****         pipe_wave_target_[pipe]  = StepToMorph(step);
 143:OrganEngine.h ****     }
 144:OrganEngine.h **** 
 145:OrganEngine.h ****     int GetPipeWaveStep(int pipe) const { return pipe_wave_steps[pipe]; }
 146:OrganEngine.h **** 
 147:OrganEngine.h ****     /** Apply one encoder click to the overdrive amount (0..kMaxSteps).
