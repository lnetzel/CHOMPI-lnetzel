 136:chompi_main.cpp **** /** Key-bar color modes. */
 137:chompi_main.cpp **** enum BarKind
 138:chompi_main.cpp **** {
 139:chompi_main.cpp ****     kBarVolume,   /**< green/orange/red position gradient */
 140:chompi_main.cpp ****     kBarCharacter, /**< uniformly blue: pipe Character bar */
 141:chompi_main.cpp ****     kBarDrive,    /**< uniformly red: overdrive bar */
 142:chompi_main.cpp ****     kBarRotary    /**< uniformly purple: rotary-speaker bar */
 143:chompi_main.cpp **** };
 144:chompi_main.cpp **** 
 145:chompi_main.cpp **** /** Key-bar color by white-key position w (0 = leftmost): volume bars
 146:chompi_main.cpp ****  *  (page-1 pipes + master volume) run green for the first 50% of keys,
 147:chompi_main.cpp ****  *  orange 50-75%, red above 75%. The page-2 pipe Character bar
 148:chompi_main.cpp ****  *  (kBarCharacter) is uniformly blue; the overdrive bar (kBarDrive) is
 149:chompi_main.cpp ****  *  uniformly red; the rotary bar (kBarRotary) is uniformly purple. */
 150:chompi_main.cpp **** static void BarKeyColor(int w, BarKind kind, float &r, float &g, float &b)
 151:chompi_main.cpp **** {
 152:chompi_main.cpp ****     if(kind == kBarCharacter)
 153:chompi_main.cpp ****     {
 154:chompi_main.cpp ****         r = 0.f;
 155:chompi_main.cpp ****         g = 0.f;
 156:chompi_main.cpp ****         b = 1.f; /* blue: the whole Character bar */
 157:chompi_main.cpp ****         return;
 158:chompi_main.cpp ****     }
 159:chompi_main.cpp ****     if(kind == kBarDrive)
 160:chompi_main.cpp ****     {
 161:chompi_main.cpp ****         r = 1.f;
 162:chompi_main.cpp ****         g = 0.f;
 163:chompi_main.cpp ****         b = 0.f; /* red: the whole overdrive bar, no gradient */
ARM GAS  C:\msys64\tmp\cc4f64bL.s 			page 46


 164:chompi_main.cpp ****         return;
 165:chompi_main.cpp ****     }
 166:chompi_main.cpp ****     if(kind == kBarRotary)
 167:chompi_main.cpp ****     {
 168:chompi_main.cpp ****         r = .55f;
 169:chompi_main.cpp ****         g = 0.f;
 170:chompi_main.cpp ****         b = 1.f; /* purple: the whole rotary bar */
 171:chompi_main.cpp ****         return;
 172:chompi_main.cpp ****     }
 173:chompi_main.cpp ****     r = 0.f;
 174:chompi_main.cpp ****     g = 1.f;
 175:chompi_main.cpp ****     b = 0.f; /* green: first 50% of keys */
 176:chompi_main.cpp ****     if(w >= 11) /* keys 11-14: above 75% */
 177:chompi_main.cpp ****     {
 178:chompi_main.cpp ****         r = 1.f;
 179:chompi_main.cpp ****         g = 0.f; /* red */
 180:chompi_main.cpp ****     }
 181:chompi_main.cpp ****     else if(w >= 7) /* keys 7-10: 50-75% */
 182:chompi_main.cpp ****     {
 183:chompi_main.cpp ****         r = 1.f;
 184:chompi_main.cpp ****         g = .6f; /* orange */
 185:chompi_main.cpp ****     }
 186:chompi_main.cpp **** }
