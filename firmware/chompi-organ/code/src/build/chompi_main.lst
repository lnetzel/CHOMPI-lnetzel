 12947              		.file 29 "../../../chompi-wave/code/libs/libDaisy/src/sys/fatfs.h"
   1:../../../chompi-wave/code/libs/libDaisy/src/sys/fatfs.h **** #ifndef __fatfs_H
   2:../../../chompi-wave/code/libs/libDaisy/src/sys/fatfs.h **** #define __fatfs_H /**< & */
   3:../../../chompi-wave/code/libs/libDaisy/src/sys/fatfs.h **** 
   4:../../../chompi-wave/code/libs/libDaisy/src/sys/fatfs.h **** #include "ff.h"
   5:../../../chompi-wave/code/libs/libDaisy/src/sys/fatfs.h **** 
   6:../../../chompi-wave/code/libs/libDaisy/src/sys/fatfs.h **** namespace daisy
   7:../../../chompi-wave/code/libs/libDaisy/src/sys/fatfs.h **** {
   8:../../../chompi-wave/code/libs/libDaisy/src/sys/fatfs.h **** /** @brief Daisy FatFS Driver Interface
   9:../../../chompi-wave/code/libs/libDaisy/src/sys/fatfs.h ****  *  @details Specifies the desired media (SD Card, USB, etc.) to be mountable with FatFS
  10:../../../chompi-wave/code/libs/libDaisy/src/sys/fatfs.h ****  *           within a given application. Once initialization is called, the standard
  11:../../../chompi-wave/code/libs/libDaisy/src/sys/fatfs.h ****  *           FatFS API will be usable with the media mounted in the order 
  12:../../../chompi-wave/code/libs/libDaisy/src/sys/fatfs.h ****  *           they are listed in the Media config struct. 
  13:../../../chompi-wave/code/libs/libDaisy/src/sys/fatfs.h ****  *           For example, when only using an SD Card, it will mount at "0:/",
  14:../../../chompi-wave/code/libs/libDaisy/src/sys/fatfs.h ****  *           when only using USB, it will mount at "0:/". However, when mounting 
  15:../../../chompi-wave/code/libs/libDaisy/src/sys/fatfs.h ****  *           with SD card and USB, the SD card will mount at "0:/", and the USB 
  16:../../../chompi-wave/code/libs/libDaisy/src/sys/fatfs.h ****  *           will mount at "1:/".
  17:../../../chompi-wave/code/libs/libDaisy/src/sys/fatfs.h ****  *           The relevant hardware peripheral (SDMMC, or MSD) needs to be initialized
  18:../../../chompi-wave/code/libs/libDaisy/src/sys/fatfs.h ****  *           separately by the application before using FatFS.
  19:../../../chompi-wave/code/libs/libDaisy/src/sys/fatfs.h ****  *          
  20:../../../chompi-wave/code/libs/libDaisy/src/sys/fatfs.h ****  *           This object has some memory limitations due to the media connected to it.
  21:../../../chompi-wave/code/libs/libDaisy/src/sys/fatfs.h ****  *           The SDMMC1 peripheral can only communicate with the AXI SRAM, and the DTCMRAM 
  22:../../../chompi-wave/code/libs/libDaisy/src/sys/fatfs.h ****  *           cannot communicate with the DMA. So the FatFSInterface object should always be
  23:../../../chompi-wave/code/libs/libDaisy/src/sys/fatfs.h ****  *           located in the AXI SRAM. This is the default location for all data/bss memory
  24:../../../chompi-wave/code/libs/libDaisy/src/sys/fatfs.h ****  *           using the standard build. However, applciations using the electrosmith bootloader
  25:../../../chompi-wave/code/libs/libDaisy/src/sys/fatfs.h ****  *           will need special consideration when using this object AND an SD Card. 
  26:../../../chompi-wave/code/libs/libDaisy/src/sys/fatfs.h ****  */
  27:../../../chompi-wave/code/libs/libDaisy/src/sys/fatfs.h **** class FatFSInterface
  28:../../../chompi-wave/code/libs/libDaisy/src/sys/fatfs.h **** {
  29:../../../chompi-wave/code/libs/libDaisy/src/sys/fatfs.h ****   public:
  30:../../../chompi-wave/code/libs/libDaisy/src/sys/fatfs.h ****     /** Return values specifying specific errors for linking Daisy to FatFS */
  31:../../../chompi-wave/code/libs/libDaisy/src/sys/fatfs.h ****     enum Result
  32:../../../chompi-wave/code/libs/libDaisy/src/sys/fatfs.h ****     {
  33:../../../chompi-wave/code/libs/libDaisy/src/sys/fatfs.h ****         OK,
  34:../../../chompi-wave/code/libs/libDaisy/src/sys/fatfs.h ****         ERR_TOO_MANY_VOLUMES,
  35:../../../chompi-wave/code/libs/libDaisy/src/sys/fatfs.h ****         ERR_NO_MEDIA_SELECTED,
  36:../../../chompi-wave/code/libs/libDaisy/src/sys/fatfs.h ****         ERR_GENERIC,
  37:../../../chompi-wave/code/libs/libDaisy/src/sys/fatfs.h ****     };
  38:../../../chompi-wave/code/libs/libDaisy/src/sys/fatfs.h **** 
  39:../../../chompi-wave/code/libs/libDaisy/src/sys/fatfs.h ****     /** Config structure for configuring Daisy to FatFS */
  40:../../../chompi-wave/code/libs/libDaisy/src/sys/fatfs.h ****     struct Config
ARM GAS  C:\msys64\tmp\cc9NRbLb.s 			page 423


  41:../../../chompi-wave/code/libs/libDaisy/src/sys/fatfs.h ****     {
  42:../../../chompi-wave/code/libs/libDaisy/src/sys/fatfs.h ****         /** Selected Media that will be linked to FatFS 
  43:../../../chompi-wave/code/libs/libDaisy/src/sys/fatfs.h ****          *  These values can be OR'd together when multiple
  44:../../../chompi-wave/code/libs/libDaisy/src/sys/fatfs.h ****          *  volumes are desired 
  45:../../../chompi-wave/code/libs/libDaisy/src/sys/fatfs.h ****          *  i.e. config.media = Media::SD | Media::USBH;
  46:../../../chompi-wave/code/libs/libDaisy/src/sys/fatfs.h ****          * 
  47:../../../chompi-wave/code/libs/libDaisy/src/sys/fatfs.h ****          *  When mounting multiple volumes, ffconf.h must have 
  48:../../../chompi-wave/code/libs/libDaisy/src/sys/fatfs.h ****          *  _VOLUMES set to an appropriate value.
  49:../../../chompi-wave/code/libs/libDaisy/src/sys/fatfs.h ****          * 
  50:../../../chompi-wave/code/libs/libDaisy/src/sys/fatfs.h ****          *  FatFS will register multiple volumes in the order of the enum,
  51:../../../chompi-wave/code/libs/libDaisy/src/sys/fatfs.h ****          *   the first registered class will mount at "0:/",
  52:../../../chompi-wave/code/libs/libDaisy/src/sys/fatfs.h ****          *   the second registered class will mount at "1:/", and so on
  53:../../../chompi-wave/code/libs/libDaisy/src/sys/fatfs.h ****          */
  54:../../../chompi-wave/code/libs/libDaisy/src/sys/fatfs.h ****         enum Media : uint8_t
  55:../../../chompi-wave/code/libs/libDaisy/src/sys/fatfs.h ****         {
  56:../../../chompi-wave/code/libs/libDaisy/src/sys/fatfs.h ****             MEDIA_SD  = 0x01,
  57:../../../chompi-wave/code/libs/libDaisy/src/sys/fatfs.h ****             MEDIA_USB = 0x02,
  58:../../../chompi-wave/code/libs/libDaisy/src/sys/fatfs.h ****             // MEDIA_QSPI = 0x04,
  59:../../../chompi-wave/code/libs/libDaisy/src/sys/fatfs.h ****         };
  60:../../../chompi-wave/code/libs/libDaisy/src/sys/fatfs.h **** 
  61:../../../chompi-wave/code/libs/libDaisy/src/sys/fatfs.h ****         uint8_t media;
  62:../../../chompi-wave/code/libs/libDaisy/src/sys/fatfs.h ****     };
  63:../../../chompi-wave/code/libs/libDaisy/src/sys/fatfs.h **** 
  64:../../../chompi-wave/code/libs/libDaisy/src/sys/fatfs.h ****     FatFSInterface() {}
  65:../../../chompi-wave/code/libs/libDaisy/src/sys/fatfs.h **** 
  66:../../../chompi-wave/code/libs/libDaisy/src/sys/fatfs.h ****     /** Link the desired hardware specified via Config::Media */
  67:../../../chompi-wave/code/libs/libDaisy/src/sys/fatfs.h ****     Result Init(const Config& cfg);
  68:../../../chompi-wave/code/libs/libDaisy/src/sys/fatfs.h **** 
  69:../../../chompi-wave/code/libs/libDaisy/src/sys/fatfs.h ****     /** Link the desired hardware specified via Config::Media 
  70:../../../chompi-wave/code/libs/libDaisy/src/sys/fatfs.h ****      * 
  71:../../../chompi-wave/code/libs/libDaisy/src/sys/fatfs.h ****      *  Alternate, explicit initialization provided for simplified syntax.
  72:../../../chompi-wave/code/libs/libDaisy/src/sys/fatfs.h ****      */
  73:../../../chompi-wave/code/libs/libDaisy/src/sys/fatfs.h ****     Result Init(const uint8_t media);
  74:../../../chompi-wave/code/libs/libDaisy/src/sys/fatfs.h **** 
  75:../../../chompi-wave/code/libs/libDaisy/src/sys/fatfs.h ****     /** Unlinks FatFS from the configured media */
  76:../../../chompi-wave/code/libs/libDaisy/src/sys/fatfs.h ****     Result DeInit();
  77:../../../chompi-wave/code/libs/libDaisy/src/sys/fatfs.h **** 
  78:../../../chompi-wave/code/libs/libDaisy/src/sys/fatfs.h ****     bool Initialized() const { return initialized_; }
  79:../../../chompi-wave/code/libs/libDaisy/src/sys/fatfs.h **** 
  80:../../../chompi-wave/code/libs/libDaisy/src/sys/fatfs.h ****     /** Return the current configuration */
  81:../../../chompi-wave/code/libs/libDaisy/src/sys/fatfs.h ****     const Config& GetConfig() const { return cfg_; }
  82:../../../chompi-wave/code/libs/libDaisy/src/sys/fatfs.h **** 
  83:../../../chompi-wave/code/libs/libDaisy/src/sys/fatfs.h ****     /** Return a mutable reference to the Configuration */
  84:../../../chompi-wave/code/libs/libDaisy/src/sys/fatfs.h ****     Config& GetMutableConfig() { return cfg_; }
  85:../../../chompi-wave/code/libs/libDaisy/src/sys/fatfs.h **** 
  86:../../../chompi-wave/code/libs/libDaisy/src/sys/fatfs.h ****     /** Returns the path to an SD Card volume to use with f_mount */
