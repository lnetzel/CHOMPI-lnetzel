 228:OrganEngine.h ****     void NoteOff(uint8_t note)
 229:OrganEngine.h ****     {
 230:OrganEngine.h ****         note &= 0x7f;
 231:OrganEngine.h ****         note_held_[note] = false;
 232:OrganEngine.h **** 
 233:OrganEngine.h ****         for(int v = 0; v < kNumVoices; v++)
 234:OrganEngine.h ****         {
 235:OrganEngine.h ****             Voice &voice = voices_[v];
 236:OrganEngine.h ****             if((voice.state == ATTACK || voice.state == SUSTAIN)
 237:OrganEngine.h ****                && voice.note == note)
 238:OrganEngine.h ****             {
 239:OrganEngine.h ****                 voice.state = RELEASE;
 240:OrganEngine.h ****             }
 241:OrganEngine.h ****             else if(voice.state == STEAL && voice.pending_note == note)
 242:OrganEngine.h ****             {
 243:OrganEngine.h ****                 /* stolen voice's pending note was cancelled: just fade out */
 244:OrganEngine.h ****                 voice.state = RELEASE;
 245:OrganEngine.h ****             }
 246:OrganEngine.h ****         }
 247:OrganEngine.h ****     }
