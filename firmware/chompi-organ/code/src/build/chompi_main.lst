 204:OrganEngine.h **** 
 205:OrganEngine.h ****         /* Free voice */
 206:OrganEngine.h ****         for(int v = 0; v < kNumVoices; v++)
 207:OrganEngine.h ****         {
 208:OrganEngine.h ****             if(voices_[v].state == IDLE)
 209:OrganEngine.h ****             {
 210:OrganEngine.h ****                 StartVoice(voices_[v], note, velocity);
 211:OrganEngine.h ****                 return;
 212:OrganEngine.h ****             }
 213:OrganEngine.h ****         }
 214:OrganEngine.h **** 
 215:OrganEngine.h ****         /* Steal the oldest voice (5 ms fade, then the new note starts) */
 216:OrganEngine.h ****         int oldest = 0;
 217:OrganEngine.h ****         for(int v = 1; v < kNumVoices; v++)
 218:OrganEngine.h ****         {
