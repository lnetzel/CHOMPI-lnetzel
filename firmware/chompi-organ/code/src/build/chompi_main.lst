   1:MidiHandler.h **** /** @file MidiHandler.h
   2:MidiHandler.h ****  *  @brief Minimal MIDI in/out for the organ: fixed channel 1, notes both ways,
   3:MidiHandler.h ****  *  CC 70-73 for the four pipe levels, CC 74-77 for the four pipe waveform
   4:MidiHandler.h ****  *  morphs. UART (5-pin DIN) uses DMA transmit;
   5:MidiHandler.h ****  *  adapted from chompi-wave's MidiManager.h (see FR-5b).
   6:MidiHandler.h ****  */
   7:MidiHandler.h **** #pragma once
   8:MidiHandler.h **** #include "daisy_seed.h"
   9:MidiHandler.h **** #include "OrganEngine.h"
  10:MidiHandler.h **** 
  11:MidiHandler.h **** using namespace daisy;
  12:MidiHandler.h **** 
  13:MidiHandler.h **** struct OrganMidiFifoEntry
  14:MidiHandler.h **** {
  15:MidiHandler.h ****     uint8_t data[3];
  16:MidiHandler.h ****     size_t  length;
  17:MidiHandler.h **** };
  18:MidiHandler.h **** 
  19:MidiHandler.h **** class OrganMidi
  20:MidiHandler.h **** {
  21:MidiHandler.h ****   public:
  22:MidiHandler.h ****     static constexpr uint8_t kChannel     = 0; /* MIDI channel 1 */
  23:MidiHandler.h ****     static constexpr uint8_t kPipeCcBase  = 70;
  24:MidiHandler.h ****     static constexpr uint8_t kWaveCcBase  = 74;
  25:MidiHandler.h ****     static constexpr uint8_t kKeyVelocity = 100;
  26:MidiHandler.h **** 
  27:MidiHandler.h ****     void Init(chompi::OrganEngine *engine)
  28:MidiHandler.h ****     {
  29:MidiHandler.h ****         engine_ = engine;
  30:MidiHandler.h **** 
  31:MidiHandler.h ****         fifo_head = fifo_tail = 0;
