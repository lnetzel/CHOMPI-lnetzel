 185:../../../chompi-wave/code/libs/libDaisy/src/hid/midi.h ****     }
 186:../../../chompi-wave/code/libs/libDaisy/src/hid/midi.h **** 
 187:../../../chompi-wave/code/libs/libDaisy/src/hid/midi.h ****     /** Start listening */
 188:../../../chompi-wave/code/libs/libDaisy/src/hid/midi.h ****     void Listen()
 189:../../../chompi-wave/code/libs/libDaisy/src/hid/midi.h ****     {
 190:../../../chompi-wave/code/libs/libDaisy/src/hid/midi.h ****         // In case of UART Error, (particularly
 191:../../../chompi-wave/code/libs/libDaisy/src/hid/midi.h ****         //  overrun error), UART disables itself.
 192:../../../chompi-wave/code/libs/libDaisy/src/hid/midi.h ****         // Flush the buff, and restart.
 193:../../../chompi-wave/code/libs/libDaisy/src/hid/midi.h ****         if(!transport_.RxActive())
 194:../../../chompi-wave/code/libs/libDaisy/src/hid/midi.h ****         {
 195:../../../chompi-wave/code/libs/libDaisy/src/hid/midi.h ****             parser_.Reset();
 196:../../../chompi-wave/code/libs/libDaisy/src/hid/midi.h ****             transport_.FlushRx();
 197:../../../chompi-wave/code/libs/libDaisy/src/hid/midi.h ****             StartReceive();
 198:../../../chompi-wave/code/libs/libDaisy/src/hid/midi.h ****         }
