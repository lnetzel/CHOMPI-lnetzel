 213:hardware.h    ****         /* Ported from TEMPO hardware.h: non-blocking battery check. Reads the battery IC without
 214:hardware.h    ****         blocking so MIDI and UI don't lag */
 215:hardware.h    ****         uint8_t batt_check_state = 0;
 216:hardware.h    ****         void BMCMediumBattCheck()
 217:hardware.h    ****         {
 218:hardware.h    ****             if(batt_level == BatteryLevel::FULL)
 219:hardware.h    ****                 return;
 220:hardware.h    **** 
 221:hardware.h    ****             uint32_t now = System::GetNow();
 222:hardware.h    ****             if (batt_check_state == 0 && now - batt_level_checkt > 30000) { // Check every 30s
 223:hardware.h    ****                 MpWrite(0x0c, 0B01011101); // set BATT_LOW to 3V3
 224:hardware.h    ****                 batt_level_checkt = now;
 225:hardware.h    ****                 batt_check_state = 1;
 226:hardware.h    ****             }
 227:hardware.h    ****             else if (batt_check_state == 1 && now - batt_level_checkt > 30) {
 228:hardware.h    ****                 MpReadAll();
 229:hardware.h    ****                 MpWrite(0x0c, 0B01010001); // set BATT_LOW to 3V
 230:hardware.h    ****                 batt_level_checkt = now;
 231:hardware.h    ****                 batt_check_state = 2;
 232:hardware.h    ****             }
 233:hardware.h    ****             else if (batt_check_state == 2 && now - batt_level_checkt > 30) {
 234:hardware.h    ****                 const bool batt_low_stat = mp_buff_[5] >> 4 & 1;
 235:hardware.h    ****                 batt_level = batt_low_stat ? BatteryLevel::MEDIUM : BatteryLevel::HIGH;
 236:hardware.h    ****                 batt_level_checkt = now;
 237:hardware.h    ****                 batt_check_state = 0;
 238:hardware.h    ****             }
 239:hardware.h    ****         }
