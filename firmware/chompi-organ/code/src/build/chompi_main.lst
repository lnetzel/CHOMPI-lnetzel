  11:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h **** /** PIs
  12:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h **** */
  13:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h **** #define PI_F 3.1415927410125732421875f
  14:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h **** #define TWOPI_F (2.0f * PI_F)
  15:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h **** #define HALFPI_F (PI_F * 0.5f)
  16:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h **** #define DSY_MIN(in, mn) (in < mn ? in : mn)
  17:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h **** #define DSY_MAX(in, mx) (in > mx ? in : mx)
  18:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h **** #define DSY_CLAMP(in, mn, mx) (DSY_MIN(DSY_MAX(in, mn), mx))
  19:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h **** #define DSY_COUNTOF(_arr) (sizeof(_arr) / sizeof(_arr[0]))
  20:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h **** 
  21:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h **** namespace daisysp
  22:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h **** {
  23:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h **** //Avoids division for random floats. e.g. rand() * kRandFrac
  24:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h **** static constexpr float kRandFrac = 1.f / (float)RAND_MAX;
  25:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h **** 
  26:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h **** //Convert from semitones to other units. e.g. 2 ^ (kOneTwelfth * x)
  27:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h **** static constexpr float kOneTwelfth = 1.f / 12.f;
  28:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h **** 
  29:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h **** /** efficient floating point min/max
  30:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h **** c/o stephen mccaul
  31:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h **** */
  32:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h **** inline float fmax(float a, float b)
  33:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h **** {
  34:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h ****     float r;
  35:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h **** #ifdef __arm__
  36:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h ****     asm("vmaxnm.f32 %[d], %[n], %[m]" : [d] "=t"(r) : [n] "t"(a), [m] "t"(b) :);
  37:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h **** #else
  38:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h ****     r = (a > b) ? a : b;
  39:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h **** #endif // __arm__
  40:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h ****     return r;
  41:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h **** }
  42:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h **** 
  43:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h **** inline float fmin(float a, float b)
  44:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h **** {
  45:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h ****     float r;
  46:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h **** #ifdef __arm__
ARM GAS  C:\msys64\tmp\ccDg23TE.s 			page 647


  47:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h ****     asm("vminnm.f32 %[d], %[n], %[m]" : [d] "=t"(r) : [n] "t"(a), [m] "t"(b) :);
  48:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h **** #else
  49:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h ****     r = (a < b) ? a : b;
