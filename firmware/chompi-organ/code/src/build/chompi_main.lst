  29:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h **** /** efficient floating point min/max
  30:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h **** c/o stephen mccaul
  31:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h **** */
  32:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h **** inline float fmax(float a, float b)
  33:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h **** {
  34:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h ****     float r;
  35:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h **** #ifdef __arm__
  36:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h ****     asm("vmaxnm.f32 %[d], %[n], %[m]" : [d] "=t"(r) : [n] "t"(a), [m] "t"(b) :);
  37:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h **** #else
  38:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h ****     r = (a > b) ? a : b;
  39:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h **** #endif // __arm__
  40:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h ****     return r;
  41:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h **** }
  42:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h **** 
  43:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h **** inline float fmin(float a, float b)
  44:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h **** {
  45:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h ****     float r;
  46:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h **** #ifdef __arm__
  47:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h ****     asm("vminnm.f32 %[d], %[n], %[m]" : [d] "=t"(r) : [n] "t"(a), [m] "t"(b) :);
  48:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h **** #else
  49:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h ****     r = (a < b) ? a : b;
  50:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h **** #endif // __arm__
  51:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h ****     return r;
  52:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h **** }
  53:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h **** 
  54:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h **** /** quick fp clamp
  55:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h **** */
  56:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h **** inline float fclamp(float in, float min, float max)
  57:../../../chompi-wave/code/libs/DaisySP/Source/Utility/dsp.h **** {
