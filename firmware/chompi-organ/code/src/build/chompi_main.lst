 179:MidiHandler.h ****     /* DMA out queue, same pattern as chompi-wave's MidiManager */
 180:MidiHandler.h ****     void StartDmaTransfer()
 181:MidiHandler.h ****     {
 182:MidiHandler.h ****         uint8_t *p   = fifo[fifo_tail].data;
 183:MidiHandler.h ****         size_t   len = fifo[fifo_tail].length;
 184:MidiHandler.h **** 
 185:MidiHandler.h ****         uintptr_t start = (uintptr_t)p & ~(32 - 1);
 186:MidiHandler.h ****         uintptr_t end   = ((uintptr_t)p + len + 32 - 1) & ~(32 - 1);
 187:MidiHandler.h ****         SCB_CleanDCache_by_Addr((uint32_t *)start, end - start);
 188:MidiHandler.h **** 
 189:MidiHandler.h ****         uart_handler_.DmaTransmit(p, len, nullptr, TxEndCallback, this);
 190:MidiHandler.h ****     }
 191:MidiHandler.h **** 
 192:MidiHandler.h ****     void QueueDmaMessage(uint8_t *msg, size_t length)
 193:MidiHandler.h ****     {
 194:MidiHandler.h ****         fifo[fifo_head].length = length;
 195:MidiHandler.h ****         memcpy(fifo[fifo_head].data, msg, length);
 196:MidiHandler.h ****         fifo_head = (fifo_head + 1) % 64;
 197:MidiHandler.h **** 
 198:MidiHandler.h ****         if(!uart_tx_busy)
 199:MidiHandler.h ****         {
 200:MidiHandler.h ****             __disable_irq();
 201:MidiHandler.h ****             DequeueDmaMessage();
 202:MidiHandler.h ****             __enable_irq();
 203:MidiHandler.h ****         }
 204:MidiHandler.h ****     }
 205:MidiHandler.h **** 
 206:MidiHandler.h ****     void DequeueDmaMessage()
 207:MidiHandler.h ****     {
