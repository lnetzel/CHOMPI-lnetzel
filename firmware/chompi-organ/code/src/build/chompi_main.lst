  75:../../../chompi-wave/code/libs/libDaisy/src/per/sai.h ****          ** expected that the codec will have its own xtal.
  76:../../../chompi-wave/code/libs/libDaisy/src/per/sai.h ****          */
  77:../../../chompi-wave/code/libs/libDaisy/src/per/sai.h ****         enum class Sync
