 205:chompi_main.cpp **** 
 206:chompi_main.cpp **** /** Key + encoder polling, called from the audio ISR once per block (2 kHz). */
 207:chompi_main.cpp **** static void PollControls()
 208:chompi_main.cpp **** {
 209:chompi_main.cpp ****     /* shift key (CHOMPI key) */
 210:chompi_main.cpp ****     shift_held_ = hw.button_sr.State(static_cast<int>(Hardware::SwId::KEY_26));
 211:chompi_main.cpp **** 
 212:chompi_main.cpp ****     /* pipe encoder push-switches (ENC_1..4_SW = SwId 0..3): press toggles
 213:chompi_main.cpp ****      * that pipe's encoder between page 1 (volume) and page 2 (waveform);
 214:chompi_main.cpp ****      * show the newly active page's value bar as confirmation */
 215:chompi_main.cpp ****     for(int i = 0; i < 4; i++)
 216:chompi_main.cpp ****     {
 217:chompi_main.cpp ****         const bool down = hw.button_sr.State(i);
 218:chompi_main.cpp ****         if(down && !prev_enc_sw_[i])
 219:chompi_main.cpp ****         {
 220:chompi_main.cpp ****             for(int p = 0; p < OrganEngine::kNumPipes; p++)
 221:chompi_main.cpp ****             {
 222:chompi_main.cpp ****                 if(pipe_encoder[p] == i)
 223:chompi_main.cpp ****                 {
 224:chompi_main.cpp ****                     wave_page_[p] = !wave_page_[p];
 225:chompi_main.cpp ****                     bar_pipe_     = p;
 226:chompi_main.cpp ****                     bar_page_     = wave_page_[p] ? 1 : 0;
 227:chompi_main.cpp ****                     bar_until_    = System::GetNow() + 500;
 228:chompi_main.cpp ****                 }
ARM GAS  C:\msys64\tmp\ccDg23TE.s 			page 175


 229:chompi_main.cpp ****             }
 230:chompi_main.cpp ****         }
 231:chompi_main.cpp ****         prev_enc_sw_[i] = down;
 232:chompi_main.cpp ****     }
 233:chompi_main.cpp **** 
 234:chompi_main.cpp ****     /* ENC_6_SW (volume-knob push, SwId 32): press toggles the volume
 235:chompi_main.cpp ****      * encoder between page 1 (master volume) and page 2 (overdrive);
 236:chompi_main.cpp ****      * show the newly active page's value bar as confirmation */
 237:chompi_main.cpp ****     {
 238:chompi_main.cpp ****         const int  vsw  = static_cast<int>(Hardware::SwId::ENC_6_SW);
 239:chompi_main.cpp ****         const bool down = hw.button_sr.State(vsw);
 240:chompi_main.cpp ****         if(down && !prev_key_[vsw])
 241:chompi_main.cpp ****         {
 242:chompi_main.cpp ****             vol_drive_page_ = !vol_drive_page_;
 243:chompi_main.cpp ****             bar_pipe_       = kVolBar;
 244:chompi_main.cpp ****             bar_page_       = vol_drive_page_ ? 1 : 0;
 245:chompi_main.cpp ****             bar_until_      = System::GetNow() + 500;
 246:chompi_main.cpp ****         }
 247:chompi_main.cpp ****         prev_key_[vsw] = down;
 248:chompi_main.cpp ****     }
 249:chompi_main.cpp **** 
 250:chompi_main.cpp ****     /* KEY_28 (LOOP) toggles the key latch. While latched, releasing a key
 251:chompi_main.cpp ****      * keeps its note sounding; unlatching releases every latched note whose
 252:chompi_main.cpp ****      * key is not physically held down again (those keep sounding and release
 253:chompi_main.cpp ****      * normally on key release). Applies to physical keys only, never MIDI. */
 254:chompi_main.cpp ****     {
 255:chompi_main.cpp ****         const int  loop_sw = static_cast<int>(Hardware::SwId::KEY_28);
 256:chompi_main.cpp ****         const bool down    = hw.button_sr.State(loop_sw);
 257:chompi_main.cpp ****         if(down && !prev_key_[loop_sw])
 258:chompi_main.cpp ****         {
 259:chompi_main.cpp ****             latch_on_ = !latch_on_;
 260:chompi_main.cpp ****             if(!latch_on_)
 261:chompi_main.cpp ****             {
 262:chompi_main.cpp ****                 for(int swid = 7; swid < 32; swid++)
 263:chompi_main.cpp ****                 {
 264:chompi_main.cpp ****                     if(latched_[swid] && active_note_[swid] != 0
 265:chompi_main.cpp ****                        && !hw.button_sr.State(swid))
 266:chompi_main.cpp ****                     {
 267:chompi_main.cpp ****                         const uint8_t note = active_note_[swid] - 1;
 268:chompi_main.cpp ****                         engine.NoteOff(note);
 269:chompi_main.cpp ****                         out_q.PushBack({1, note, 0});
 270:chompi_main.cpp ****                     }
 271:chompi_main.cpp ****                     latched_[swid] = false;
 272:chompi_main.cpp ****                 }
 273:chompi_main.cpp ****             }
 274:chompi_main.cpp ****         }
 275:chompi_main.cpp ****         prev_key_[loop_sw] = down;
 276:chompi_main.cpp ****     }
 277:chompi_main.cpp **** 
 278:chompi_main.cpp ****     /* playable keys: SwId 7..31 (SHIFT+KEY_16/KEY_17 = octave down/up) */
 279:chompi_main.cpp ****     for(int swid = 7; swid < 32; swid++)
 280:chompi_main.cpp ****     {
 281:chompi_main.cpp ****         const bool down = hw.button_sr.State(swid);
 282:chompi_main.cpp ****         if(down == prev_key_[swid])
 283:chompi_main.cpp ****             continue;
 284:chompi_main.cpp ****         prev_key_[swid] = down;
 285:chompi_main.cpp **** 
ARM GAS  C:\msys64\tmp\ccDg23TE.s 			page 176


 286:chompi_main.cpp ****         const bool oct_key = (swid == static_cast<int>(Hardware::SwId::KEY_16))
 287:chompi_main.cpp ****                              || (swid == static_cast<int>(Hardware::SwId::KEY_17));
 288:chompi_main.cpp ****         if(down)
 289:chompi_main.cpp ****         {
 290:chompi_main.cpp ****             if(shift_held_ && oct_key)
 291:chompi_main.cpp ****             {
 292:chompi_main.cpp ****                 int oct = octave_
 293:chompi_main.cpp ****                           + (swid == static_cast<int>(Hardware::SwId::KEY_16)
 294:chompi_main.cpp ****                                  ? -1
 295:chompi_main.cpp ****                                  : 1);
 296:chompi_main.cpp ****                 octave_ = oct < -2 ? -2 : (oct > 2 ? 2 : oct);
 297:chompi_main.cpp ****                 continue;
 298:chompi_main.cpp ****             }
 299:chompi_main.cpp ****             int n = key_map[swid] + 12 * octave_;
 300:chompi_main.cpp ****             n              = n < 0 ? 0 : (n > 127 ? 127 : n);
 301:chompi_main.cpp ****             const uint8_t note = static_cast<uint8_t>(n);
 302:chompi_main.cpp ****             active_note_[swid] = note + 1;
 303:chompi_main.cpp ****             latched_[swid]     = false; /* re-press of a latched key retriggers */
 304:chompi_main.cpp ****             engine.NoteOn(note, 1.f);
 305:chompi_main.cpp ****             out_q.PushBack({0, note, 0});
 306:chompi_main.cpp ****         }
 307:chompi_main.cpp ****         else if(active_note_[swid] != 0)
 308:chompi_main.cpp ****         {
 309:chompi_main.cpp ****             /* note-off uses the note that was started (octave may have
 310:chompi_main.cpp ****              * changed, or shift may now be held, while the key was down) */
 311:chompi_main.cpp ****             if(latch_on_)
 312:chompi_main.cpp ****             {
 313:chompi_main.cpp ****                 /* latched: keep sounding; note-off is deferred to unlatch */
 314:chompi_main.cpp ****                 latched_[swid] = true;
 315:chompi_main.cpp ****             }
 316:chompi_main.cpp ****             else
 317:chompi_main.cpp ****             {
 318:chompi_main.cpp ****                 const uint8_t note   = active_note_[swid] - 1;
 319:chompi_main.cpp ****                 active_note_[swid]   = 0;
 320:chompi_main.cpp ****                 engine.NoteOff(note);
 321:chompi_main.cpp ****                 out_q.PushBack({1, note, 0});
 322:chompi_main.cpp ****             }
 323:chompi_main.cpp ****         }
 324:chompi_main.cpp ****     }
 325:chompi_main.cpp **** 
 326:chompi_main.cpp ****     /* encoders: enc_trackers accumulate clicks and reset to 0 on press */
 327:chompi_main.cpp ****     for(int i = 0; i < 6; i++)
 328:chompi_main.cpp ****     {
 329:chompi_main.cpp ****         if(hw.enc[i].RisingEdge())
 330:chompi_main.cpp ****             prev_enc_[i] = 0;
 331:chompi_main.cpp **** 
 332:chompi_main.cpp ****         const int delta = hw.enc_trackers[i] - prev_enc_[i];
 333:chompi_main.cpp ****         prev_enc_[i]    = hw.enc_trackers[i];
 334:chompi_main.cpp ****         if(delta == 0)
 335:chompi_main.cpp ****             continue;
 336:chompi_main.cpp **** 
 337:chompi_main.cpp ****         /* Chatter filter: the detent-less volume encoder can rest on a
 338:chompi_main.cpp ****          * quadrature transition and emit increment bursts at ~1 ms spacing,
 339:chompi_main.cpp ****          * which would re-arm the level bar forever. Accept at most one click
 340:chompi_main.cpp ****          * per 8 ms per encoder (fast hand turns are >10 ms per detent). */
 341:chompi_main.cpp ****         const uint32_t now_ms = System::GetNow();
 342:chompi_main.cpp ****         if(now_ms - last_click_t_[i] < 8)
ARM GAS  C:\msys64\tmp\ccDg23TE.s 			page 177


 343:chompi_main.cpp ****             continue; /* dropped for good: prev_enc_ already synced */
 344:chompi_main.cpp ****         last_click_t_[i] = now_ms;
 345:chompi_main.cpp **** 
 346:chompi_main.cpp ****         if(i == kVolEnc)
 347:chompi_main.cpp ****         {
 348:chompi_main.cpp ****             if(shift_held_)
 349:chompi_main.cpp ****             {
 350:chompi_main.cpp ****                 engine.AddFineTuneCents(delta); /* SHIFT+ENC_6: fine tune */
 351:chompi_main.cpp ****             }
 352:chompi_main.cpp ****             else if(vol_drive_page_)
 353:chompi_main.cpp ****             {
 354:chompi_main.cpp ****                 /* volume-encoder page 2: overdrive amount, 32 steps */
 355:chompi_main.cpp ****                 engine.SetDriveStep(engine.GetDriveStep() + delta);
 356:chompi_main.cpp ****                 bar_pipe_  = kVolBar;
 357:chompi_main.cpp ****                 bar_page_  = 1;
 358:chompi_main.cpp ****                 bar_until_ = System::GetNow() + 500;
 359:chompi_main.cpp ****             }
 360:chompi_main.cpp ****             else
 361:chompi_main.cpp ****             {
 362:chompi_main.cpp ****                 /* existing CHOMPI volume-knob behaviour: 100 clicks, 0..1 */
 363:chompi_main.cpp ****                 float g = engine.GetMasterGain() + delta * .01f;
 364:chompi_main.cpp ****                 engine.SetMasterGain(g);
 365:chompi_main.cpp ****                 bar_pipe_  = kVolBar;
 366:chompi_main.cpp ****                 bar_page_  = 0;
 367:chompi_main.cpp ****                 bar_until_ = System::GetNow() + 500;
 368:chompi_main.cpp ****             }
 369:chompi_main.cpp ****         }
 370:chompi_main.cpp ****         else if(i != 4) /* enc[4] (transport wheel, ENC_5) has no function */
