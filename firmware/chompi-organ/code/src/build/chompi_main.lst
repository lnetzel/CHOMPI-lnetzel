1731:../../../chompi-wave/code/libs/libDaisy/Drivers/CMSIS/Include/core_cm7.h **** #define _VAL2FLD(field, value)    (((uint32_t)(value) << field ## _Pos) & field ## _Msk)
1732:../../../chompi-wave/code/libs/libDaisy/Drivers/CMSIS/Include/core_cm7.h **** 
1733:../../../chompi-wave/code/libs/libDaisy/Drivers/CMSIS/Include/core_cm7.h **** /**
1734:../../../chompi-wave/code/libs/libDaisy/Drivers/CMSIS/Include/core_cm7.h ****   \brief     Mask and shift a register value to extract a bit filed value.
1735:../../../chompi-wave/code/libs/libDaisy/Drivers/CMSIS/Include/core_cm7.h ****   \param[in] field  Name of the register bit field.
1736:../../../chompi-wave/code/libs/libDaisy/Drivers/CMSIS/Include/core_cm7.h ****   \param[in] value  Value of register. This parameter is interpreted as an uint32_t type.
1737:../../../chompi-wave/code/libs/libDaisy/Drivers/CMSIS/Include/core_cm7.h ****   \return           Masked and shifted bit field value.
1738:../../../chompi-wave/code/libs/libDaisy/Drivers/CMSIS/Include/core_cm7.h **** */
1739:../../../chompi-wave/code/libs/libDaisy/Drivers/CMSIS/Include/core_cm7.h **** #define _FLD2VAL(field, value)    (((uint32_t)(value) & field ## _Msk) >> field ## _Pos)
