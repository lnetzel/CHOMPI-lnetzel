 422:OrganEngine.h ****         const float base  = NoteToHz(voice.note);
 423:OrganEngine.h ****         for(int p = 0; p < kNumPipes; p++)
 424:OrganEngine.h ****         {
 425:OrganEngine.h ****             float f = base * PipeRatio(p);
 426:OrganEngine.h ****             while(f > kFoldbackHz)
 427:OrganEngine.h ****                 f *= .5f; /* organ foldback: drop whole octaves */
 428:OrganEngine.h ****             voice.osc[p].SetFreq(f);
 429:OrganEngine.h ****             /* Character voicing + anti-alias masks track the FINAL folded
 430:OrganEngine.h ****              * frequency (and fine tuning); identical for every voice slot
 431:OrganEngine.h ****              * playing this note/pipe. */
 432:OrganEngine.h ****             character_.UpdateVoiceCoeffs(v, voice.note, p, f);
 433:OrganEngine.h ****         }
