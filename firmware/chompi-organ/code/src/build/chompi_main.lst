  35:../../../chompi-wave/code/libs/libDaisy/src/per/dac.h ****         TWO,
  36:../../../chompi-wave/code/libs/libDaisy/src/per/dac.h ****         BOTH,
  37:../../../chompi-wave/code/libs/libDaisy/src/per/dac.h ****     };
  38:../../../chompi-wave/code/libs/libDaisy/src/per/dac.h **** 
  39:../../../chompi-wave/code/libs/libDaisy/src/per/dac.h ****     /** Sets the Mode for the DAC channels.
  40:../../../chompi-wave/code/libs/libDaisy/src/per/dac.h ****      **
  41:../../../chompi-wave/code/libs/libDaisy/src/per/dac.h ****      ** Polling mode uses the blocking mode to transmit a single value at a time.
  42:../../../chompi-wave/code/libs/libDaisy/src/per/dac.h ****      **
  43:../../../chompi-wave/code/libs/libDaisy/src/per/dac.h ****      ** DMA mode uses a buffer, and periodically transmits it triggering a 
  44:../../../chompi-wave/code/libs/libDaisy/src/per/dac.h ****      ** callback to fill the buffer when it is ready for more samples.
  45:../../../chompi-wave/code/libs/libDaisy/src/per/dac.h ****      ***/
  46:../../../chompi-wave/code/libs/libDaisy/src/per/dac.h ****     enum class Mode
  47:../../../chompi-wave/code/libs/libDaisy/src/per/dac.h ****     {
  48:../../../chompi-wave/code/libs/libDaisy/src/per/dac.h ****         POLLING,
  49:../../../chompi-wave/code/libs/libDaisy/src/per/dac.h ****         DMA,
  50:../../../chompi-wave/code/libs/libDaisy/src/per/dac.h ****     };
  51:../../../chompi-wave/code/libs/libDaisy/src/per/dac.h **** 
  52:../../../chompi-wave/code/libs/libDaisy/src/per/dac.h ****     /** Sets the number of bits per sample transmitted out of the DAC.
