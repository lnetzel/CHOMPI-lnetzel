 274:OrganEngine.h ****                 daisysp::fonepole(pipe_wave_[p], pipe_wave_target_[p], .001f);
 275:OrganEngine.h **** 
 276:OrganEngine.h ****                 /* Morph weights over morph x in 0..1: sine fades out as
 277:OrganEngine.h ****                  * square fades in. The coordinate runs through MorphEase
 278:OrganEngine.h ****                  * (smoothstep) first, so the blend lingers near the pure
 279:OrganEngine.h ****                  * waveforms: the first clicks stay in sine territory and
 280:OrganEngine.h ****                  * each pipe keeps more playable sweet spots. The weights
 281:OrganEngine.h ****                  * sum to 1, so loudness stays flat across the sweep. */
 282:OrganEngine.h ****                 const float ease = MorphEase(pipe_wave_[p]);
 283:OrganEngine.h ****                 wv[p][kWaveSin] = 1.f - ease;
 284:OrganEngine.h ****                 wv[p][kWaveSqr] = ease;
 285:OrganEngine.h ****             }
 286:OrganEngine.h ****             daisysp::fonepole(master_gain_, master_gain_target_, .001f);
 287:OrganEngine.h ****             daisysp::fonepole(drive_, drive_target_, .001f);
 288:OrganEngine.h **** 
 289:OrganEngine.h ****             float mix = 0.f;
 290:OrganEngine.h **** 
 291:OrganEngine.h ****             for(int v = 0; v < kNumVoices; v++)
 292:OrganEngine.h ****             {
 293:OrganEngine.h ****                 Voice &voice = voices_[v];
 294:OrganEngine.h ****                 if(voice.state == IDLE)
 295:OrganEngine.h ****                     continue;
 296:OrganEngine.h **** 
 297:OrganEngine.h ****                 float sig = 0.f;
 298:OrganEngine.h ****                 for(int p = 0; p < kNumPipes; p++)
 299:OrganEngine.h ****                 {
 300:OrganEngine.h ****                     float psig = 0.f;
 301:OrganEngine.h ****                     for(int w = 0; w < kNumWaveforms; w++)
 302:OrganEngine.h ****                     {
 303:OrganEngine.h ****                         /* Skip silent morph legs (phase stalls while the
 304:OrganEngine.h ****                          * weight is 0, which is inaudible behind the
ARM GAS  C:\msys64\tmp\ccE7R7AH.s 			page 348


 305:OrganEngine.h ****                          * crossfade) to keep CPU near the sine-only budget */
 306:OrganEngine.h ****                         if(wv[p][w] > 0.f)
 307:OrganEngine.h ****                             psig += voice.osc[p][w].Process() * wv[p][w];
 308:OrganEngine.h ****                     }
 309:OrganEngine.h ****                     sig += psig * pipe_gain_[p];
 310:OrganEngine.h ****                 }
 311:OrganEngine.h **** 
 312:OrganEngine.h ****                 switch(voice.state)
 313:OrganEngine.h ****                 {
 314:OrganEngine.h ****                     case ATTACK:
 315:OrganEngine.h ****                         voice.env += env_inc_;
 316:OrganEngine.h ****                         if(voice.env >= 1.f)
 317:OrganEngine.h ****                         {
 318:OrganEngine.h ****                             voice.env   = 1.f;
 319:OrganEngine.h ****                             voice.state = SUSTAIN;
 320:OrganEngine.h ****                         }
 321:OrganEngine.h ****                         break;
 322:OrganEngine.h ****                     case SUSTAIN: break;
 323:OrganEngine.h ****                     case RELEASE:
 324:OrganEngine.h ****                         voice.env -= env_inc_;
 325:OrganEngine.h ****                         if(voice.env <= 0.f)
 326:OrganEngine.h ****                         {
 327:OrganEngine.h ****                             voice.env   = 0.f;
 328:OrganEngine.h ****                             voice.state = IDLE;
 329:OrganEngine.h ****                         }
 330:OrganEngine.h ****                         break;
 331:OrganEngine.h ****                     case STEAL:
 332:OrganEngine.h ****                         voice.env -= env_inc_;
 333:OrganEngine.h ****                         if(voice.env <= 0.f)
 334:OrganEngine.h ****                         {
 335:OrganEngine.h ****                             voice.env = 0.f;
 336:OrganEngine.h ****                             StartVoice(voice, voice.pending_note, voice.pending_vel);
 337:OrganEngine.h ****                         }
 338:OrganEngine.h ****                         break;
 339:OrganEngine.h ****                     default: break;
 340:OrganEngine.h ****                 }
 341:OrganEngine.h **** 
 342:OrganEngine.h ****                 mix += sig * voice.env * voice.velocity;
 343:OrganEngine.h ****             }
 344:OrganEngine.h **** 
 345:OrganEngine.h ****             /* Overdrive (DSP-5): overdrive-pedal style — quadratic-mapped
 346:OrganEngine.h ****              * pre-gain (1..64x) into a tanh soft clipper, fully wet (no dry
 347:OrganEngine.h ****              * blend, so harmonics are always audible above 0%). Post gain
 348:OrganEngine.h ****              * anchors a 1/3-full-scale input to the same output level, so
 349:OrganEngine.h ****              * turning the knob up adds crunch/compression instead of just
 350:OrganEngine.h ****              * loudness; step 0 is an exact bypass. Runs before the master
 351:OrganEngine.h ****              * gain so the drive character does not depend on the listening
 352:OrganEngine.h ****              * level. */
 353:OrganEngine.h ****             float out_sig = mix * kMixScale;
 354:OrganEngine.h ****             if(drive_ > 0.f)
 355:OrganEngine.h ****             {
 356:OrganEngine.h ****                 const float g    = 1.f + drive_ * drive_ * 63.f;
 357:OrganEngine.h ****                 const float post = 0.33f / tanhf(0.33f * g);
 358:OrganEngine.h ****                 out_sig          = tanhf(g * out_sig) * post;
 359:OrganEngine.h ****             }
 360:OrganEngine.h ****             /* Rotary speaker (DSP-6): mono mix -> stereo Leslie, placed
 361:OrganEngine.h ****              * after the overdrive (the drive is the preamp, the Leslie is
ARM GAS  C:\msys64\tmp\ccE7R7AH.s 			page 349


 362:OrganEngine.h ****              * the speaker cabinet) and before the master gain so the
 363:OrganEngine.h ****              * volume knob keeps scaling both channels equally. Step 0 is
 364:OrganEngine.h ****              * an exact bypass (both channels = out_sig). */
