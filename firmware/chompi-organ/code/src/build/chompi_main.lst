 314:hardware.h    ****                  * on a weak USB port), which used to drop the device into
 315:hardware.h    ****                  * STOP within 160 ms with no exit but a power cycle.
 316:hardware.h    ****                  * Require the condition to hold for 2 s of continuous
 317:hardware.h    ****                  * re-reads before sleeping, and keep watching so a
 318:hardware.h    ****                  * recovery exits on its own. */
 319:hardware.h    ****                 const uint32_t cond_start = System::GetNow();
 320:hardware.h    ****                 while(System::GetNow() - cond_start < 2000)
 321:hardware.h    ****                 {
