 246:OrganEngine.h ****     void Process(float **out, size_t size)
 247:OrganEngine.h ****     {
 248:OrganEngine.h ****         for(size_t i = 0; i < size; i++)
 249:OrganEngine.h ****         {
 250:OrganEngine.h ****             /* Smooth pipe gains, morphs and master gain (~1 ms slew) */
 251:OrganEngine.h ****             float wv[kNumPipes][kNumWaveforms];
 252:OrganEngine.h ****             for(int p = 0; p < kNumPipes; p++)
 253:OrganEngine.h ****             {
 254:OrganEngine.h ****                 daisysp::fonepole(pipe_gain_[p], pipe_gain_target_[p], .001f);
 255:OrganEngine.h ****                 daisysp::fonepole(pipe_wave_[p], pipe_wave_target_[p], .001f);
 256:OrganEngine.h **** 
 257:OrganEngine.h ****                 /* Triangle morph weights over morph x in 0..2:
 258:OrganEngine.h ****                  * sine fades out 0->1, saw fades in 1->2, square peaks at 1.
 259:OrganEngine.h ****                  * Each segment's coordinate runs through MorphEase
 260:OrganEngine.h ****                  * (smoothstep) first, so the blend lingers near the pure
 261:OrganEngine.h ****                  * waveforms: the first clicks stay in sine territory and
 262:OrganEngine.h ****                  * each pipe keeps more playable sweet spots. The weights
 263:OrganEngine.h ****                  * still sum to 1, so loudness stays flat across the sweep. */
 264:OrganEngine.h ****                 const float x    = pipe_wave_[p] * 2.f;
 265:OrganEngine.h ****                 const float seg  = x < 1.f ? x : x - 1.f;
 266:OrganEngine.h ****                 const float ease = MorphEase(seg);
 267:OrganEngine.h ****                 const float xe   = x < 1.f ? ease : 1.f + ease;
 268:OrganEngine.h ****                 wv[p][kWaveSin] = xe < 1.f ? 1.f - xe : 0.f;
 269:OrganEngine.h ****                 wv[p][kWaveSaw] = xe > 1.f ? xe - 1.f : 0.f;
 270:OrganEngine.h ****                 wv[p][kWaveSqr] = 1.f - wv[p][kWaveSin] - wv[p][kWaveSaw];
 271:OrganEngine.h ****             }
 272:OrganEngine.h ****             daisysp::fonepole(master_gain_, master_gain_target_, .001f);
 273:OrganEngine.h ****             daisysp::fonepole(drive_, drive_target_, .001f);
 274:OrganEngine.h **** 
 275:OrganEngine.h ****             float mix = 0.f;
 276:OrganEngine.h **** 
 277:OrganEngine.h ****             for(int v = 0; v < kNumVoices; v++)
 278:OrganEngine.h ****             {
 279:OrganEngine.h ****                 Voice &voice = voices_[v];
 280:OrganEngine.h ****                 if(voice.state == IDLE)
 281:OrganEngine.h ****                     continue;
 282:OrganEngine.h **** 
 283:OrganEngine.h ****                 float sig = 0.f;
 284:OrganEngine.h ****                 for(int p = 0; p < kNumPipes; p++)
 285:OrganEngine.h ****                 {
 286:OrganEngine.h ****                     float psig = 0.f;
 287:OrganEngine.h ****                     for(int w = 0; w < kNumWaveforms; w++)
 288:OrganEngine.h ****                     {
