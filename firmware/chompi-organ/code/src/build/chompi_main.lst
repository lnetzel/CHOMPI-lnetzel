 330:hardware.h    ****                 HAL_PWR_EnterSTOPMode(PWR_LOWPOWERREGULATOR_ON , PWR_STOPENTRY_WFI);
 331:hardware.h    ****                 /* A4 note: the IWDG keeps running in STOP and resets the
