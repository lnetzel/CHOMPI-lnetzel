 274:OrganEngine.h ****     void Prepare()
 275:OrganEngine.h ****     {
 276:OrganEngine.h ****         /* B4: overdrive pre/post gain only depend on the drive target, so
 277:OrganEngine.h ****          * compute them once per block instead of a tanhf + divide per
 278:OrganEngine.h ****          * sample. drive_ still slews per sample for a click-free bypass. */
 279:OrganEngine.h ****         drive_g_    = 1.f + drive_target_ * drive_target_ * 63.f;
