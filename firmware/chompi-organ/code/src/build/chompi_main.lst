 305:../../../chompi-wave/code/libs/libDaisy/src/util/FIFO.h ****     /** removes all elements from the buffer for which
 306:../../../chompi-wave/code/libs/libDaisy/src/util/FIFO.h ****         (buffer(index) == element) returns true and returns the number of
 307:../../../chompi-wave/code/libs/libDaisy/src/util/FIFO.h ****         elements that were removed. */
 308:../../../chompi-wave/code/libs/libDaisy/src/util/FIFO.h ****     size_t RemoveAllEqualTo(const T& element)
 309:../../../chompi-wave/code/libs/libDaisy/src/util/FIFO.h ****     {
 310:../../../chompi-wave/code/libs/libDaisy/src/util/FIFO.h ****         size_t numRemoved = 0;
 311:../../../chompi-wave/code/libs/libDaisy/src/util/FIFO.h ****         int    idx        = GetNumElements() - 1;
 312:../../../chompi-wave/code/libs/libDaisy/src/util/FIFO.h ****         while(idx >= 0)
 313:../../../chompi-wave/code/libs/libDaisy/src/util/FIFO.h ****         {
 314:../../../chompi-wave/code/libs/libDaisy/src/util/FIFO.h ****             if((*this)[idx] == element)
 315:../../../chompi-wave/code/libs/libDaisy/src/util/FIFO.h ****             {
 316:../../../chompi-wave/code/libs/libDaisy/src/util/FIFO.h ****                 numRemoved++;
 317:../../../chompi-wave/code/libs/libDaisy/src/util/FIFO.h ****                 Remove(idx);
 318:../../../chompi-wave/code/libs/libDaisy/src/util/FIFO.h ****                 // was that the last element?
 319:../../../chompi-wave/code/libs/libDaisy/src/util/FIFO.h ****                 if(idx == int(GetNumElements()) - 1)
 320:../../../chompi-wave/code/libs/libDaisy/src/util/FIFO.h ****                     idx--;
 321:../../../chompi-wave/code/libs/libDaisy/src/util/FIFO.h ****             }
 322:../../../chompi-wave/code/libs/libDaisy/src/util/FIFO.h ****             else
 323:../../../chompi-wave/code/libs/libDaisy/src/util/FIFO.h ****                 idx--;
 324:../../../chompi-wave/code/libs/libDaisy/src/util/FIFO.h ****         }
 325:../../../chompi-wave/code/libs/libDaisy/src/util/FIFO.h ****         return numRemoved;
 326:../../../chompi-wave/code/libs/libDaisy/src/util/FIFO.h ****     }
