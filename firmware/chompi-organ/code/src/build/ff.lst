1357:../../../chompi-wave/code/libs/libDaisy/Middlewares/Third_Party/FatFs/src/ff.c **** 	FRESULT res;
1358:../../../chompi-wave/code/libs/libDaisy/Middlewares/Third_Party/FatFs/src/ff.c **** 	FATFS *fs = obj->fs;
