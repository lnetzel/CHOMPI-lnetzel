5969:../../../chompi-wave/code/libs/libDaisy/Middlewares/Third_Party/FatFs/src/ff.c **** #elif _STRF_ENCODE == 2			/* Write a character in UTF-16BE */
5970:../../../chompi-wave/code/libs/libDaisy/Middlewares/Third_Party/FatFs/src/ff.c **** 	pb->buf[i++] = (BYTE)(c >> 8);
5971:../../../chompi-wave/code/libs/libDaisy/Middlewares/Third_Party/FatFs/src/ff.c **** 	pb->buf[i++] = (BYTE)c;
5972:../../../chompi-wave/code/libs/libDaisy/Middlewares/Third_Party/FatFs/src/ff.c **** #elif _STRF_ENCODE == 1			/* Write a character in UTF-16LE */
5973:../../../chompi-wave/code/libs/libDaisy/Middlewares/Third_Party/FatFs/src/ff.c **** 	pb->buf[i++] = (BYTE)c;
5974:../../../chompi-wave/code/libs/libDaisy/Middlewares/Third_Party/FatFs/src/ff.c **** 	pb->buf[i++] = (BYTE)(c >> 8);
5975:../../../chompi-wave/code/libs/libDaisy/Middlewares/Third_Party/FatFs/src/ff.c **** #else							/* Write a character in ANSI/OEM */
5976:../../../chompi-wave/code/libs/libDaisy/Middlewares/Third_Party/FatFs/src/ff.c **** 	c = ff_convert(c, 0);	/* Unicode -> OEM */
5977:../../../chompi-wave/code/libs/libDaisy/Middlewares/Third_Party/FatFs/src/ff.c **** 	if (!c) c = '?';
5978:../../../chompi-wave/code/libs/libDaisy/Middlewares/Third_Party/FatFs/src/ff.c **** 	if (c >= 0x100)
5979:../../../chompi-wave/code/libs/libDaisy/Middlewares/Third_Party/FatFs/src/ff.c **** 		pb->buf[i++] = (BYTE)(c >> 8);
5980:../../../chompi-wave/code/libs/libDaisy/Middlewares/Third_Party/FatFs/src/ff.c **** 	pb->buf[i++] = (BYTE)c;
5981:../../../chompi-wave/code/libs/libDaisy/Middlewares/Third_Party/FatFs/src/ff.c **** #endif
5982:../../../chompi-wave/code/libs/libDaisy/Middlewares/Third_Party/FatFs/src/ff.c **** #else							/* Write a character without conversion */
5983:../../../chompi-wave/code/libs/libDaisy/Middlewares/Third_Party/FatFs/src/ff.c **** 	pb->buf[i++] = (BYTE)c;
5984:../../../chompi-wave/code/libs/libDaisy/Middlewares/Third_Party/FatFs/src/ff.c **** #endif
5985:../../../chompi-wave/code/libs/libDaisy/Middlewares/Third_Party/FatFs/src/ff.c **** 
5986:../../../chompi-wave/code/libs/libDaisy/Middlewares/Third_Party/FatFs/src/ff.c **** 	if (i >= (int)(sizeof pb->buf) - 3) {	/* Write buffered characters to the file */
