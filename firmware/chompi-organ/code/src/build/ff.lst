5957:../../../chompi-wave/code/libs/libDaisy/Middlewares/Third_Party/FatFs/src/ff.c **** #if _STRF_ENCODE == 3			/* Write a character in UTF-8 */
5958:../../../chompi-wave/code/libs/libDaisy/Middlewares/Third_Party/FatFs/src/ff.c **** 	if (c < 0x80) {				/* 7-bit */
5959:../../../chompi-wave/code/libs/libDaisy/Middlewares/Third_Party/FatFs/src/ff.c **** 		pb->buf[i++] = (BYTE)c;
5960:../../../chompi-wave/code/libs/libDaisy/Middlewares/Third_Party/FatFs/src/ff.c **** 	} else {
5961:../../../chompi-wave/code/libs/libDaisy/Middlewares/Third_Party/FatFs/src/ff.c **** 		if (c < 0x800) {		/* 11-bit */
5962:../../../chompi-wave/code/libs/libDaisy/Middlewares/Third_Party/FatFs/src/ff.c **** 			pb->buf[i++] = (BYTE)(0xC0 | c >> 6);
5963:../../../chompi-wave/code/libs/libDaisy/Middlewares/Third_Party/FatFs/src/ff.c **** 		} else {				/* 16-bit */
5964:../../../chompi-wave/code/libs/libDaisy/Middlewares/Third_Party/FatFs/src/ff.c **** 			pb->buf[i++] = (BYTE)(0xE0 | c >> 12);
5965:../../../chompi-wave/code/libs/libDaisy/Middlewares/Third_Party/FatFs/src/ff.c **** 			pb->buf[i++] = (BYTE)(0x80 | (c >> 6 & 0x3F));
5966:../../../chompi-wave/code/libs/libDaisy/Middlewares/Third_Party/FatFs/src/ff.c **** 		}
5967:../../../chompi-wave/code/libs/libDaisy/Middlewares/Third_Party/FatFs/src/ff.c **** 		pb->buf[i++] = (BYTE)(0x80 | (c & 0x3F));
