5778:../../../chompi-wave/code/libs/libDaisy/Middlewares/Third_Party/FatFs/src/ff.c **** /* Create partition table on the physical drive                          */
5779:../../../chompi-wave/code/libs/libDaisy/Middlewares/Third_Party/FatFs/src/ff.c **** /*-----------------------------------------------------------------------*/
5780:../../../chompi-wave/code/libs/libDaisy/Middlewares/Third_Party/FatFs/src/ff.c **** 
5781:../../../chompi-wave/code/libs/libDaisy/Middlewares/Third_Party/FatFs/src/ff.c **** FRESULT f_fdisk (
5782:../../../chompi-wave/code/libs/libDaisy/Middlewares/Third_Party/FatFs/src/ff.c **** 	BYTE pdrv,			/* Physical drive number */
5783:../../../chompi-wave/code/libs/libDaisy/Middlewares/Third_Party/FatFs/src/ff.c **** 	const DWORD* szt,	/* Pointer to the size table for each partitions */
5784:../../../chompi-wave/code/libs/libDaisy/Middlewares/Third_Party/FatFs/src/ff.c **** 	void* work			/* Pointer to the working buffer */
5785:../../../chompi-wave/code/libs/libDaisy/Middlewares/Third_Party/FatFs/src/ff.c **** )
5786:../../../chompi-wave/code/libs/libDaisy/Middlewares/Third_Party/FatFs/src/ff.c **** {
5787:../../../chompi-wave/code/libs/libDaisy/Middlewares/Third_Party/FatFs/src/ff.c **** 	UINT i, n, sz_cyl, tot_cyl, b_cyl, e_cyl, p_cyl;
5788:../../../chompi-wave/code/libs/libDaisy/Middlewares/Third_Party/FatFs/src/ff.c **** 	BYTE s_hd, e_hd, *p, *buf = (BYTE*)work;
5789:../../../chompi-wave/code/libs/libDaisy/Middlewares/Third_Party/FatFs/src/ff.c **** 	DSTATUS stat;
5790:../../../chompi-wave/code/libs/libDaisy/Middlewares/Third_Party/FatFs/src/ff.c **** 	DWORD sz_disk, sz_part, s_part;
5791:../../../chompi-wave/code/libs/libDaisy/Middlewares/Third_Party/FatFs/src/ff.c **** 
5792:../../../chompi-wave/code/libs/libDaisy/Middlewares/Third_Party/FatFs/src/ff.c **** 
5793:../../../chompi-wave/code/libs/libDaisy/Middlewares/Third_Party/FatFs/src/ff.c **** 	stat = disk_initialize(pdrv);
5794:../../../chompi-wave/code/libs/libDaisy/Middlewares/Third_Party/FatFs/src/ff.c **** 	if (stat & STA_NOINIT) return FR_NOT_READY;
5795:../../../chompi-wave/code/libs/libDaisy/Middlewares/Third_Party/FatFs/src/ff.c **** 	if (stat & STA_PROTECT) return FR_WRITE_PROTECTED;
5796:../../../chompi-wave/code/libs/libDaisy/Middlewares/Third_Party/FatFs/src/ff.c **** 	if (disk_ioctl(pdrv, GET_SECTOR_COUNT, &sz_disk)) return FR_DISK_ERR;
5797:../../../chompi-wave/code/libs/libDaisy/Middlewares/Third_Party/FatFs/src/ff.c **** 
5798:../../../chompi-wave/code/libs/libDaisy/Middlewares/Third_Party/FatFs/src/ff.c **** 	/* Determine the CHS without any consideration of the drive geometry */
5799:../../../chompi-wave/code/libs/libDaisy/Middlewares/Third_Party/FatFs/src/ff.c **** 	for (n = 16; n < 256 && sz_disk / n / 63 > 1024; n *= 2) ;
5800:../../../chompi-wave/code/libs/libDaisy/Middlewares/Third_Party/FatFs/src/ff.c **** 	if (n == 256) n--;
5801:../../../chompi-wave/code/libs/libDaisy/Middlewares/Third_Party/FatFs/src/ff.c **** 	e_hd = n - 1;
5802:../../../chompi-wave/code/libs/libDaisy/Middlewares/Third_Party/FatFs/src/ff.c **** 	sz_cyl = 63 * n;
5803:../../../chompi-wave/code/libs/libDaisy/Middlewares/Third_Party/FatFs/src/ff.c **** 	tot_cyl = sz_disk / sz_cyl;
5804:../../../chompi-wave/code/libs/libDaisy/Middlewares/Third_Party/FatFs/src/ff.c **** 
5805:../../../chompi-wave/code/libs/libDaisy/Middlewares/Third_Party/FatFs/src/ff.c **** 	/* Create partition table */
5806:../../../chompi-wave/code/libs/libDaisy/Middlewares/Third_Party/FatFs/src/ff.c **** 	mem_set(buf, 0, _MAX_SS);
5807:../../../chompi-wave/code/libs/libDaisy/Middlewares/Third_Party/FatFs/src/ff.c **** 	p = buf + MBR_Table; b_cyl = 0;
5808:../../../chompi-wave/code/libs/libDaisy/Middlewares/Third_Party/FatFs/src/ff.c **** 	for (i = 0; i < 4; i++, p += SZ_PTE) {
5809:../../../chompi-wave/code/libs/libDaisy/Middlewares/Third_Party/FatFs/src/ff.c **** 		p_cyl = (szt[i] <= 100U) ? (DWORD)tot_cyl * szt[i] / 100 : szt[i] / sz_cyl;	/* Number of cylinder
5810:../../../chompi-wave/code/libs/libDaisy/Middlewares/Third_Party/FatFs/src/ff.c **** 		if (!p_cyl) continue;
5811:../../../chompi-wave/code/libs/libDaisy/Middlewares/Third_Party/FatFs/src/ff.c **** 		s_part = (DWORD)sz_cyl * b_cyl;
5812:../../../chompi-wave/code/libs/libDaisy/Middlewares/Third_Party/FatFs/src/ff.c **** 		sz_part = (DWORD)sz_cyl * p_cyl;
5813:../../../chompi-wave/code/libs/libDaisy/Middlewares/Third_Party/FatFs/src/ff.c **** 		if (i == 0) {	/* Exclude first track of cylinder 0 */
5814:../../../chompi-wave/code/libs/libDaisy/Middlewares/Third_Party/FatFs/src/ff.c **** 			s_hd = 1;
5815:../../../chompi-wave/code/libs/libDaisy/Middlewares/Third_Party/FatFs/src/ff.c **** 			s_part += 63; sz_part -= 63;
5816:../../../chompi-wave/code/libs/libDaisy/Middlewares/Third_Party/FatFs/src/ff.c **** 		} else {
5817:../../../chompi-wave/code/libs/libDaisy/Middlewares/Third_Party/FatFs/src/ff.c **** 			s_hd = 0;
5818:../../../chompi-wave/code/libs/libDaisy/Middlewares/Third_Party/FatFs/src/ff.c **** 		}
5819:../../../chompi-wave/code/libs/libDaisy/Middlewares/Third_Party/FatFs/src/ff.c **** 		e_cyl = b_cyl + p_cyl - 1;	/* End cylinder */
5820:../../../chompi-wave/code/libs/libDaisy/Middlewares/Third_Party/FatFs/src/ff.c **** 		if (e_cyl >= tot_cyl) return FR_INVALID_PARAMETER;
5821:../../../chompi-wave/code/libs/libDaisy/Middlewares/Third_Party/FatFs/src/ff.c **** 
5822:../../../chompi-wave/code/libs/libDaisy/Middlewares/Third_Party/FatFs/src/ff.c **** 		/* Set partition table */
