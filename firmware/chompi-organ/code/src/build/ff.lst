1442:../../../chompi-wave/code/libs/libDaisy/Middlewares/Third_Party/FatFs/src/ff.c **** 	FSIZE_t ofs		/* File offset to be converted to cluster# */
1443:../../../chompi-wave/code/libs/libDaisy/Middlewares/Third_Party/FatFs/src/ff.c **** )
1444:../../../chompi-wave/code/libs/libDaisy/Middlewares/Third_Party/FatFs/src/ff.c **** {
1445:../../../chompi-wave/code/libs/libDaisy/Middlewares/Third_Party/FatFs/src/ff.c **** 	DWORD cl, ncl, *tbl;
1446:../../../chompi-wave/code/libs/libDaisy/Middlewares/Third_Party/FatFs/src/ff.c **** 	FATFS *fs = fp->obj.fs;
1447:../../../chompi-wave/code/libs/libDaisy/Middlewares/Third_Party/FatFs/src/ff.c **** 
